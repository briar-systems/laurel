# the example application, written once for every host
#
# nothing here knows how it is hosted. what the host supplies (the task
# runner, configuration, secrets and telemetry) arrives as one provider entry
# in `assemble`, so `laurel.serve` runs this application standalone in
# bin/main.mach and `laurel.testing` runs it in process in the test below,
# unchanged.

use http.core.exchange;
use http.core.field;
use http.core.message;
use http.core.method;
use http.core.status;
use http.core.target;
use http_router: http.router.router;
use laurel.app;
use laurel.config;
use laurel.context;
use laurel.error;
use laurel.handler;
use laurel.lifecycle;
use laurel.middleware;
use laurel.observability;
use laurel.provider;
use laurel.raw;
use laurel.render;
use laurel.router;
use laurel.security;
use laurel.serve;
use laurel.task;
use laurel.task.runner;
use laurel.testing;
use A: std.allocator;
use std.chrono.duration;
use std.chrono.time;
use std.memory;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_len;
use std.types.view;

pub val ROUTES:       usize = 4;
pub val ECHO_LIMIT:   usize = 4096;
pub val REPLY_BYTES:  usize = 4096;
pub val SNAPSHOT:     usize = 24;
pub val REFRESH_SECS: i64   = 5;

# every record the application uses, owned by whoever hosts it. it must not
# move once assembled
pub rec State {
    routes:         [4]router.Route;
    specifications: [4]http_router.Route;
    compiled:       [4]http_router.CompiledRoute;
    segments:       [8]http_router.Segment;
    matcher:        router.Router;
    stack:          middleware.Stack;
    items:          [1]provider.Provider;
    providers:      provider.Set;
    services:       [1]lifecycle.Lifecycle;
    controller:     lifecycle.Controller;
    headers:        security.HeadersPolicy;
    errors:         error.Default;
    vocabulary:     observability.Vocabulary;
    observer:       observability.Observer;
    tasks:          *task.Provider;
    settings:       *config.Provider;
    telemetry:      *observability.Telemetry;
    refresh:        task.Handle;
    refresh_spec:   task.Spec;
    refreshes:      u64;
    slots:          [2][24]u8;
    application:    app.App;
}

# one response body, from the request arena so it outlives the handler
rec Reply {
    media: render.Media;
    fixed: render.Fixed;
    bytes: [4096]u8;
}

rec EchoWork {
    buffer: [4096]u8;
    body:   raw.Body;
}

fun internal(detail: str) error.AppError {
    ret error.make(error.INTERNAL, 500, "internal server error", detail, false);
}

fun reply(request_context: *context.Context, content: view.View) handler.Result {
    val allocated: res[*Reply, A.Error] = A.zallocate[Reply](request_context.alloc, 1);
    if (sel allocated.err) { ret handler.fail(internal("reply storage was refused")); }
    val holder: *Reply = allocated.ok;
    if (content.len > REPLY_BYTES) { ret handler.fail(internal("reply does not fit")); }
    if (content.len > 0)           { memory.raw_copy(?holder.bytes[0], content.data, content.len); }
    val response: *message.Response  = context.response(request_context);
    val bound:    *exchange.Exchange = context.exchange_ref(request_context);
    if (response == nil || bound == nil || !render.text_plain(?holder.media)
        || !render.init_fixed(?holder.fixed, view.view(?holder.bytes[0], content.len),
        response.generation, bound.limits, ?response.trailers, context.cancellation(request_context))
        || render.respond_with_limits(request_context, status.OK, ?holder.media,
        render.fixed_body(?holder.fixed), bound.limits) != render.RESPOND_OK) {
        ret handler.fail(internal("reply installation failed"));
    }
    ret handler.respond();
}

# GET /hello
fun hello(ctx: ptr, request_context: *context.Context, work: *ptr) handler.Result {
    @work = nil;
    ret reply(request_context, view.view("hello from laurel\n", 18));
}

# GET /greeting answers the `greeting` configuration value, read from the host
fun greeting(ctx: ptr, request_context: *context.Context, work: *ptr) handler.Result {
    @work = nil;
    val state: *State      = ctx::*State;
    var value: [256]u8;
    val read:  config.Read = config.read(state.settings, view.view("greeting", 8), ?value[0], 256);
    if (read.status == config.READ_FOUND)   { ret reply(request_context, view.view(?value[0], read.len)); }
    if (read.status == config.READ_MISSING) { ret reply(request_context, view.view("hello", 5)); }
    ret handler.fail(internal("greeting is not readable"));
}

# GET /refreshes answers the background task's latest snapshot without waiting
fun refreshes(ctx: ptr, request_context: *context.Context, work: *ptr) handler.Result {
    @work = nil;
    val state: *State      = ctx::*State;
    var lease: task.Lease;
    val read:  task.Status = task.read(state.tasks, state.refresh, ?lease);
    if (read == task.STATUS_EMPTY) { ret reply(request_context, view.view("0", 1)); }
    if (read != task.STATUS_OK)    { ret handler.fail(internal("snapshot is not readable")); }
    var copy:  [24]u8;
    val bytes: view.View = task.lease_view(?lease);
    memory.raw_copy(?copy[0], bytes.data, bytes.len);
    val length: usize = bytes.len;
    task.release(state.tasks, ?lease);
    ret reply(request_context, view.view(?copy[0], length));
}

fun echo_drive(request_context: *context.Context, current: raw.Operation) handler.Result {
    if (current.status == raw.PENDING)  { ret handler.suspend(current.token); }
    if (current.status != raw.COMPLETE) { ret handler.fail(current.app_error); }
    ret reply(request_context, current.bytes);
}

# POST /echo reads the whole body, suspending on the host until it arrives
fun echo(ctx: ptr, request_context: *context.Context, work: *ptr) handler.Result {
    @work = nil;
    val allocated: res[*EchoWork, A.Error] = A.zallocate[EchoWork](request_context.alloc, 1);
    if (sel allocated.err) { ret handler.fail(internal("body storage was refused")); }
    val body_work: *EchoWork = allocated.ok;
    @work = body_work::ptr;
    if (!raw.init(?body_work.body, context.request(request_context).body, ?body_work.buffer[0],
        ECHO_LIMIT)) {
        ret handler.fail(internal("the body reader was refused"));
    }
    ret echo_drive(request_context, raw.poll(?body_work.body));
}

fun echo_resume(ctx: ptr, request_context: *context.Context, work: ptr,
    settlement: handler.Settlement, token: u64) handler.Result {
    val body_work: *EchoWork = work::*EchoWork;
    if (settlement == handler.SETTLE_ABANDONED) { ret handler.respond(); }
    ret echo_drive(request_context, raw.complete(?body_work.body, token));
}

fun not_found(ctx: ptr, request_context: *context.Context, work: *ptr) handler.Result {
    @work = nil;
    ret handler.fail(error.make(error.NOT_FOUND, 404, "not found", "no route matched", false));
}

fun decimal(value: u64, output: *u8) usize {
    var digits: [24]u8;
    var count:  usize = 0;
    var rest:   u64   = value;
    for (count == 0 || rest != 0) {
        digits[count] = '0' + (rest % 10)::u8;
        rest          = rest / 10;
        count         = count + 1;
    }
    var i: usize = 0;
    for (i < count) {
        output[i] = digits[count - 1 - i];
        i         = i + 1;
    }
    ret count;
}

# the periodic job: counts its runs, publishes the count as a snapshot and
# reports it as a telemetry counter. a step never blocks
fun refresh_step(ctx: ptr, run: *task.Run) res[task.StepStatus, view.View] {
    val state: *State = ctx::*State;
    state.refreshes = state.refreshes + 1;
    var draft: task.Draft;
    if (task.draft(run, ?draft) == task.STATUS_OK) {
        task.commit(run, ?draft, decimal(state.refreshes, draft.data));
    }
    var signal: observability.Signal;
    if (state.telemetry != nil
        && observability.init_signal(?signal, ?state.vocabulary, observability.SIGNAL_COUNTER,
        view.view("refreshes", 9), 1) == observability.RECORD_OK) {
        observability.emit(state.telemetry, ?signal);
    }
    ret res[task.StepStatus, view.View].ok{task.STEP_DONE};
}

# the application's one lifecycle service registers the job and runs it once
# at start, then every REFRESH_SECS
fun service_start(ctx: ptr) res[lifecycle.CallbackStatus, view.View] {
    val state: *State = ctx::*State;
    state.refresh_spec = task.Spec{name: view.view("refresh", 7), state: ctx, step: refresh_step,
        period:      opt[duration.Duration].some{REFRESH_SECS * duration.SECOND},
        run_timeout: opt[duration.Duration].some{duration.SECOND},
        slots:       ?state.slots[0][0], slot_bytes: SNAPSHOT, slot_count: 2};
    if (task.register(state.tasks, ?state.refresh_spec, ?state.refresh) != task.STATUS_OK
        || task.trigger(state.tasks, state.refresh) != task.STATUS_OK) {
        ret res[lifecycle.CallbackStatus, view.View].err{view.view("refresh task refused", 20)};
    }
    ret res[lifecycle.CallbackStatus, view.View].ok{lifecycle.CALLBACK_DONE};
}

fun service_ready(ctx: ptr) lifecycle.Readiness {
    ret lifecycle.READY_NOW;
}

fun service_drain(ctx: ptr, deadline: opt[time.Instant]) res[lifecycle.CallbackStatus, view.View] {
    ret res[lifecycle.CallbackStatus, view.View].ok{lifecycle.CALLBACK_DONE};
}

fun service_stop(ctx: ptr) res[lifecycle.CallbackStatus, view.View] {
    ret res[lifecycle.CallbackStatus, view.View].ok{lifecycle.CALLBACK_DONE};
}

fun observe_start(ctx: ptr, event: *observability.RequestEvent) {}

fun observe_finish(ctx: ptr, event: *observability.RequestEvent) {}

fun observe_error(ctx: ptr, event: *observability.RequestEvent, app_error: error.AppError) {}

fun route(method_kind: method.Kind, pattern: str, name: str, call: handler.EnterFun,
    resume: handler.ResumeFun, ctx: ptr) router.Route {
    ret router.Route{method: router.exact_method(method.from_kind(method_kind)),
        host:    router.any_host(), path: router.path(view.view(pattern, str_len(pattern))),
        name:    name, parameters: nil, parameter_len: 0,
        handler: handler.Handler{ctx: ctx, call: call, resume: resume}};
}

# assembles the application over what its host supplies. the host's provider
# entry must own the task, configuration and telemetry keys
pub fun assemble(state: *State, host: provider.Provider) bool {
    val ctx: ptr = state::ptr;
    state.routes[0] = route(method.GET, "/hello", "hello", hello, nil, ctx);
    state.routes[1] = route(method.GET, "/greeting", "greeting", greeting, nil, ctx);
    state.routes[2] = route(method.GET, "/refreshes", "refreshes", refreshes, nil, ctx);
    state.routes[3] = route(method.POST, "/echo", "echo", echo, echo_resume, ctx);
    val storage: router.Storage = router.Storage{specifications: ?state.specifications[0],
        specification_cap: ROUTES, compiled_routes: ?state.compiled[0], compiled_route_cap: ROUTES,
        segments:          ?state.segments[0], segment_cap: 8};
    if (router.compile(?state.matcher, ?state.routes[0], ROUTES, storage,
        router.limits_default()).status != router.COMPILE_OK) { ret false; }
    state.stack    = middleware.Stack{items: nil, len: 0};
    state.items[0] = host;
    if (!provider.init(?state.providers, ?state.items[0], 1, 1, 32)) { ret false; }
    state.tasks = task.resolve(?state.providers);
    val settings:  res[ptr, view.View] = provider.resolve(?state.providers, config.key());
    val telemetry: res[ptr, view.View] = provider.resolve(?state.providers,
        observability.telemetry_key());
    if (state.tasks == nil) { ret false; }
    if (sel settings.err)   { ret false; }
    state.settings = settings.ok::*config.Provider;
    if (sel telemetry.err) { ret false; }
    state.telemetry   = telemetry.ok::*observability.Telemetry;
    state.services[0] = lifecycle.Lifecycle{ctx: ctx, start: service_start, ready: service_ready,
        drain: service_drain, stop: service_stop};
    if (!lifecycle.init(?state.controller, ?state.services[0], 1, 1)
        || !security.secure_headers(?state.headers)
        || !error.initialize_default(?state.errors, message.limits_default(), 512)
        || !observability.init_vocabulary(?state.vocabulary, nil, 0)) { ret false; }
    state.observer = observability.Observer{ctx: ctx, start: observe_start,
        finish: observe_finish, error: observe_error};
    ret app.assemble(?state.application, app.Assembly{
        config: app.Config{limits: app.Limits{max_body_bytes: 65536, max_form_fields: 16,
            max_upload_bytes:       65536, max_route_params: 4, max_request_id_bytes: 64,
            max_active_requests:    256, max_middleware_depth: 4,
            handler_timeout:        opt[duration.Duration].some{30 * duration.SECOND}, max_providers: 1,
            max_provider_key_bytes: 32, max_background_services: 1},
            trust_proxy:            false, panic_policy: middleware.PANIC_ABORT},
        router:        ?state.matcher,
        middleware:    ?state.stack,
        fallback:      handler.Handler{ctx: ctx, call: not_found, resume: nil},
        errors:        error.default_mapper(?state.errors),
        providers:     ?state.providers,
        lifecycle:     ?state.controller,
        sessions:      nil, security: ?state.headers, csrf: nil, origins: nil,
        authenticator: nil, renderer: nil,
        observer:      ?state.observer,
        vocabulary:    ?state.vocabulary,
        event_policy:  observability.policy_default(),
        app_state:     nil,
    });
}

# once the host has stopped it
pub fun release(state: *State) bool {
    ret app.release(?state.application) && lifecycle.destroy(?state.controller);
}

#[testing]
rec Harnessed {
    host:              serve.Host;
    state:             State;
    harness:           testing.Harness;
    response_fields:   [16]field.Field;
    response_trailers: [8]field.Field;
    informationals:    [4]message.Informational;
    arena:             [16384]u8;
    captured:          [4096]u8;
    host_fields:       [1]field.Field;
}

#[testing]
fun answers(fixture: *Harnessed, one: testing.Request, expected: str) bool {
    var result: testing.Result;
    if (testing.invoke(?fixture.harness, one, ?result) != testing.INVOKE_OK) { ret false; }
    val bytes: view.View = testing.response_body(?result);
    ret bytes.len == str_len(expected) && memory.raw_equal(bytes.data, expected, bytes.len);
}

#[testing]
fun get(fixture: *Harnessed, fields: field.Fields, path: str) testing.Request {
    val where: view.View = view.view(path, str_len(path));
    ret testing.request(message.version_h1(1, 1), method.from_kind(method.GET),
        target.origin(where, where, view.view(nil, 0)), fields, view.view("test", 4));
}

# the same assemble main.mach serves, run in process over the same host
# providers, with the task runner stepped by hand
#[testing]
var harnessed: Harnessed;

test app__runs_in_process_unchanged {
    val fixture: *Harnessed = ?harnessed;
    if (!serve.init(?fixture.host, serve.options_default())
        || !assemble(?fixture.state, serve.providers(?fixture.host))) { ret 1; }
    if (!testing.init(?fixture.harness, ?fixture.state.application, ?fixture.state.matcher,
        testing.Storage{response_fields: ?fixture.response_fields[0], response_field_cap: 16,
        response_trailers: ?fixture.response_trailers[0], response_trailer_cap: 8,
        informationals:    ?fixture.informationals[0], informational_cap: 4,
        arena:             ?fixture.arena[0], arena_bytes: 16384,
        captured:          ?fixture.captured[0], captured_capacity: 4096},
        message.limits_default(), testing.DEFAULT_BODY_POLLS)
        || testing.start(?fixture.harness).status != lifecycle.TRANSITION_OK
        || testing.ready(?fixture.harness).status != lifecycle.TRANSITION_OK) { ret 2; }
    runner.poll(serve.task_runner(?fixture.host), time.Instant{sec: 1, nsec: 0});
    var fields: field.Fields = field.init(?fixture.host_fields[0], 1,
        message.limits_default().request_fields);
    if (field.append(?fields, field.Field{name: view.view("host", 4),
        value: view.view("example", 7), sensitive: false}) != field.ADD_OK) { ret 3; }
    if (!answers(fixture, get(fixture, fields, "/hello"), "hello from laurel\n")
        || !answers(fixture, get(fixture, fields, "/refreshes"), "1")) { ret 4; }
    var posted: testing.Request = get(fixture, fields, "/echo");
    posted.method  = method.from_kind(method.POST);
    posted.body    = view.view("abcde", 5);
    posted.suspend = true;
    if (!answers(fixture, posted, "abcde")) { ret 5; }
    val deadline: opt[time.Instant] = opt[time.Instant].some{time.Instant{sec: 2, nsec: 0}};
    if (testing.drain(?fixture.harness, deadline).status != lifecycle.TRANSITION_OK
        || task.drain(fixture.state.tasks, deadline).status != task.DRAIN_DONE
        || task.stop(fixture.state.tasks) != task.STATUS_OK
        || testing.stop(?fixture.harness).status != lifecycle.TRANSITION_OK
        || !release(?fixture.state) || !serve.destroy(?fixture.host)) { ret 6; }
    ret 0;
}
