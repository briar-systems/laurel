# the demo's route handlers
#
# every handler owns its response storage explicitly. laurel never allocates a
# response body on the application's behalf, so each handler takes the bytes it
# needs from the request arena, which the host frees when the exchange settles.
# that arena is the only per-request allocation in the demo.

use A: std.allocator;
use R: std.types.result;
use std.types.bool.bool;
use std.types.char.char;
use std.types.bool.false;
use std.types.bool.true;
use std.types.size.usize;
use std.types.string.str;
use std.types.view;
use http.core.field;
use http.core.message;
use http.core.status;
use http.core.exchange;
use std.chrono.time;
use laurel.context;
use laurel.cookie;
use laurel.error;
use laurel.form;
use laurel.handler;
use laurel.render;
use laurel.session;
use csrf: laurel.security.csrf;

pub val SESSION_LIFETIME_S: i64 = 3600;
val FORM_FIELDS: usize = 4;
val FORM_BYTES: usize = 512;
val FORM_READ_BYTES: usize = 256;
val MAX_BODY_TURNS: usize = 64;

# every handler reaches its shared, application-lifetime state through this
pub rec State {
    protector: *csrf.Protector;
    requests:  u64;
}

# per-request response storage, taken from the request arena
rec Body {
    media: render.Media;
    fixed: render.Fixed;
}

pub fun internal(detail: str) error.AppError {
    ret error.make(error.INTERNAL, 500, "internal server error", detail, false);
}

fun bad_request(public_msg: str, detail: str) error.AppError {
    ret error.make(error.BAD_REQUEST, 400, public_msg, detail, false);
}

fun text_len(value: str) usize {
    var length: usize = 0;
    for (value[length] != 0) { length = length + 1; }
    ret length;
}

pub fun text(value: str) view.View {
    ret view.view(value::*char, text_len(value));
}

# decimal rendering, because laurel formats nothing for the application
pub fun write_u64(value: u64, output: *u8, capacity: usize) usize {
    if (output == nil || capacity == 0) { ret 0; }
    var digits: [20]u8;
    var count: usize = 0;
    var remaining: u64 = value;
    if (remaining == 0) {
        digits[0] = '0'::u8;
        count = 1;
    }
    for (remaining != 0) {
        digits[count] = ('0'::u8) + (remaining % 10)::u8;
        remaining = remaining / 10;
        count = count + 1;
    }
    if (count > capacity) { ret 0; }
    var i: usize = 0;
    for (i < count) {
        output[i] = digits[count - 1 - i];
        i = i + 1;
    }
    ret count;
}

fun unix_seconds() i64 {
    ret time.time_unix_sec(time.now());
}

# laurel keeps session payloads opaque: this is the application's own encoding
fun parse_visits(data: view.View) u64 {
    var i: usize = 0;
    for (i < data.len && data.data[i] != '='::char) { i = i + 1; }
    if (i == data.len) { ret 0; }
    i = i + 1;
    var value: u64 = 0;
    for (i < data.len) {
        val digit: u8 = data.data[i]::u8;
        if (digit < '0'::u8 || digit > '9'::u8) { ret value; }
        value = value * 10 + (digit - '0'::u8)::u64;
        i = i + 1;
    }
    ret value;
}

# there is no form.find: the decoded fields are a bounded array in wire order
fun field_value(decoded: *form.Form, name: view.View) view.View {
    var i: usize = 0;
    for (i < decoded.len) {
        val item: *form.Field = ?decoded.fields[i];
        if (item.name.len == name.len) {
            var same: bool = true;
            var j: usize = 0;
            for (j < name.len) {
                if (item.name.data[j] != name.data[j]) { same = false; }
                j = j + 1;
            }
            if (same) { ret item.value; }
        }
        i = i + 1;
    }
    ret view.view(nil, 0);
}

fun copy_in(output: *u8, capacity: usize, offset: usize, source: view.View) usize {
    if (offset + source.len > capacity) { ret 0; }
    var i: usize = 0;
    for (i < source.len) {
        output[offset + i] = source.data[i]::u8;
        i = i + 1;
    }
    ret offset + source.len;
}

# install one complete in-memory body of the given media type. the Body record
# and the bytes both come from the request arena, so both outlive the handler
# and are released with the exchange rather than by this code.
fun respond_bytes(request_context: *context.Context, state: *State,
    code: status.Status, json: bool, content: view.View)
    R.Result[u8, error.AppError] {
    val arena: *A.Allocator = request_context.alloc;
    if (arena == nil) {
        ret R.err[u8, error.AppError](internal("request arena is unavailable"));
    }
    val allocated: R.Result[*Body, *u8] = A.zallocate[Body](arena, 1);
    if (R.is_err[*Body, *u8](allocated)) {
        ret R.err[u8, error.AppError](internal("response storage was refused"));
    }
    val holder: *Body = R.unwrap_ok[*Body, *u8](allocated);
    var typed: bool = false;
    if (json) { typed = render.application_json(?holder.media); }
    or { typed = render.text_html(?holder.media); }
    val response: *message.Response = context.response(request_context);
    # the body must satisfy the limits the host will commit the response under,
    # which the borrowed exchange carries. an application that substitutes its
    # own limits here builds a response the host then refuses.
    val bound: *exchange.Exchange = context.exchange_ref(request_context);
    if (response == nil || bound == nil || !typed
        || !render.init_fixed(?holder.fixed, content, response.generation,
            bound.limits, ?response.trailers,
            context.cancellation(request_context))) {
        ret R.err[u8, error.AppError](internal("response installation failed"));
    }
    val installed: render.RespondStatus = render.respond(request_context, code,
        ?holder.media, render.fixed_body(?holder.fixed), bound.limits);
    if (installed != render.RESPOND_OK) {
        ret R.err[u8, error.AppError](internal("response installation failed"));
    }
    ret R.ok[u8, error.AppError](handler.RESPOND);
}

# GET /api/hello
pub fun hello(ctx: ptr, request_context: *context.Context)
    R.Result[u8, error.AppError] {
    val state: *State = ctx::*State;
    if (state == nil) {
        ret R.err[u8, error.AppError](internal("handler state is missing"));
    }
    state.requests = state.requests + 1;
    ret respond_bytes(request_context, state, status.OK, true,
        text("{\"message\":\"hello from laurel\"}"));
}

# GET /api/echo/:id
#
# the parameter was decoded during dispatch, before this handler ran, and is
# already a u64. a decoder that rejected the text produced a 400 without ever
# reaching here.
pub fun echo(ctx: ptr, request_context: *context.Context)
    R.Result[u8, error.AppError] {
    val state: *State = ctx::*State;
    val found: *context.Param = context.find_param(request_context, text("id"));
    if (state == nil || found == nil || found.kind != context.PARAM_U64) {
        ret R.err[u8, error.AppError](internal("route parameter is missing"));
    }
    state.requests = state.requests + 1;
    val arena: *A.Allocator = request_context.alloc;
    if (arena == nil) {
        ret R.err[u8, error.AppError](internal("request arena is unavailable"));
    }
    val room: usize = 64;
    val allocated: R.Result[*u8, *u8] = A.allocate[u8](arena, room);
    if (R.is_err[*u8, *u8](allocated)) {
        ret R.err[u8, error.AppError](internal("body storage was refused"));
    }
    val out: *u8 = R.unwrap_ok[*u8, *u8](allocated);
    var length: usize = copy_in(out, room, 0, text("{\"id\":"));
    if (length == 0) {
        ret R.err[u8, error.AppError](internal("body did not fit"));
    }
    val digits: usize = write_u64(found.unsigned_value, ?out[length], room - length);
    if (digits == 0) {
        ret R.err[u8, error.AppError](internal("identifier did not fit"));
    }
    length = copy_in(out, room, length + digits, text("}"));
    if (length == 0) {
        ret R.err[u8, error.AppError](internal("body did not fit"));
    }
    ret respond_bytes(request_context, state, status.OK, true,
        view.view(out::*char, length));
}

# GET /form
#
# establishes a session if there is none, records a visit counter in it, and
# issues a CSRF token bound to that session. the session cookie itself is
# written by laurel's session binder middleware, not by this handler.
pub fun form_page(ctx: ptr, request_context: *context.Context)
    R.Result[u8, error.AppError] {
    val state: *State = ctx::*State;
    if (state == nil || state.protector == nil) {
        ret R.err[u8, error.AppError](internal("handler state is missing"));
    }
    state.requests = state.requests + 1;
    val now: i64 = unix_seconds();
    val request_session: *session.RequestSession =
        session.from_context(request_context);
    if (request_session == nil) {
        ret R.err[u8, error.AppError](internal("no session is bound"));
    }
    if (session.load(request_context, now) == session.REQUEST_INVALID) {
        ret R.err[u8, error.AppError](internal("the session could not be loaded"));
    }
    if (session.request_state(request_session) != session.SESSION_PRESENT
        && session.create_request(request_session, SESSION_LIFETIME_S, now)
            != session.REQUEST_OK) {
        ret R.err[u8, error.AppError](internal("the session could not be created"));
    }
    var visits: u64 = 1;
    val current: *session.Session =
        session.request_session_value(request_session);
    if (current != nil && current.data.len != 0) {
        visits = parse_visits(current.data) + 1;
    }
    val arena: *A.Allocator = request_context.alloc;
    if (arena == nil) {
        ret R.err[u8, error.AppError](internal("request arena is unavailable"));
    }
    var stored: [24]u8;
    var stored_len: usize = copy_in(?stored[0], 24, 0, text("visits="));
    stored_len = stored_len + write_u64(visits, ?stored[stored_len],
        24 - stored_len);
    if (session.write_request(request_session,
        view.view((?stored[0])::*char, stored_len)) != session.REQUEST_OK) {
        ret R.err[u8, error.AppError](internal("the session could not be written"));
    }
    val identity: *session.Session =
        session.request_session_value(request_session);
    if (identity == nil || identity.id.len == 0) {
        ret R.err[u8, error.AppError](internal("the session has no identity"));
    }

    val issued_storage: R.Result[*u8, *u8] =
        A.allocate[u8](arena, csrf.TOKEN_CAPACITY);
    if (R.is_err[*u8, *u8](issued_storage)) {
        ret R.err[u8, error.AppError](internal("token storage was refused"));
    }
    val token: *u8 = R.unwrap_ok[*u8, *u8](issued_storage);
    val issued: csrf.Operation = csrf.issue(state.protector, request_context,
        identity.id, now, token, csrf.TOKEN_CAPACITY);
    if (issued.status != csrf.OK) {
        ret R.err[u8, error.AppError](internal("a csrf token could not be issued"));
    }

    val room: usize = 768;
    val page: R.Result[*u8, *u8] = A.allocate[u8](arena, room);
    if (R.is_err[*u8, *u8](page)) {
        ret R.err[u8, error.AppError](internal("page storage was refused"));
    }
    val out: *u8 = R.unwrap_ok[*u8, *u8](page);
    var length: usize = copy_in(out, room, 0,
        text("<!doctype html><title>laurel demo</title><h1>laurel demo</h1><p>visits: "));
    length = length + write_u64(visits, ?out[length], room - length);
    length = copy_in(out, room, length,
        text("</p><form method=\"post\" action=\"/form\"><input name=\"name\" value=\"world\"><input type=\"hidden\" name=\"csrf_token\" value=\""));
    length = copy_in(out, room, length,
        view.view(token::*char, issued.written));
    length = copy_in(out, room, length,
        text("\"><button type=\"submit\">send</button></form>"));
    if (length == 0) {
        ret R.err[u8, error.AppError](internal("the page did not fit"));
    }
    ret respond_bytes(request_context, state, status.OK, false,
        view.view(out::*char, length));
}

# POST /form
#
# parses a bounded urlencoded body, verifies the CSRF token against the session
# it was issued for, and answers. laurel decodes nothing implicitly: the field
# storage, the byte arena, and the lookup are all the application's.
pub fun form_submit(ctx: ptr, request_context: *context.Context)
    R.Result[u8, error.AppError] {
    val state: *State = ctx::*State;
    if (state == nil || state.protector == nil) {
        ret R.err[u8, error.AppError](internal("handler state is missing"));
    }
    state.requests = state.requests + 1;
    val now: i64 = unix_seconds();
    val request: *message.Request = context.request(request_context);
    val arena: *A.Allocator = request_context.alloc;
    if (request == nil || request.body == nil || arena == nil) {
        ret R.err[u8, error.AppError](internal("the request is unavailable"));
    }
    val fields_storage: R.Result[*form.Field, *u8] =
        A.zallocate[form.Field](arena, FORM_FIELDS);
    val bytes_storage: R.Result[*u8, *u8] = A.allocate[u8](arena, FORM_BYTES);
    val read_storage: R.Result[*u8, *u8] = A.allocate[u8](arena, FORM_READ_BYTES);
    val decoder_storage: R.Result[*form.UrlEncoded, *u8] =
        A.zallocate[form.UrlEncoded](arena, 1);
    val parser_storage: R.Result[*form.BodyParser, *u8] =
        A.zallocate[form.BodyParser](arena, 1);
    if (R.is_err[*form.Field, *u8](fields_storage)
        || R.is_err[*u8, *u8](bytes_storage) || R.is_err[*u8, *u8](read_storage)
        || R.is_err[*form.UrlEncoded, *u8](decoder_storage)
        || R.is_err[*form.BodyParser, *u8](parser_storage)) {
        ret R.err[u8, error.AppError](internal("form storage was refused"));
    }
    val decoder: *form.UrlEncoded =
        R.unwrap_ok[*form.UrlEncoded, *u8](decoder_storage);
    val parser: *form.BodyParser =
        R.unwrap_ok[*form.BodyParser, *u8](parser_storage);
    if (!form.init_urlencoded(decoder, form.Storage{
            fields: R.unwrap_ok[*form.Field, *u8](fields_storage),
            field_capacity: FORM_FIELDS,
            bytes: R.unwrap_ok[*u8, *u8](bytes_storage),
            byte_capacity: FORM_BYTES},
        form.Limits{max_bytes: FORM_BYTES, max_fields: FORM_FIELDS,
            max_name_bytes: 64, max_value_bytes: 512,
            max_temporary_bytes: FORM_BYTES})
        || !form.init_body(parser, decoder, request.body,
            R.unwrap_ok[*u8, *u8](read_storage), FORM_READ_BYTES)) {
        ret R.err[u8, error.AppError](internal("the form decoder was refused"));
    }
    var current: form.Operation = form.poll_body(parser);
    var turns: usize = 0;
    for ((current.status == form.MORE || current.status == form.PENDING)
        && turns < MAX_BODY_TURNS) {
        if (current.status == form.PENDING) {
            current = form.complete_body(parser, current.token);
        } or {
            current = form.poll_body(parser);
        }
        turns = turns + 1;
    }
    # the host reads sockets in its own loop, so a body that has not arrived by
    # the time the handler runs cannot be waited for from inside the handler
    if (current.status == form.PENDING || current.status == form.MORE) {
        ret R.err[u8, error.AppError](error.make(error.UNAVAILABLE, 503,
            "request body was not ready",
            "the request body had not arrived when the handler ran", true));
    }
    if (current.status != form.COMPLETE) {
        ret R.err[u8, error.AppError](current.app_error);
    }

    val supplied: view.View = field_value(?current.form, text("csrf_token"));
    val name: view.View = field_value(?current.form, text("name"));
    val request_session: *session.RequestSession =
        session.from_context(request_context);
    if (request_session == nil
        || session.load(request_context, now) == session.REQUEST_INVALID) {
        ret R.err[u8, error.AppError](internal("the session could not be loaded"));
    }
    val identity: *session.Session =
        session.request_session_value(request_session);
    if (supplied.len == 0) {
        ret R.err[u8, error.AppError](error.make(error.FORBIDDEN, 403, "forbidden",
            "the form carried no csrf_token field", false));
    }
    if (identity == nil) {
        ret R.err[u8, error.AppError](error.make(error.FORBIDDEN, 403, "forbidden",
            "the request carried no usable session cookie", false));
    }
    if (identity.id.len == 0) {
        ret R.err[u8, error.AppError](error.make(error.FORBIDDEN, 403, "forbidden",
            "the session has no identity", false));
    }
    val checked: csrf.Operation = csrf.verify(state.protector, request_context,
        identity.id, supplied, now);
    if (checked.status != csrf.OK) {
        ret R.err[u8, error.AppError](error.make(error.FORBIDDEN, 403, "forbidden",
            "csrf verification failed", false));
    }

    val room: usize = 320;
    val page: R.Result[*u8, *u8] = A.allocate[u8](arena, room);
    if (R.is_err[*u8, *u8](page)) {
        ret R.err[u8, error.AppError](internal("page storage was refused"));
    }
    val out: *u8 = R.unwrap_ok[*u8, *u8](page);
    var length: usize = copy_in(out, room, 0,
        text("<!doctype html><title>laurel demo</title><p>accepted: "));
    var escaped: usize = 0;
    if (render.escape_html(name, ?out[length], room - length, ?escaped)
        != render.ESCAPE_OK) {
        ret R.err[u8, error.AppError](internal("the name could not be escaped"));
    }
    length = copy_in(out, room, length + escaped, text("</p>"));
    if (length == 0) {
        ret R.err[u8, error.AppError](internal("the page did not fit"));
    }
    ret respond_bytes(request_context, state, status.OK, false,
        view.view(out::*char, length));
}
