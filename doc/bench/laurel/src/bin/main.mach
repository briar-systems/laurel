# the benchmark server: laurel.serve hosts the laurel application
#
# the same host the demo uses: create the host, assemble the application, and
# serve it on the calling thread until SIGTERM or SIGINT drains it. one thread
# serves every connection, so the like-for-like baselines run on one thread too

use std.runtime;

use bench.app;
use laurel.serve;
use std.net.ip;
use std.print;
use std.process.env;
use std.types.bool.false;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;

val EXIT_OK:      i64 = 0;
val EXIT_RUNTIME: i64 = 70;
# the drain deadline passed with exchanges still running
val EXIT_DRAIN_INCOMPLETE: i64 = 75;

# the connection count the harness drives, with room for oha's reconnects
val CONNECTIONS: usize = 512;

# BENCH_PORT, or 8081 without it
fun port() u16 {
    var text:  [16]u8;
    val found: res[opt[usize], env.EnvError] = env.get("BENCH_PORT", ?text[0], 16);
    if (!(sel found.ok))      { ret 8081; }
    if (!(sel found.ok.some)) { ret 8081; }
    var value: u32   = 0;
    var i:     usize = 0;
    for (i < found.ok.some && i < 5) {
        if (text[i] < '0' || text[i] > '9') { ret 8081; }
        value = value * 10 + (text[i] - '0')::u32;
        i     = i + 1;
    }
    if (value == 0 || value > 65535) { ret 8081; }
    ret value::u16;
}

fun ready(ctx: ptr, endpoint: ip.Endpoint) {
    print.printlnf("laurel-bench: listening on port {}", endpoint.port::u64);
    print.println("laurel-bench: ready");
}

var bench: app.Application;
var host:  serve.Host;

#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 {
    # the application emits no signals, and a benchmark that logs measures the logger
    var options: serve.Options = serve.options_default();
    options.telemetry = false;
    if (!serve.init(?host, options)) {
        print.eprintln("laurel-bench: the host could not be prepared");
        ret EXIT_RUNTIME;
    }
    var configured: serve.Config = serve.config_default(ip.endpoint(127, 0, 0, 1, port()));
    configured.server.backlog         = 1024;
    configured.server.max_connections = CONNECTIONS;
    configured.server.max_exchanges   = CONNECTIONS;
    configured.ready                  = ready;
    if (!app.assemble(?bench, configured.server.limits)) {
        print.eprintln("laurel-bench: the laurel application could not be assembled");
        ret EXIT_RUNTIME;
    }
    val report: serve.Report = serve.run(?host, ?bench.application, configured);
    var code:   i64          = EXIT_OK;
    if (report.failure != serve.FAILURE_NONE) {
        print.eprintlnf("laurel-bench: stopped with failure {}", report.failure::u64);
        code = EXIT_RUNTIME;
    }
    or (report.server.abandoned_exchanges != 0) {
        print.eprintln("laurel-bench: the drain deadline expired with exchanges still active");
        code = EXIT_DRAIN_INCOMPLETE;
    }
    if (!app.release(?bench) || !serve.destroy(?host)) {
        print.eprintln("laurel-bench: the application did not shut down cleanly");
        if (code == EXIT_OK) { code = EXIT_RUNTIME; }
    }
    if (code == EXIT_OK) { print.println("laurel-bench: stopped"); }
    ret code;
}
