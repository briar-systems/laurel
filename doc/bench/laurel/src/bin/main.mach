# the demo executable: hedge hosts the laurel application
#
# laurel owns no listener and no socket. it defines an application above
# mach-http and stops there. hedge is the server that accepts connections,
# speaks HTTP, and calls into an application, and `hedge.service.laurel` is the
# adapter between the two. this file is the whole of what an embedder writes.
#
# the shape is: read a configuration, assemble the laurel application, register
# it under the name the configuration routes to, compile the dispatch plan, and
# drive hedge's serve loop until it drains.

use std.runtime;
use std.print;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_equals;
use std.types.result.Result;
use std.types.result.is_err;
use std.types.result.unwrap_ok;
use option: std.types.option;
use allocator: std.allocator;
use std.allocator.page;
use std.allocator.fixed;
use std.filesystem;
use std.process.env;
use std.chrono.time;
use http.router.router;
use hedge.config.schema;
use hedge.config.loader;
use hedge.connection;
use http.core.message;
use hedge.generation;
use hedge.serve;
use hedge.service;
use bench.host;
use call: hedge.dispatch.call;
use plan: hedge.dispatch.plan;
use dispatch_middleware: hedge.dispatch.middleware;
use quic_runtime: hedge.protocol.quic.runtime;
use laurel.handler;
use bench.app;
use laurel.middleware;
use laurel.error;
use laurel.context;
use laurel.observability;
use laurel.form;
use laurel.session;

val EXIT_OK: i64 = 0;
val EXIT_CONFIG: i64 = 78;
val EXIT_RUNTIME: i64 = 70;

val CONFIG_ARENA_BYTES: usize = 262144;

val MAX_ROUTES: usize = 16;
val MAX_SEGMENTS: usize = 128;
val MAX_SERVICES: usize = 16;
val MAX_MIDDLEWARE: usize = 8;
val PLAN_TEXT: usize = 8192;

# the connection pool. every accepted connection borrows one slot, so this is
# the ceiling on concurrent sockets and it must match `max_connections` in the
# configuration: a pool smaller than the configured limit lets hedge admit
# connections it has no slot for, and they are aborted rather than served.
val POOL: usize = 512;

# the name the configuration routes to. `application = "site"` in hedge.toml
# resolves through this string, so the two must agree exactly.
val APPLICATION_NAME: str = "site";

# everything that must outlive a request lives here, in one heap allocation.
# a Handler borrows the Adapter by raw pointer and the plan borrows the handler,
# so none of this may sit in a stack frame the server returns through.
rec Boot {
    demo:              app.Application;
    adapter:           host.Adapter;
    request_slots:     [POOL]host.RequestState;
    applications:      service.Applications;
    application_slots: [4]service.Application;
    resolver:          service.Resolver;
    routes:            [MAX_ROUTES]router.CompiledRoute;
    segments:          [MAX_SEGMENTS]router.Segment;
    specs:             [MAX_ROUTES]router.Route;
    entries:           [MAX_ROUTES]plan.Entry;
    services:          [MAX_SERVICES]service.Descriptor;
    middlewares:       [MAX_MIDDLEWARE]dispatch_middleware.Middleware;
    text:              [PLAN_TEXT]u8;
    storage:           plan.Storage;
    plan:              plan.Plan;
    slots:             [POOL]serve.Slot;
    connections:       [POOL]connection.Connection;
    runtime:           serve.Runtime;
    diagnostics:       schema.Diagnostics;
    candidate:         generation.Generation;
    assembled:         bool;
}

fun capabilities() loader.Capabilities {
    ret loader.Capabilities{
        quic: false,
        local_transport: false,
        environment_secrets: true,
        file_secrets: false,
        os_secrets: false,
        application_secrets: false,
    };
}

fun resolve_environment(context: ptr, name: str, output: *u8, capacity: usize) i64 {
    ret env.get(name, output, capacity);
}

fun report_diagnostics(diagnostics: *schema.Diagnostics) {
    var i: usize = 0;
    for (i < diagnostics.count) {
        val item: *schema.Diagnostic = ?diagnostics.items[i];
        print.eprint("laurel-bench: ");
        print.eprint(schema.text(?item.path));
        print.eprint(": ");
        print.eprintln(schema.text(?item.message));
        i = i + 1;
    }
}

# the construction hook hedge calls while sealing a configuration generation.
#
# this is where the laurel application becomes reachable by name. the sealed
# graph has already been validated, so an application that cannot be assembled
# here stops the server before a listener ever binds.
fun construct(context: ptr, graph: *schema.Graph,
    diagnostics: *schema.Diagnostics) bool {
    val boot: *Boot = context::*Boot;
    if (boot == nil) { ret false; }
    val limits: message.Limits = connection.message_limits(graph,
        connection.config_from(graph));
    if (!app.assemble(?boot.demo, limits)) {
        schema.add_diagnostic(diagnostics, schema.ERROR, schema.SOURCE_ERROR,
            "application", "application", "the laurel application could not be assembled");
        ret false;
    }
    boot.assembled = true;
    if (!app.start(?boot.demo)) {
        schema.add_diagnostic(diagnostics, schema.ERROR, schema.SOURCE_ERROR,
            "application", "application", "the laurel application never became ready");
        ret false;
    }
    if (!host.make(?boot.adapter, ?boot.demo.application, ?boot.demo.matcher,
        app.fallback_handler(), ?boot.request_slots[0], POOL)) {
        schema.add_diagnostic(diagnostics, schema.ERROR, schema.SOURCE_ERROR,
            "application", "application", "the laurel service adapter could not be bound");
        ret false;
    }
    if (!service.make_applications(?boot.applications, ?boot.application_slots[0], 4)
        || !service.register_application(?boot.applications, APPLICATION_NAME,
            host.bound_handler(?boot.adapter))) {
        schema.add_diagnostic(diagnostics, schema.ERROR, schema.SOURCE_ERROR,
            "application", "application", "the laurel application could not be registered");
        ret false;
    }
    ret true;
}

fun configuration_path(argc: i64, argv: **u8) str {
    if (argc > 1 && argv[1] != nil) { ret argv[1]::str; }
    ret "hedge.toml";
}

fun announce(boot: *Boot, graph: *schema.Graph) {
    var text: [64]u8;
    var i: usize = 0;
    for (i < graph.listener_count) {
        val length: usize = serve.bound_endpoint_text(?boot.runtime, i, ?text[0], 64);
        if (length != 0) {
            text[length] = 0;
            print.print("laurel-bench: listening on ");
            print.println((?text[0])::str);
        }
        i = i + 1;
    }
    print.println("laurel-bench: ready");
}

#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 {
    var heap: allocator.Allocator;
    if (option.is_some[*u8](page.make(?heap))) {
        print.eprintln("laurel-bench: page allocator initialization failed");
        ret EXIT_RUNTIME;
    }
    val path: str = configuration_path(argc, argv);
    val loaded: Result[str, str] = filesystem.read_string(?heap, path);
    if (is_err[str, str](loaded)) {
        print.eprint("laurel-bench: cannot read configuration ");
        print.eprintln(path);
        ret EXIT_CONFIG;
    }
    val source: str = unwrap_ok[str, str](loaded);

    val booted: Result[*Boot, *u8] = allocator.zallocate[Boot](?heap, 1);
    val arena: Result[*u8, *u8] = allocator.allocate[u8](?heap, CONFIG_ARENA_BYTES);
    if (is_err[*Boot, *u8](booted) || is_err[*u8, *u8](arena)) {
        print.eprintln("laurel-bench: startup allocation failed");
        ret EXIT_RUNTIME;
    }
    val boot: *Boot = unwrap_ok[*Boot, *u8](booted);

    var config_allocator: allocator.Allocator;
    var config_state: fixed.FixedState;
    fixed.make(?config_allocator, ?config_state, unwrap_ok[*u8, *u8](arena),
        CONFIG_ARENA_BYTES);

    var resolver: loader.Resolver = loader.Resolver{
        context: nil,
        include: (0::usize)::loader.ResolveFun,
        environment: resolve_environment,
    };
    schema.reset_diagnostics(?boot.diagnostics);
    if (!generation.make_candidate(?boot.candidate, 1)) {
        print.eprintln("laurel-bench: generation initialization failed");
        ret EXIT_RUNTIME;
    }
    if (!loader.build(?boot.candidate.graph, ?boot.diagnostics, ?config_allocator,
        path, source, ?resolver, capabilities())) {
        report_diagnostics(?boot.diagnostics);
        print.eprintln("laurel-bench: the configuration is not valid");
        ret EXIT_CONFIG;
    }
    # sealing runs `construct`, which assembles and registers the application
    if (!generation.seal(?boot.candidate, ?boot.diagnostics, boot::ptr, construct)) {
        report_diagnostics(?boot.diagnostics);
        print.eprintln("laurel-bench: the application generation did not seal");
        ret EXIT_CONFIG;
    }

    # this binary drives hedge's serve loop directly rather than going through
    # hedge.composition, so it installs the service factories it wants itself.
    boot.resolver = service.no_resolver();
    boot.resolver.applications = ?boot.applications;

    if (!plan.make_storage(?boot.storage,
        ?boot.routes[0], MAX_ROUTES,
        ?boot.segments[0], MAX_SEGMENTS,
        ?boot.specs[0], MAX_ROUTES,
        ?boot.entries[0], MAX_ROUTES,
        ?boot.services[0], MAX_SERVICES,
        ?boot.middlewares[0], MAX_MIDDLEWARE,
        ?boot.text[0], PLAN_TEXT)) {
        print.eprintln("laurel-bench: dispatch storage was refused");
        ret EXIT_RUNTIME;
    }
    val compiled: plan.Report = plan.compile(?boot.plan, boot.candidate.id,
        ?boot.candidate.graph, boot.storage, ?boot.resolver, nil);
    if (compiled.status != plan.PLAN_OK) {
        print.eprint("laurel-bench: dispatch plan failed: ");
        print.eprintln(compiled.detail);
        ret EXIT_CONFIG;
    }

    var quic_controls: quic_runtime.ControlView;
    if (!serve.make(?boot.runtime, ?boot.slots[0], ?boot.connections[0], POOL,
        ?boot.plan, ?boot.candidate.graph)) {
        print.eprintln("laurel-bench: the serving runtime was refused");
        ret EXIT_RUNTIME;
    }
    schema.reset_diagnostics(?boot.diagnostics);
    if (!serve.start(?quic_controls, ?boot.runtime, boot.candidate.id,
        ?boot.candidate.graph, ?boot.diagnostics)) {
        report_diagnostics(?boot.diagnostics);
        print.eprintln("laurel-bench: the listener did not start");
        ret EXIT_RUNTIME;
    }
    announce(boot, ?boot.candidate.graph);

    # hedge is driven, not threaded: every accepted connection, every parsed
    # request, and every laurel handler call happens inside this poll.
    for (true) {
        serve.poll(?quic_controls, ?boot.runtime, serve.DEFAULT_POLL_MS);
        if (serve.drained(?boot.runtime)) { brk; }
    }

    var code: i64 = EXIT_OK;
    if (!serve.stop(?quic_controls, ?boot.runtime)) {
        print.eprintln("laurel-bench: the serving runtime did not stop cleanly");
        code = EXIT_RUNTIME;
    }
    if (boot.assembled && !app.shutdown(?boot.demo)) {
        print.eprintln("laurel-bench: the application did not shut down cleanly");
        code = EXIT_RUNTIME;
    }
    ret code;
}
