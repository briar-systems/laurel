# the benchmark application: three routes, nothing else
#
# this is deliberately the smallest application that still uses the framework
# honestly. it has a router with a typed parameter, one middleware, an observer,
# a lifecycle service and an error mapper, because a laurel application cannot
# be assembled without them. it has no sessions and no CSRF, so that it measures
# the same work the Go and Rust programs do.

use R: std.types.result;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.size.usize;
use std.types.string.str;
use std.types.view;
use http.core.message;
use http.core.method;
use http_router: http.router.router;
use laurel.app;
use laurel.context;
use laurel.error;
use laurel.handler;
use laurel.lifecycle;
use laurel.middleware;
use laurel.observability;
use laurel.provider;
use laurel.router;
use laurel.security;
use bench.handlers;

pub val ROUTE_COUNT: usize = 3;
val SEGMENT_COUNT: usize = 12;
val MIDDLEWARE_COUNT: usize = 1;

pub val MAX_ACTIVE_REQUESTS: usize = 512;

pub rec Application {
    parameters:     [1]router.Parameter;
    routes:         [ROUTE_COUNT]router.Route;
    specifications: [ROUTE_COUNT]http_router.Route;
    compiled:       [ROUTE_COUNT]http_router.CompiledRoute;
    segments:       [SEGMENT_COUNT]http_router.Segment;
    matcher:        router.Router;
    middlewares:    [MIDDLEWARE_COUNT]middleware.Middleware;
    stack:          middleware.Stack;
    providers:      provider.Set;
    services:       [1]lifecycle.Lifecycle;
    controller:     lifecycle.Controller;
    headers:        security.HeadersPolicy;
    errors:         error.Default;
    label_specs:    [1]observability.LabelSpec;
    vocabulary:     observability.Vocabulary;
    observer:       observability.Observer;
    counters:       Counters;
    state:          handlers.State;
    application:    app.App;
}

# the observer is counted, never printed: a benchmark that logs per request
# measures the logger
pub rec Counters {
    started:  u64;
    finished: u64;
    failed:   u64;
}

fun observer_start(ctx: ptr, event: *observability.RequestEvent) {
    val state: *Counters = ctx::*Counters;
    state.started = state.started + 1;
}

fun observer_finish(ctx: ptr, event: *observability.RequestEvent) {
    val state: *Counters = ctx::*Counters;
    state.finished = state.finished + 1;
}

fun observer_error(ctx: ptr, event: *observability.RequestEvent,
    failure: error.AppError) {
    val state: *Counters = ctx::*Counters;
    state.failed = state.failed + 1;
}

fun service_start(ctx: ptr) R.Result[lifecycle.CallbackStatus, view.View] {
    ret R.ok[lifecycle.CallbackStatus, view.View](lifecycle.CALLBACK_DONE);
}

fun service_ready(ctx: ptr) lifecycle.Readiness {
    ret lifecycle.READY_NOW;
}

fun service_drain(ctx: ptr, deadline_ns: i64)
    R.Result[lifecycle.CallbackStatus, view.View] {
    ret R.ok[lifecycle.CallbackStatus, view.View](lifecycle.CALLBACK_DONE);
}

fun service_stop(ctx: ptr) R.Result[lifecycle.CallbackStatus, view.View] {
    ret R.ok[lifecycle.CallbackStatus, view.View](lifecycle.CALLBACK_DONE);
}

# one middleware that does the smallest real thing: it calls the rest of the
# chain and then applies the framework's secure response headers. the Go and
# Rust programs set the same headers by hand, so all three do equal work.
fun secure_headers_middleware(ctx: ptr, next: middleware.Next,
    request_context: *context.Context) R.Result[u8, error.AppError] {
    val policy: *security.HeadersPolicy = ctx::*security.HeadersPolicy;
    val result: R.Result[u8, error.AppError] =
        middleware.call(next, request_context);
    if (!R.is_err[u8, error.AppError](result) && context.active(request_context)) {
        security.apply_headers(policy, context.request(request_context),
            context.response(request_context));
    }
    ret result;
}

fun not_found(ctx: ptr, request_context: *context.Context)
    R.Result[u8, error.AppError] {
    ret R.err[u8, error.AppError](error.make(error.NOT_FOUND, 404, "not found",
        "no route matched the request target", false));
}

pub fun fallback_handler() handler.Handler {
    ret handler.Handler{ctx: nil, call: not_found};
}

fun route(method_rule: router.Method, pattern: view.View, name: str,
    parameters: *router.Parameter, parameter_len: usize,
    call: handler.HandlerFun, ctx: ptr) router.Route {
    ret router.Route{method: method_rule, host: router.any_host(),
        path: router.path(pattern), name: name, parameters: parameters,
        parameter_len: parameter_len,
        handler: handler.Handler{ctx: ctx, call: call}};
}

pub fun assemble(bench: *Application, limits: message.Limits) bool {
    if (bench == nil) { ret false; }
    if (!security.secure_headers(?bench.headers)) { ret false; }

    bench.parameters[0] = router.Parameter{name: handlers.text("id"),
        wildcard: false, decoder: router.u64_decoder()};
    bench.routes[0] = route(
        router.exact_method(method.from_kind(method.GET)),
        handlers.text("/json"), "json", nil, 0,
        handlers.json_hello, (?bench.state)::ptr);
    bench.routes[1] = route(
        router.exact_method(method.from_kind(method.GET)),
        handlers.text("/echo/:id"), "echo",
        ?bench.parameters[0], 1, handlers.echo, (?bench.state)::ptr);
    bench.routes[2] = route(
        router.exact_method(method.from_kind(method.POST)),
        handlers.text("/submit"), "submit", nil, 0,
        handlers.submit, (?bench.state)::ptr);

    val storage: router.Storage = router.Storage{
        specifications: ?bench.specifications[0], specification_cap: ROUTE_COUNT,
        compiled_routes: ?bench.compiled[0], compiled_route_cap: ROUTE_COUNT,
        segments: ?bench.segments[0], segment_cap: SEGMENT_COUNT};
    if (router.compile(?bench.matcher, ?bench.routes[0], ROUTE_COUNT, storage,
        router.limits_default()).status != router.COMPILE_OK) { ret false; }

    bench.middlewares[0] = middleware.Middleware{ctx: (?bench.headers)::ptr,
        call: secure_headers_middleware};
    bench.stack = middleware.Stack{items: ?bench.middlewares[0],
        len: MIDDLEWARE_COUNT};

    if (!provider.init(?bench.providers, nil, 0, 0, 32)) { ret false; }
    bench.services[0] = lifecycle.Lifecycle{ctx: nil, start: service_start,
        ready: service_ready, drain: service_drain, stop: service_stop};
    if (!lifecycle.init(?bench.controller, ?bench.services[0], 1, 1)) { ret false; }
    if (!error.initialize_default(?bench.errors, limits, 512)) { ret false; }

    if (!observability.term(?bench.label_specs[0].name, handlers.text("kind"))) {
        ret false;
    }
    bench.label_specs[0].values = nil;
    bench.label_specs[0].value_count = 0;
    bench.label_specs[0].max_value_bytes = 16;
    if (!observability.init_vocabulary(?bench.vocabulary, ?bench.label_specs[0], 1)) {
        ret false;
    }
    bench.observer = observability.Observer{ctx: (?bench.counters)::ptr,
        start: observer_start, finish: observer_finish, error: observer_error};

    val assembly: app.Assembly = app.Assembly{
        config: app.Config{
            limits: app.Limits{
                max_body_bytes: 65536,
                max_form_fields: 16,
                max_upload_bytes: 65536,
                max_route_params: 4,
                max_request_id_bytes: 64,
                max_active_requests: MAX_ACTIVE_REQUESTS,
                max_middleware_depth: 8,
                handler_deadline_ns: lifecycle.NO_DEADLINE,
                max_providers: 0,
                max_provider_key_bytes: 32,
                max_background_services: 1},
            trust_proxy: false,
            panic_policy: middleware.PANIC_ABORT},
        router: ?bench.matcher,
        middleware: ?bench.stack,
        fallback: fallback_handler(),
        errors: error.default_mapper(?bench.errors),
        providers: ?bench.providers,
        lifecycle: ?bench.controller,
        sessions: nil,
        security: ?bench.headers,
        csrf: nil,
        origins: nil,
        authenticator: nil,
        renderer: nil,
        observer: ?bench.observer,
        vocabulary: ?bench.vocabulary,
        event_policy: observability.policy_default(),
        app_state: nil,
    };
    ret app.assemble(?bench.application, assembly);
}

pub fun start(bench: *Application) bool {
    if (app.start(?bench.application).status != lifecycle.TRANSITION_OK) {
        ret false;
    }
    var polls: usize = 0;
    for (polls < 64) {
        val ready: lifecycle.Transition = app.poll_ready(?bench.application);
        if (ready.status == lifecycle.TRANSITION_OK) {
            ret app.can_accept(?bench.application);
        }
        if (ready.status != lifecycle.TRANSITION_PENDING) { ret false; }
        polls = polls + 1;
    }
    ret false;
}

pub fun shutdown(bench: *Application) bool {
    var drained: bool = false;
    var polls: usize = 0;
    for (polls < 64 && !drained) {
        val moved: lifecycle.Transition =
            app.drain(?bench.application, lifecycle.NO_DEADLINE);
        drained = moved.status == lifecycle.TRANSITION_OK;
        if (moved.status != lifecycle.TRANSITION_PENDING && !drained) { ret false; }
        polls = polls + 1;
    }
    var stopped: bool = false;
    polls = 0;
    for (polls < 64 && !stopped) {
        val moved: lifecycle.Transition = app.stop(?bench.application);
        stopped = moved.status == lifecycle.TRANSITION_OK;
        if (moved.status != lifecycle.TRANSITION_PENDING && !stopped) { ret false; }
        polls = polls + 1;
    }
    if (!app.release(?bench.application)) { ret false; }
    ret lifecycle.destroy(?bench.controller);
}
