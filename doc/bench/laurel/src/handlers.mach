# the three benchmark handlers
#
# each one owns its response bytes and takes them from the per-request arena,
# because laurel allocates nothing on the application's behalf.

use http.core.exchange;
use http.core.message;
use http.core.status;
use laurel.context;
use laurel.error;
use laurel.form;
use laurel.handler;
use laurel.render;
use A: std.allocator;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.char.char;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.view;

val FORM_FIELDS:     usize = 4;
val FORM_BYTES:      usize = 512;
val FORM_READ_BYTES: usize = 256;

pub rec State {
    requests: u64;
}

rec Body {
    media: render.Media;
    fixed: render.Fixed;
}

pub fun internal(detail: str) error.AppError {
    ret error.make(error.INTERNAL, 500, "internal server error", detail, false);
}

fun text_len(value: str) usize {
    var length: usize = 0;
    for (value[length] != 0) { length = length + 1; }
    ret length;
}

pub fun text(value: str) view.View {
    ret view.view(value::*char, text_len(value));
}

fun write_u64(value: u64, output: *u8, capacity: usize) usize {
    if (output == nil || capacity == 0) { ret 0; }
    var digits:    [20]u8;
    var count:     usize = 0;
    var remaining: u64   = value;
    if (remaining == 0) {
        digits[0] = '0'::u8;
        count     = 1;
    }
    for (remaining != 0) {
        digits[count] = ('0'::u8) + (remaining % 10)::u8;
        remaining     = remaining / 10;
        count         = count + 1;
    }
    if (count > capacity) { ret 0; }
    var i: usize = 0;
    for (i < count) {
        output[i] = digits[count - 1 - i];
        i         = i + 1;
    }
    ret count;
}

fun copy_in(output: *u8, capacity: usize, offset: usize, source: view.View) usize {
    if (offset + source.len > capacity) { ret 0; }
    var i: usize = 0;
    for (i < source.len) {
        output[offset + i] = source.data[i]::u8;
        i                  = i + 1;
    }
    ret offset + source.len;
}

fun field_value(decoded: *form.Form, name: view.View) view.View {
    var i: usize = 0;
    for (i < decoded.len) {
        val item: *form.Field = ?decoded.fields[i];
        if (item.name.len == name.len) {
            var same: bool  = true;
            var j:    usize = 0;
            for (j < name.len) {
                if (item.name.data[j] != name.data[j]) { same = false; }
                j = j + 1;
            }
            if (same) { ret item.value; }
        }
        i = i + 1;
    }
    ret view.view(nil, 0);
}

# the response is built against the limits the host will commit it under, which
# the borrowed exchange carries
fun respond_json(request_context: *context.Context, content: view.View)
    handler.Result {
    val arena: *A.Allocator = request_context.alloc;
    if (arena == nil) {
        ret handler.fail(internal("request arena is unavailable"));
    }
    val allocated: res[*Body, A.Error] = A.zallocate[Body](arena, 1);
    if (sel allocated.err) {
        ret handler.fail(internal("response storage was refused"));
    }
    val holder:   *Body              = allocated.ok;
    val response: *message.Response  = context.response(request_context);
    val bound:    *exchange.Exchange = context.exchange_ref(request_context);
    if (response == nil || bound == nil
        || !render.application_json(?holder.media)
        || !render.init_fixed(?holder.fixed, content, response.generation,
        bound.limits, ?response.trailers,
        context.cancellation(request_context))
        || render.respond_with_limits(request_context, status.OK, ?holder.media,
        render.fixed_body(?holder.fixed), bound.limits) != render.RESPOND_OK) {
        ret handler.fail(internal("response installation failed"));
    }
    ret handler.respond();
}

# GET /json
pub fun json_hello(ctx: ptr, request_context: *context.Context,
    slot: *ptr) handler.Result {
    @slot = nil;
    val state: *State = ctx::*State;
    if (state == nil) {
        ret handler.fail(internal("handler state is missing"));
    }
    state.requests = state.requests + 1;
    ret respond_json(request_context, text("{\"message\":\"hello\"}"));
}

# GET /echo/:id
pub fun echo(ctx: ptr, request_context: *context.Context,
    slot: *ptr) handler.Result {
    @slot = nil;
    val state: *State         = ctx::*State;
    val found: *context.Param = context.find_param(request_context, text("id"));
    if (state == nil || found == nil || found.kind != context.PARAM_U64) {
        ret handler.fail(internal("route parameter is missing"));
    }
    state.requests = state.requests + 1;
    val arena: *A.Allocator = request_context.alloc;
    if (arena == nil) {
        ret handler.fail(internal("request arena is unavailable"));
    }
    val room:      usize             = 48;
    val allocated: res[*u8, A.Error] = A.allocate[u8](arena, room);
    if (sel allocated.err) {
        ret handler.fail(internal("body storage was refused"));
    }
    val out:    *u8   = allocated.ok;
    var length: usize = copy_in(out, room, 0, text("{\"id\":"));
    val digits: usize = write_u64(found.unsigned_value, ?out[length], room - length);
    if (length == 0 || digits == 0) {
        ret handler.fail(internal("body did not fit"));
    }
    length = copy_in(out, room, length + digits, text("}"));
    if (length == 0) {
        ret handler.fail(internal("body did not fit"));
    }
    ret respond_json(request_context, view.view(out::*char, length));
}

# POST /submit
#
# hedge enters a service at the request headers, before any body byte has been
# read, so the first poll of the body usually suspends. the handler leaves the
# chain with the pending token and is resumed with exactly that read settled,
# and everything it needs across the suspension lives in this record.
rec FormWork {
    fields:  [FORM_FIELDS]form.Field;
    bytes:   [FORM_BYTES]u8;
    buffer:  [FORM_READ_BYTES]u8;
    decoder: form.UrlEncoded;
    parser:  form.BodyParser;
}

# one pass over whatever the body has so far: a pending read suspends the
# chain, and the work below runs once, when the body is complete
fun drive_form(request_context: *context.Context, work: *FormWork,
    first: form.Operation) handler.Result {
    var current: form.Operation = first;
    for {
        if (current.status == form.PENDING)  { ret handler.suspend(current.token); }
        if (current.status == form.COMPLETE) { brk; }
        if (current.status != form.MORE)     { ret handler.fail(current.app_error); }
        current = form.poll_body(?work.parser);
    }
    val name: view.View = field_value(?current.form, text("name"));
    if (name.len == 0) {
        ret handler.fail(error.make(error.BAD_REQUEST, 400,
            "name is required", "the form carried no name field", false));
    }
    val arena: *A.Allocator      = request_context.alloc;
    val room:  usize             = 320;
    val page:  res[*u8, A.Error] = A.allocate[u8](arena, room);
    if (sel page.err) {
        ret handler.fail(internal("body storage was refused"));
    }
    val out:     *u8   = page.ok;
    var length:  usize = copy_in(out, room, 0, text("{\"name\":\""));
    var escaped: usize = 0;
    if (render.escape_json(name, ?out[length], room - length, ?escaped)
        != render.ESCAPE_OK) {
        ret handler.fail(internal("the name could not be escaped"));
    }
    length = copy_in(out, room, length + escaped, text("\"}"));
    if (length == 0) {
        ret handler.fail(internal("body did not fit"));
    }
    ret respond_json(request_context, view.view(out::*char, length));
}

pub fun submit(ctx: ptr, request_context: *context.Context,
    slot: *ptr) handler.Result {
    @slot = nil;
    val state: *State = ctx::*State;
    if (state == nil) {
        ret handler.fail(internal("handler state is missing"));
    }
    state.requests = state.requests + 1;
    val request: *message.Request = context.request(request_context);
    val arena:   *A.Allocator     = request_context.alloc;
    if (request == nil || request.body == nil || arena == nil) {
        ret handler.fail(internal("the request is unavailable"));
    }
    val allocated: res[*FormWork, A.Error] = A.zallocate[FormWork](arena, 1);
    if (sel allocated.err) {
        ret handler.fail(internal("form storage was refused"));
    }
    val work: *FormWork = allocated.ok;
    @slot = work::ptr;
    if (!form.init_urlencoded(?work.decoder, form.Storage{
        fields:         ?work.fields[0],
        field_capacity: FORM_FIELDS,
        bytes:          ?work.bytes[0],
        byte_capacity:  FORM_BYTES
    },
        form.Limits{max_bytes: FORM_BYTES, max_fields: FORM_FIELDS,
        max_name_bytes:      64, max_value_bytes: 256,
        max_temporary_bytes: FORM_BYTES})
        || !form.init_body(?work.parser, ?work.decoder, request.body,
        ?work.buffer[0], FORM_READ_BYTES)) {
        ret handler.fail(internal("the form decoder was refused"));
    }
    ret drive_form(request_context, work, form.poll_body(?work.parser));
}

# re-entry after a suspended body read settled. an abandoned read means the
# exchange is going away, so there is nothing left to answer.
pub fun submit_resume(ctx: ptr, request_context: *context.Context, slot: ptr,
    settlement: handler.Settlement, token: u64) handler.Result {
    val work: *FormWork = slot::*FormWork;
    if (work == nil)                            { ret handler.fail(internal("form state did not survive")); }
    if (settlement == handler.SETTLE_ABANDONED) { ret handler.respond(); }
    ret drive_form(request_context, work,
        form.complete_body(?work.parser, token));
}
