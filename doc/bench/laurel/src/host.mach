# the seam between hedge and the laurel application
#
# hedge ships `hedge.service.laurel`, which binds a laurel application to its
# service handler contract. that adapter admits every request with an empty
# parameter set, so an application hosted through it can only use handlers that
# take no typed route parameters: `laurel.router.invoke` requires the bound
# context to already carry the parameters that dispatch produced, and the
# adapter never runs dispatch. see doc/HOSTING.md.
#
# this file is the same seam with the dispatch step restored. it is written
# against hedge's public service handler contract, which is what any service
# kind uses, so nothing here reaches into hedge internals.

use A: std.allocator;
use std.types.result.res;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.char.char;
use std.types.string.str;
use std.types.size.usize;
use std.types.view;
use std.chrono.time;
use std.sync.cancel;
use http.core.exchange;
use http.core.message;
use http.core.body;
use http.core.field;
use http.core.status;
use laurel.app;
use laurel.context;
use laurel.error;
use laurel.handler;
use laurel.middleware;
use laurel.observability;
use laurel.router;
use call: hedge.dispatch.call;
use service: hedge.service;
use trace: hedge.telemetry.trace;


fun monotonic_now() time.Time {
    val sampled: time.Clock = time.monotonic();
    if (sel sampled.ok) { ret sampled.ok; }
    ret time.Time{sec: 0, nsec: 0};
}
val REQUEST_ID_BYTES: usize = 32;

# a laurel handler is synchronous: it runs to completion inside one call and
# cannot wait for bytes the server has not read yet, because the server only
# reads inside the same poll that is running the handler. so the request body is
# buffered here first, and laurel is admitted once the whole body is in hand.
# the buffer comes from the host's per-request arena, whose size the application
# declares at registration, so this bounds how large a body a handler is given.
val MAX_BUFFERED_BODY: usize = 1024;

val PHASE_BUFFERING: u8 = 1;
val PHASE_READY: u8 = 2;

pub rec Adapter {
    application: *app.App;
    routes:      *router.Router;
    fallback:    handler.Handler;
    slots:       *RequestState;
    capacity:    usize;
    bound:       bool;
}

# one request's worth of laurel state, allocated from the call arena and
# released when the exchange settles
# laurel's per-request state is 8232 bytes on this target, two thirds of the
# 12 KiB arena hedge gives a call, and the framework needs most of the rest for
# sessions, forms and the response body. so the host owns one slot per concurrent
# request out of its own storage and leaves the arena to the application.
pub rec RequestState {
    owner:       *call.Call;
    application: *app.App;
    routes:      *router.Router;
    fallback:    handler.Handler;
    matched:     router.Dispatch;
    context:     context.Context;
    recorder:    observability.Recorder;
    outcome:     middleware.Outcome;
    identifier:  [32]char;
    phase:       u8;
    arena:       *A.Allocator;
    body:        *u8;
    body_len:    usize;
    body_done:   bool;
    body_failed: bool;
    too_large:   bool;
    pending:     bool;
    pending_tok: u64;
    offset:      usize;
    reader:      body.Reader;
    trailers:    field.Fields;
    bound:       bool;
}

# a reader over the bytes this host already buffered, handed to laurel in place
# of the connection's own reader so the framework never suspends
fun buffered_read(ctx: ptr, output: *u8, capacity: usize,
    trailers: *field.Fields) body.Progress {
    val state: *RequestState = ctx::*RequestState;
    if (state == nil || state.offset > state.body_len
        || (capacity != 0 && output == nil)) {
        ret body.failed("invalid buffered body", body.REUSE_FORBIDDEN);
    }
    if (state.offset == state.body_len) { ret body.complete(body.REUSE_ALLOWED); }
    var count: usize = state.body_len - state.offset;
    if (count > capacity) { count = capacity; }
    if (count == 0) { ret body.failed("empty buffered read", body.REUSE_FORBIDDEN); }
    var i: usize = 0;
    for (i < count) {
        output[i] = state.body[state.offset + i];
        i = i + 1;
    }
    state.offset = state.offset + count;
    ret body.data(count);
}

fun buffered_finish(ctx: ptr, mode: body.Mode,
    trailers: *field.Fields) body.Progress {
    val state: *RequestState = ctx::*RequestState;
    if (state == nil) {
        ret body.failed("invalid buffered body", body.REUSE_FORBIDDEN);
    }
    if (mode == body.REJECT) { ret body.rejected(body.REUSE_ALLOWED); }
    if (mode == body.CANCEL) { ret body.cancelled(body.REUSE_FORBIDDEN); }
    if (mode == body.TIMEOUT) { ret body.timed_out(body.REUSE_FORBIDDEN); }
    state.offset = state.body_len;
    ret body.complete(body.REUSE_ALLOWED);
}

fun buffered_complete(ctx: ptr, token: u64,
    trailers: *field.Fields) body.Progress {
    ret body.failed("buffered body never suspends", body.REUSE_FORBIDDEN);
}

fun buffered_release(ctx: ptr) {}

# pull whatever the connection has, reporting whether the whole body is in hand.
#
# hedge enters a service at the request headers, before any body byte is parsed,
# so the first read suspends. the read belongs to this host until it completes
# it: returning SERVICE_PENDING gives the connection a turn to collect the bytes,
# and the next entry resolves the token this host is holding.
fun accumulate(state: *RequestState, source: *body.Reader) bool {
    var turns: usize = 0;
    for (turns < 64) {
        turns = turns + 1;
        if (body.reader_terminal_state(source)) {
            state.body_done = true;
            ret true;
        }
        var progress: body.Progress;
        if (state.pending_tok != 0) {
            progress          = body.complete_reader(source, state.pending_tok);
            state.pending_tok = 0;
            state.pending     = false;
        }
        or {
            # a read this host did not issue is not this host's to resolve
            if (source.pending_kind != body.OP_NONE) {
                state.pending = true;
                ret false;
            }
            # the buffer is taken only once a body actually needs one, because a
            # bodyless GET must not spend the arena a handler is about to need
            if (state.body == nil) {
                val buffer: res[*u8, A.Error] =
                    A.allocate[u8](state.arena, MAX_BUFFERED_BODY);
                if (sel buffer.err) {
                    state.body_failed = true;
                    ret true;
                }
                state.body = buffer.ok;
            }
            val room: usize = MAX_BUFFERED_BODY - state.body_len;
            if (room == 0) {
                state.too_large   = true;
                state.body_failed = true;
                ret true;
            }
            progress = body.read(source, ?state.body[state.body_len], room);
        }
        if (progress.status == body.DATA) {
            state.body_len = state.body_len + progress.count;
        }
        or (progress.status == body.PENDING) {
            state.pending     = true;
            state.pending_tok = progress.token;
            ret false;
        }
        or (progress.status == body.COMPLETE) {
            state.body_done = true;
            ret true;
        }
        or {
            state.body_failed = true;
            ret true;
        }
    }
    state.body_failed = true;
    ret true;
}

fun monotonic_ns() i64 {
    ret time.time_unix_nsec(monotonic_now());
}

fun hex_digit(value: u8) char {
    if (value < 10) { ret ('0'::u8 + value)::char; }
    ret ('a'::u8 + value - 10)::char;
}

# laurel's request identifier is hedge's trace id, so one request is one
# identifier in both systems rather than two unrelated ones
fun render_request_id(source: *trace.Context, output: *char) bool {
    if (source == nil || output == nil) { ret false; }
    var i: usize = 0;
    var difference: u8 = 0;
    for (i < 16) {
        val byte: u8 = source.trace_id[i];
        difference = difference | byte;
        output[i * 2] = hex_digit(byte >> 4);
        output[i * 2 + 1] = hex_digit(byte & 0x0f);
        i = i + 1;
    }
    ret difference != 0;
}

# the terminal handler laurel executes at the end of the middleware chain.
# dispatch already ran, so this only decides what the result of dispatch means.
fun terminal_call(ctx: ptr, request_context: *context.Context)
    res[u8, error.AppError] {
    val state: *RequestState = ctx::*RequestState;
    if (state == nil || state.routes == nil || state.fallback.call == nil) {
        ret res[u8, error.AppError].err{error.make(error.INTERNAL, 500,
            "internal server error", "the terminal handler is invalid", false)};
    }
    if (state.matched.status == router.DISPATCH_MATCH) {
        ret router.invoke(state.routes, ?state.matched, request_context);
    }
    if (state.matched.status == router.DISPATCH_NOT_FOUND) {
        ret state.fallback.call(state.fallback.ctx, request_context);
    }
    ret res[u8, error.AppError].err{state.matched.app_error};
}

# release_context is what closes laurel's admission slot and emits the terminal
# request event, so it must run even when the exchange fails partway through
fun finalize_request(owner: ptr, active: *call.Call) bool {
    if (owner == nil || active == nil || active.exchange == nil) { ret false; }
    val state: *RequestState = owner::*RequestState;
    if (!state.bound) {
        state.owner = nil;
        ret true;
    }
    val active_scope: *cancel.Scope = call.scope(active);
    if (state.application == nil || active_scope == nil) { ret false; }
    val released: bool = app.release_context(state.application, ?state.context,
        app.Termination{outcome: state.outcome,
            reason: cancel.reason(active_scope),
            status: active.exchange.completion.status,
            transfer: active.exchange.completion, now_ns: monotonic_ns()});
    state.bound = false;
    state.owner = nil;
    ret released;
}

# one slot per concurrent request: the same call re-entering after reporting
# itself pending finds the slot it already holds
fun acquire(adapter: *Adapter, active: *call.Call) *RequestState {
    var i: usize = 0;
    for (i < adapter.capacity) {
        if (adapter.slots[i].owner == active) { ret ?adapter.slots[i]; }
        i = i + 1;
    }
    i = 0;
    for (i < adapter.capacity) {
        val slot: *RequestState = ?adapter.slots[i];
        if (slot.owner == nil) {
            slot.owner = active;
            slot.application = adapter.application;
            slot.routes = adapter.routes;
            slot.fallback = adapter.fallback;
            slot.phase = PHASE_BUFFERING;
            slot.body = nil;
            slot.body_len = 0;
            slot.body_done = false;
            slot.body_failed = false;
            slot.too_large = false;
            slot.pending = false;
            slot.pending_tok = 0;
            slot.offset = 0;
            slot.bound = false;
            ret slot;
        }
        i = i + 1;
    }
    ret nil;
}

# a refusal the framework never saw, answered by the host itself
fun refuse(active: *call.Call, code: status.Status) exchange.ServiceStatus {
    val response: *message.Response = call.response(active);
    if (response == nil || message.set_status(response, code)
        != message.RESPONSE_OK) { ret exchange.SERVICE_FAILED; }
    ret service.commit_bodyless(active, call.BODY_DRAIN);
}

fun status_for(outcome: middleware.Outcome) exchange.ServiceStatus {
    if (outcome.status == middleware.EXECUTION_RESPOND ||
        outcome.status == middleware.EXECUTION_ERROR_RENDERED) {
        ret exchange.SERVICE_COMPLETE;
    }
    ret exchange.SERVICE_FAILED;
}

pub fun serve(owner: ptr, active: *call.Call) exchange.ServiceStatus {
    if (owner == nil || active == nil || !call.entered(active)) {
    }
    val adapter: *Adapter = owner::*Adapter;
    if (!adapter.bound || adapter.application == nil || adapter.routes == nil) {
    }
    val bound: *exchange.Exchange = active.exchange;
    val arena: *A.Allocator = call.allocator_of(active);
    if (bound == nil || arena == nil || call.cancelled(active)) {
    }
    val state: *RequestState = acquire(adapter, active);
    if (state == nil) { ret exchange.SERVICE_FAILED; }
    state.arena = arena;
    if (active.finalizer.finish != finalize_request) {
        if (!render_request_id(active.telemetry, ?state.identifier[0])) {
            state.owner = nil;
            ret exchange.SERVICE_FAILED;
        }
        if (!call.attach_finalizer(active, call.Finalizer{ctx: state::ptr,
            finish: finalize_request})) {
            state.owner = nil;
            ret exchange.SERVICE_FAILED;
        }
    }

    if (state.phase == PHASE_BUFFERING) {
        val source: *message.Request = call.request(active);
        if (source == nil) { ret exchange.SERVICE_FAILED; }
        if (source.body != nil && !state.body_done && !state.body_failed) {
            if (!accumulate(state, source.body)) {
                ret exchange.SERVICE_PENDING;
            }
        }
        state.phase = PHASE_READY;
    }

    # dispatch before admission: the decoded parameters are part of what the
    # request context borrows, and laurel checks that they are the exact ones
    # dispatch produced before it will invoke the matched handler
    val request: *message.Request = call.request(active);
    if (request == nil) { ret exchange.SERVICE_FAILED; }
    if (state.too_large) {
        ret refuse(active, status.CONTENT_TOO_LARGE);
    }
    if (state.body_failed) {
        ret refuse(active, status.BAD_REQUEST);
    }
    # laurel reads the buffered copy, so no handler can ever suspend on the wire
    state.trailers = field.init(nil, 0, field.limits(0, 0, 0, 0));
    state.reader = body.init_reader(state::ptr, buffered_read, buffered_finish,
        buffered_complete, buffered_release, body.OWNER_APPLICATION,
        bound.generation, true, state.body_len::u64,
        bound.limits.request_body, ?state.trailers, bound.scope);
    if (!state.reader.valid) { ret exchange.SERVICE_FAILED; }
    request.body = ?state.reader;
    state.matched = router.dispatch(adapter.routes, request, arena);
    var params: context.Params = context.Params{items: nil, len: 0,
        generation: bound.generation};
    var route_name: view.View = service.text_view(active.route.name);
    if (state.matched.status == router.DISPATCH_MATCH) {
        params = state.matched.params;
        val name: str = adapter.routes.routes[state.matched.route].name;
        if (name != nil) { route_name = view.view(name::*char, name_len(name)); }
    }

    if (!app.bind_context(adapter.application, ?state.context, ?state.recorder,
        app.Admission{exchange: bound, params: params, allocator: arena,
            request_id: view.View{data: ?state.identifier[0],
                len: REQUEST_ID_BYTES},
            route_name: route_name, started_ns: monotonic_ns()})) {
        ret exchange.SERVICE_FAILED;
    }
    state.bound = true;

    state.outcome = app.execute(adapter.application,
        handler.Handler{ctx: state::ptr, call: terminal_call}, ?state.context);
    val served: exchange.ServiceStatus = status_for(state.outcome);
    if (served != exchange.SERVICE_COMPLETE) { ret served; }
    if (bound.response.committed) {
        if (!call.resolve_body(active, call.BODY_DRAIN)) {
            ret exchange.SERVICE_FAILED;
        }
    } or (bound.response.body_kind == message.BODY_NONE) {
        if (service.commit_bodyless(active, call.BODY_DRAIN)
            != exchange.SERVICE_COMPLETE) { ret exchange.SERVICE_FAILED; }
    } or (!call.resolve_body(active, call.BODY_DRAIN)
        || service.commit(active) != message.RESPONSE_OK) {
        ret exchange.SERVICE_FAILED;
    }
    ret served;
}

fun name_len(value: str) usize {
    var length: usize = 0;
    for (value[length] != 0) { length = length + 1; }
    ret length;
}

pub fun make(adapter: *Adapter, application: *app.App, routes: *router.Router,
    fallback: handler.Handler, slots: *RequestState, capacity: usize) bool {
    if (adapter == nil || application == nil || routes == nil || adapter.bound
        || !application.valid || !routes.initialized || slots == nil
        || capacity == 0 || fallback.call::usize == 0) { ret false; }
    adapter.application = application;
    adapter.routes = routes;
    adapter.fallback = fallback;
    adapter.slots = slots;
    adapter.capacity = capacity;
    var i: usize = 0;
    for (i < capacity) {
        slots[i].owner = nil;
        slots[i].bound = false;
        i = i + 1;
    }
    adapter.bound = true;
    ret true;
}

pub fun bound_handler(adapter: *Adapter) service.Handler {
    if (adapter == nil || !adapter.bound) { ret service.no_handler(); }
    ret service.Handler{ctx: adapter::ptr, serve: serve};
}
