# typed application routes over mach-http's compiled matcher

use http.core.field;
use http.core.message;
use http.core.method;
use http.core.target;
use http_router: http.router.router;
use laurel.context;
use laurel.error;
use laurel.handler;
use A: std.allocator;
use std.allocator.fixed;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.view;

fun fixed_ok(outcome: err[A.Error]) bool {
    ret sel outcome.ok;
}

fun is_err_u8_error_apperror(outcome: res[u8, error.AppError]) bool {
    ret sel outcome.err;
}

fun is_ok_u8_error_apperror(outcome: res[u8, error.AppError]) bool {
    ret sel outcome.ok;
}

pub def HostKind: u8;
pub val HOST_ANY:    HostKind = 1;
pub val HOST_EXACT:  HostKind = 2;
pub val HOST_SUFFIX: HostKind = 3;

pub def PathKind: u8;
pub val PATH_PATTERN:  PathKind = 1;
pub val PATH_NON_PATH: PathKind = 2;

pub val VALUE_TEXT:   context.ParamKind = context.PARAM_TEXT;
pub val VALUE_U64:    context.ParamKind = context.PARAM_U64;
pub val VALUE_I64:    context.ParamKind = context.PARAM_I64;
pub val VALUE_BOOL:   context.ParamKind = context.PARAM_BOOL;
pub val VALUE_UUID:   context.ParamKind = context.PARAM_UUID;
pub val VALUE_CUSTOM: context.ParamKind = context.PARAM_CUSTOM;

pub def CompileStatus: u8;
pub val COMPILE_OK:        CompileStatus = 1;
pub val COMPILE_INVALID:   CompileStatus = 2;
pub val COMPILE_CAPACITY:  CompileStatus = 3;
pub val COMPILE_METHOD:    CompileStatus = 4;
pub val COMPILE_HOST:      CompileStatus = 5;
pub val COMPILE_PATH:      CompileStatus = 6;
pub val COMPILE_PARAMETER: CompileStatus = 7;
pub val COMPILE_CONFLICT:  CompileStatus = 8;
pub val COMPILE_HANDLER:   CompileStatus = 9;

pub def DispatchStatus: u8;
pub val DISPATCH_MATCH:           DispatchStatus = 1;
pub val DISPATCH_NOT_FOUND:       DispatchStatus = 2;
pub val DISPATCH_BAD_REQUEST:     DispatchStatus = 3;
pub val DISPATCH_REJECTED:        DispatchStatus = 4;
pub val DISPATCH_PARAMETER_ERROR: DispatchStatus = 5;

pub rec Method {
    any:   bool;
    value: method.Method;
}

pub rec Host {
    kind:    HostKind;
    pattern: view.View;
}

pub rec Path {
    kind:    PathKind;
    pattern: view.View;
}

pub rec Value {
    kind:           context.ParamKind;
    unsigned_value: u64;
    signed_value:   i64;
    boolean_value:  bool;
    uuid_value:     [16]u8;
    custom_value:   ptr;
}

pub def DecodeFun: fun(ptr, *A.Allocator, view.View, *Value)
    res[u8, error.AppError];

pub rec Decoder {
    ctx:  ptr;
    kind: context.ParamKind;
    call: DecodeFun;
}

pub rec Parameter {
    name:     view.View;
    wildcard: bool;
    decoder:  Decoder;
}

pub rec Route {
    method:        Method;
    host:          Host;
    path:          Path;
    name:          str;
    parameters:    *Parameter;
    parameter_len: usize;
    handler:       handler.Handler;
}

pub rec Limits {
    matcher:                     http_router.Limits;
    max_decoded_parameter_bytes: usize;
}

pub rec Storage {
    specifications:     *http_router.Route;
    specification_cap:  usize;
    compiled_routes:    *http_router.CompiledRoute;
    compiled_route_cap: usize;
    segments:           *http_router.Segment;
    segment_cap:        usize;
}

pub rec Router {
    inner:       http_router.Router;
    routes:      *Route;
    route_len:   usize;
    configured:  Limits;
    generation:  u64;
    initialized: bool;
}

pub rec Compile {
    status:         CompileStatus;
    route:          usize;
    conflict_route: usize;
    pattern_offset: usize;
    needed:         usize;
    capacity:       usize;
    app_error:      error.AppError;
}

pub rec Dispatch {
    status:             DispatchStatus;
    route:              usize;
    router_generation:  u64;
    request_generation: u64;
    handler:            handler.Handler;
    params:             context.Params;
    app_error:          error.AppError;
}

pub fun limits_default() Limits {
    ret Limits{matcher: http_router.limits_default(),
        max_decoded_parameter_bytes: 8192};
}

pub fun any_method() Method {
    var empty: method.Method;
    ret Method{any: true, value: empty};
}

pub fun exact_method(value: method.Method) Method {
    ret Method{any: false, value: value};
}

pub fun any_host() Host {
    ret Host{kind: HOST_ANY, pattern: view.view(nil, 0)};
}

pub fun exact_host(authority: view.View) Host {
    ret Host{kind: HOST_EXACT, pattern: authority};
}

pub fun suffix_host(pattern: view.View) Host {
    ret Host{kind: HOST_SUFFIX, pattern: pattern};
}

pub fun path(pattern: view.View) Path {
    ret Path{kind: PATH_PATTERN, pattern: pattern};
}

pub fun non_path() Path {
    ret Path{kind: PATH_NON_PATH, pattern: view.view("*", 1)};
}

fun no_error() error.AppError {
    var empty: error.AppError;
    ret empty;
}

fun route_error(kind: error.Kind, status: u16, public_msg: str,
    detail: str, retryable: bool) error.AppError {
    ret error.make(kind, status, public_msg, detail, retryable);
}

fun bad_parameter() error.AppError {
    ret route_error(error.BAD_REQUEST, 400, "invalid route parameter",
        "parameter decoder rejected value", false);
}

fun allocation_error() error.AppError {
    ret route_error(error.UNAVAILABLE, 503, "request unavailable",
        "request scope allocation failed", true);
}

fun compile_result(status: CompileStatus, route: usize, conflict_route: usize,
    pattern_offset: usize, needed: usize, capacity: usize,
    app_error: error.AppError) Compile {
    ret Compile{status: status, route: route, conflict_route: conflict_route,
        pattern_offset: pattern_offset, needed: needed, capacity: capacity,
        app_error:      app_error};
}

fun dispatch_result(status: DispatchStatus, app_error: error.AppError) Dispatch {
    ret Dispatch{status: status, route: http_router.NO_INDEX,
        router_generation: 0, request_generation: 0,
        handler:           handler.Handler{ctx: nil, call: nil},
        params:            context.Params{items: nil, len: 0, generation: 0},
        app_error:         app_error};
}

fun same(a: view.View, b: view.View) bool {
    if (a.len != b.len || (a.len != 0 && (a.data == nil || b.data == nil))) { ret false; }
    var i: usize = 0;
    for (i < a.len) {
        if (a.data[i] != b.data[i]) { ret false; }
        i = i + 1;
    }
    ret true;
}

fun typed_method_valid(route_method: Method, max_bytes: usize) bool {
    if (route_method.any) {
        ret route_method.value.kind == 0 && route_method.value.token.len == 0;
    }
    ret method.valid(route_method.value, max_bytes);
}

fun typed_host_valid(host: Host) bool {
    if (host.kind == HOST_ANY) { ret host.pattern.len == 0; }
    ret (host.kind == HOST_EXACT || host.kind == HOST_SUFFIX)
        && host.pattern.len != 0 && host.pattern.data != nil;
}

fun typed_path_valid(route_path: Path) bool {
    if (route_path.kind == PATH_PATTERN) {
        ret route_path.pattern.len != 0 && route_path.pattern.data != nil
            && !same(route_path.pattern, view.view("*", 1));
    }
    ret route_path.kind == PATH_NON_PATH
        && same(route_path.pattern, view.view("*", 1));
}

fun typed_parameters_valid(route: *Route) bool {
    if (route.parameter_len != 0 && route.parameters == nil) { ret false; }
    var i: usize = 0;
    for (i < route.parameter_len) {
        val parameter: *Parameter = ?route.parameters[i];
        if (parameter.decoder.call == nil || parameter.decoder.kind < VALUE_TEXT
            || parameter.decoder.kind > VALUE_CUSTOM) { ret false; }
        i = i + 1;
    }
    ret true;
}

fun bridge_handler(ctx: ptr, request: *message.Request,
    response: *message.Response, params: *http_router.Params) res[u8, str] {
    ret res[u8, str].ok{http_router.HANDLER_NEXT};
}

fun typed_host_matches(route: *Route, compiled: *http_router.CompiledRoute) bool {
    if (route.host.kind == HOST_ANY)    { ret compiled.host.kind == http_router.HOST_ANY; }
    if (route.host.kind == HOST_EXACT)  { ret compiled.host.kind == http_router.HOST_EXACT; }
    if (route.host.kind == HOST_SUFFIX) { ret compiled.host.kind == http_router.HOST_SUFFIX; }
    ret false;
}

fun typed_path_matches(route: *Route, compiled: *http_router.CompiledRoute) bool {
    if (route.path.kind == PATH_PATTERN)  { ret !compiled.non_path; }
    if (route.path.kind == PATH_NON_PATH) { ret compiled.non_path; }
    ret false;
}

fun typed_method_matches(route: *Route, compiled: *http_router.CompiledRoute,
    max_bytes: usize) bool {
    if (route.method.any) { ret compiled.any_method; }
    ret !compiled.any_method && method.valid(route.method.value, max_bytes);
}

fun parameters_match(route: *Route, compiled: *http_router.CompiledRoute,
    segments: *http_router.Segment) bool {
    if (route.parameter_len != compiled.parameter_count
        || (route.parameter_len != 0 && route.parameters == nil)) { ret false; }
    var parameter_index: usize = 0;
    var segment_index:   usize = 0;
    for (segment_index < compiled.segment_count) {
        val segment: *http_router.Segment =
            ?segments[compiled.segment_start + segment_index];
        if (segment.kind == http_router.SEGMENT_PARAMETER
            || segment.kind == http_router.SEGMENT_CATCH_ALL) {
            if (parameter_index >= route.parameter_len) { ret false; }
            val parameter: *Parameter = ?route.parameters[parameter_index];
            if (parameter.decoder.call == nil || parameter.decoder.kind < VALUE_TEXT
                || parameter.decoder.kind > VALUE_CUSTOM
                || !same(parameter.name, segment.value)
                || parameter.wildcard != (segment.kind == http_router.SEGMENT_CATCH_ALL)) {
                ret false;
            }
            parameter_index = parameter_index + 1;
        }
        segment_index = segment_index + 1;
    }
    ret parameter_index == route.parameter_len;
}

fun map_compile(core: http_router.Compile) Compile {
    if (core.status == http_router.COMPILE_OK) {
        ret compile_result(COMPILE_OK, core.route, core.conflict_route,
            core.pattern_offset, core.needed, core.capacity, no_error());
    }
    if (core.status == http_router.COMPILE_ROUTE_CAPACITY
        || core.status == http_router.COMPILE_SEGMENT_CAPACITY) {
        ret compile_result(COMPILE_CAPACITY, core.route, core.conflict_route,
            core.pattern_offset, core.needed, core.capacity,
            route_error(error.INTERNAL, 500, "route configuration failed",
            "compiled route storage is too small", false));
    }
    if (core.status == http_router.COMPILE_METHOD) {
        ret compile_result(COMPILE_METHOD, core.route, core.conflict_route,
            core.pattern_offset, core.needed, core.capacity,
            route_error(error.BAD_REQUEST, 400, "invalid route method",
            "route method is not a valid HTTP token", false));
    }
    if (core.status == http_router.COMPILE_HOST) {
        ret compile_result(COMPILE_HOST, core.route, core.conflict_route,
            core.pattern_offset, core.needed, core.capacity,
            route_error(error.BAD_REQUEST, 400, "invalid route host",
            "route host pattern is malformed", false));
    }
    if (core.status == http_router.COMPILE_PATTERN
        || core.status == http_router.COMPILE_UNREACHABLE) {
        ret compile_result(COMPILE_PATH, core.route, core.conflict_route,
            core.pattern_offset, core.needed, core.capacity,
            route_error(error.BAD_REQUEST, 400, "invalid route path",
            "route path pattern is malformed or unreachable", false));
    }
    if (core.status == http_router.COMPILE_PARAMETER) {
        ret compile_result(COMPILE_PARAMETER, core.route, core.conflict_route,
            core.pattern_offset, core.needed, core.capacity,
            route_error(error.BAD_REQUEST, 400, "invalid route parameter",
            "route parameter declaration is malformed", false));
    }
    if (core.status == http_router.COMPILE_CONFLICT) {
        ret compile_result(COMPILE_CONFLICT, core.route, core.conflict_route,
            core.pattern_offset, core.needed, core.capacity,
            route_error(error.CONFLICT, 409, "route conflict",
            "route is indistinguishable from an earlier route", false));
    }
    if (core.status == http_router.COMPILE_HANDLER) {
        ret compile_result(COMPILE_HANDLER, core.route, core.conflict_route,
            core.pattern_offset, core.needed, core.capacity,
            route_error(error.INTERNAL, 500, "route configuration failed",
            "route handler is missing", false));
    }
    ret compile_result(COMPILE_INVALID, core.route, core.conflict_route,
        core.pattern_offset, core.needed, core.capacity,
        route_error(error.INTERNAL, 500, "route configuration failed",
        "route compiler input is invalid", false));
}

pub fun compile(router: *Router, routes: *Route, route_len: usize,
    storage: Storage, configured: Limits) Compile {
    if (router == nil || router.generation != 0 || router.initialized
        || configured.max_decoded_parameter_bytes == 0
        || (route_len != 0 && routes == nil)
        || storage.specification_cap < route_len
        || storage.compiled_route_cap < route_len
        || (storage.specification_cap != 0 && storage.specifications == nil)
        || (storage.compiled_route_cap != 0 && storage.compiled_routes == nil)
        || (storage.segment_cap != 0 && storage.segments == nil)) {
        ret compile_result(COMPILE_INVALID, http_router.NO_INDEX,
            http_router.NO_INDEX, 0, 0, 0,
            route_error(error.INTERNAL, 500, "route configuration failed",
            "route compiler input is invalid", false));
    }
    var i: usize = 0;
    for (i < route_len) {
        val route: *Route = ?routes[i];
        if (route.handler.call == nil) {
            ret compile_result(COMPILE_HANDLER, i, http_router.NO_INDEX, 0, 0, 0,
                route_error(error.INTERNAL, 500, "route configuration failed",
                "route handler is missing", false));
        }
        if (!typed_method_valid(route.method,
            configured.matcher.max_method_bytes)) {
            ret compile_result(COMPILE_METHOD, i, http_router.NO_INDEX, 0, 0, 0,
                route_error(error.BAD_REQUEST, 400, "invalid route method",
                "typed method has contradictory or invalid state", false));
        }
        if (!typed_host_valid(route.host)) {
            ret compile_result(COMPILE_HOST, i, http_router.NO_INDEX, 0, 0, 0,
                route_error(error.BAD_REQUEST, 400, "invalid route host",
                "typed host has contradictory or invalid state", false));
        }
        if (!typed_path_valid(route.path)) {
            ret compile_result(COMPILE_PATH, i, http_router.NO_INDEX, 0, 0, 0,
                route_error(error.BAD_REQUEST, 400, "invalid route path",
                "typed path has contradictory or invalid state", false));
        }
        if (!typed_parameters_valid(route)) {
            ret compile_result(COMPILE_PARAMETER, i, http_router.NO_INDEX, 0, 0, 0,
                route_error(error.BAD_REQUEST, 400, "invalid route parameter",
                "typed parameter declaration is invalid", false));
        }
        var route_method: view.View = view.view("*", 1);
        if (!route.method.any) { route_method = route.method.value.token; }
        var route_host: view.View = route.host.pattern;
        if (route.host.kind == HOST_ANY) { route_host = view.view(nil, 0); }
        var route_path: view.View = route.path.pattern;
        if (route.path.kind == PATH_NON_PATH) { route_path = view.view("*", 1); }
        storage.specifications[i] = http_router.Route{
            method:      route_method,
            host:        route_host,
            pattern:     route_path,
            handler_ctx: nil,
            handler:     bridge_handler,
        };
        i = i + 1;
    }
    val core: http_router.Compile = http_router.compile(?router.inner,
        storage.specifications, route_len, storage.compiled_routes,
        storage.compiled_route_cap, storage.segments, storage.segment_cap,
        configured.matcher);
    val mapped: Compile = map_compile(core);
    if (mapped.status != COMPILE_OK) { ret mapped; }
    i = 0;
    for (i < route_len) {
        val route:    *Route                     = ?routes[i];
        val compiled: *http_router.CompiledRoute = ?storage.compiled_routes[i];
        if (!typed_method_matches(route, compiled,
            configured.matcher.max_method_bytes)) {
            router.inner.initialized = false;
            ret compile_result(COMPILE_METHOD, i, http_router.NO_INDEX, 0, 0, 0,
                route_error(error.BAD_REQUEST, 400, "invalid route method",
                "typed method does not match its token", false));
        }
        if (!typed_host_matches(route, compiled)) {
            router.inner.initialized = false;
            ret compile_result(COMPILE_HOST, i, http_router.NO_INDEX, 0, 0, 0,
                route_error(error.BAD_REQUEST, 400, "invalid route host",
                "typed host kind does not match its pattern", false));
        }
        if (!typed_path_matches(route, compiled)) {
            router.inner.initialized = false;
            ret compile_result(COMPILE_PATH, i, http_router.NO_INDEX, 0, 0, 0,
                route_error(error.BAD_REQUEST, 400, "invalid route path",
                "typed path kind does not match its pattern", false));
        }
        if (!parameters_match(route, compiled, storage.segments)) {
            router.inner.initialized = false;
            ret compile_result(COMPILE_PARAMETER, i, http_router.NO_INDEX, 0, 0, 0,
                route_error(error.BAD_REQUEST, 400, "invalid route parameter",
                "typed parameter declarations do not match the path", false));
        }
        i = i + 1;
    }
    router.routes      = routes;
    router.route_len   = route_len;
    router.configured  = configured;
    router.generation  = router.inner.generation;
    router.initialized = true;
    ret mapped;
}

fun map_dispatch(status: http_router.DispatchStatus) Dispatch {
    if (status == http_router.DISPATCH_NOT_FOUND) {
        ret dispatch_result(DISPATCH_NOT_FOUND,
            route_error(error.NOT_FOUND, 404, "not found", "no route matched", false));
    }
    if (status == http_router.DISPATCH_METHOD || status == http_router.DISPATCH_HOST
        || status == http_router.DISPATCH_PATH || status == http_router.DISPATCH_INVALID) {
        ret dispatch_result(DISPATCH_BAD_REQUEST,
            route_error(error.BAD_REQUEST, 400, "bad request",
            "request target cannot be routed", false));
    }
    if (status == http_router.DISPATCH_TARGET) {
        ret dispatch_result(DISPATCH_BAD_REQUEST,
            route_error(error.BAD_REQUEST, 400, "malformed query",
            "request target query is not well formed", false));
    }
    ret dispatch_result(DISPATCH_REJECTED,
        route_error(error.INTERNAL, 500, "route dispatch failed",
        "route matcher rejected bounded dispatch state", false));
}

pub fun dispatch(router: *Router, request: *message.Request,
    request_allocator: *A.Allocator) Dispatch {
    if (router == nil || !router.initialized || request == nil
        || request_allocator == nil || request_allocator.fn_allocate == nil) {
        ret dispatch_result(DISPATCH_REJECTED,
            route_error(error.INTERNAL, 500, "route dispatch failed",
            "route dispatch input is invalid", false));
    }
    var core: http_router.Dispatch = http_router.dispatch(?router.inner,
        request, nil, 0);
    var captures: *http_router.Capture = nil;
    if (core.status == http_router.DISPATCH_CAPTURE_CAPACITY) {
        val capture_allocation: res[*http_router.Capture, A.Error] =
            A.allocate[http_router.Capture](request_allocator,
            router.configured.matcher.max_parameters_per_route);
        if (sel capture_allocation.err) {
            ret dispatch_result(DISPATCH_REJECTED, allocation_error());
        }
        captures = capture_allocation.ok;
        core     = http_router.dispatch(?router.inner, request, captures,
            router.configured.matcher.max_parameters_per_route);
    }
    if (core.status != http_router.DISPATCH_MATCH) { ret map_dispatch(core.status); }
    if (core.source_index >= router.route_len) {
        ret dispatch_result(DISPATCH_REJECTED,
            route_error(error.INTERNAL, 500, "route dispatch failed",
            "matcher returned an unknown route", false));
    }
    val route: *Route = ?router.routes[core.source_index];
    if (core.params.len != route.parameter_len) {
        ret dispatch_result(DISPATCH_REJECTED,
            route_error(error.INTERNAL, 500, "route dispatch failed",
            "matcher returned an invalid parameter set", false));
    }
    var total_bytes: usize = 0;
    var i:           usize = 0;
    for (i < core.params.len) {
        if (core.params.items[i].decoded_length
            > router.configured.max_decoded_parameter_bytes - total_bytes) {
            ret dispatch_result(DISPATCH_REJECTED,
                route_error(error.TOO_LARGE, 413, "route parameters too large",
                "decoded route parameters exceed the request limit", false));
        }
        total_bytes = total_bytes + core.params.items[i].decoded_length;
        i           = i + 1;
    }
    var params: *context.Param = nil;
    if (core.params.len != 0) {
        val param_allocation: res[*context.Param, A.Error] =
            A.allocate[context.Param](request_allocator, core.params.len);
        if (sel param_allocation.err) {
            ret dispatch_result(DISPATCH_REJECTED, allocation_error());
        }
        params = param_allocation.ok;
    }
    var decoded_bytes: *u8 = nil;
    if (total_bytes != 0) {
        val byte_allocation: res[*u8, A.Error] =
            A.allocate[u8](request_allocator, total_bytes);
        if (sel byte_allocation.err) {
            ret dispatch_result(DISPATCH_REJECTED, allocation_error());
        }
        decoded_bytes = byte_allocation.ok;
    }
    var byte_offset: usize = 0;
    i = 0;
    for (i < core.params.len) {
        val capture:      *http_router.Capture = ?core.params.items[i];
        var decoded_data: *u8                  = nil;
        if (capture.decoded_length != 0) { decoded_data = ?decoded_bytes[byte_offset]; }
        if (!http_router.decode_capture(capture, decoded_data, capture.decoded_length)) {
            ret dispatch_result(DISPATCH_PARAMETER_ERROR, bad_parameter());
        }
        val decoded_view: view.View               = view.view(decoded_data, capture.decoded_length);
        val declaration:  *Parameter              = ?route.parameters[i];
        var value:        Value;
        val decoded:      res[u8, error.AppError] = declaration.decoder.call(
            declaration.decoder.ctx, request_allocator, decoded_view, ?value);
        if (sel decoded.err) {
            ret dispatch_result(DISPATCH_PARAMETER_ERROR,
                decoded.err);
        }
        if (value.kind != declaration.decoder.kind || value.kind < VALUE_TEXT
            || value.kind > VALUE_CUSTOM) {
            ret dispatch_result(DISPATCH_REJECTED,
                route_error(error.INTERNAL, 500, "route dispatch failed",
                "parameter decoder violated its value contract", false));
        }
        params[i] = context.Param{
            name:           declaration.name,
            value:          decoded_view,
            kind:           value.kind,
            unsigned_value: value.unsigned_value,
            signed_value:   value.signed_value,
            boolean_value:  value.boolean_value,
            uuid_value:     value.uuid_value,
            custom_value:   value.custom_value,
        };
        byte_offset = byte_offset + capture.decoded_length;
        i           = i + 1;
    }
    ret Dispatch{status: DISPATCH_MATCH, route: core.source_index,
        router_generation:  router.generation,
        request_generation: request.generation,
        handler:            route.handler,
        params:             context.Params{items: params, len: core.params.len,
        generation:         request.generation},
        app_error:          no_error()};
}

pub fun invoke(router: *Router, matched: *Dispatch,
    request_context: *context.Context, state: *ptr) handler.Result {
    if (router == nil || !router.initialized || matched == nil
        || matched.status != DISPATCH_MATCH || matched.route >= router.route_len
        || matched.router_generation != router.generation
        || matched.request_generation == 0 || matched.handler.call == nil
        || request_context == nil || !context.active(request_context)
        || request_context.generation != matched.request_generation
        || request_context.params.items != matched.params.items
        || request_context.params.len != matched.params.len
        || request_context.params.generation != matched.params.generation
        || router.routes[matched.route].handler.call != matched.handler.call
        || router.routes[matched.route].handler.ctx != matched.handler.ctx) {
        ret handler.fail(route_error(error.INTERNAL, 500,
            "route dispatch failed", "route dispatch is stale", false));
    }
    ret matched.handler.call(matched.handler.ctx, request_context, state);
}

# every host ends its middleware chain in the dispatched route, so the mapping
# from a dispatch status to what runs belongs here rather than in each host. a
# host keeps one Terminal per request, arms it with the dispatch it took, and
# passes terminal_handler to app.execute.
pub rec Terminal {
    routes:   *Router;
    fallback: handler.Handler;
    matched:  Dispatch;
}

pub fun terminal(routes: *Router, fallback: handler.Handler,
    matched: Dispatch) Terminal {
    ret Terminal{routes: routes, fallback: fallback, matched: matched};
}

fun terminal_call(ctx: ptr, request_context: *context.Context,
    state: *ptr) handler.Result {
    val value: *Terminal = ctx::*Terminal;
    if (value == nil || value.routes == nil || value.fallback.call == nil) {
        ret handler.fail(route_error(error.INTERNAL, 500,
            "internal server error", "route terminal is invalid", false));
    }
    if (value.matched.status == DISPATCH_MATCH) {
        ret invoke(value.routes, ?value.matched, request_context, state);
    }
    if (value.matched.status == DISPATCH_NOT_FOUND) {
        ret value.fallback.call(value.fallback.ctx, request_context, state);
    }
    # a terminal reached before it was armed carries no error to report, so it
    # states that rather than failing the request with an empty one
    if (value.matched.status != DISPATCH_BAD_REQUEST
        && value.matched.status != DISPATCH_REJECTED
        && value.matched.status != DISPATCH_PARAMETER_ERROR) {
        ret handler.fail(route_error(error.INTERNAL, 500,
            "internal server error", "route terminal was not armed", false));
    }
    ret handler.fail(value.matched.app_error);
}

# the route that suspended is the route that is resumed, so the terminal sends
# the settlement to whichever handler its arming chose
fun terminal_resume(ctx: ptr, request_context: *context.Context, state: ptr,
    settlement: handler.Settlement, token: u64) handler.Result {
    val value: *Terminal = ctx::*Terminal;
    if (value == nil || value.routes == nil) {
        ret handler.fail(route_error(error.INTERNAL, 500,
            "internal server error", "route terminal is invalid", false));
    }
    var suspended: handler.Handler = value.fallback;
    if (value.matched.status == DISPATCH_MATCH) { suspended = value.matched.handler; }
    or {
        if (value.matched.status != DISPATCH_NOT_FOUND) {
            ret handler.fail(route_error(error.INTERNAL, 500,
                "internal server error", "route terminal was not armed", false));
        }
    }
    if (suspended.resume == nil) {
        ret handler.fail(route_error(error.INTERNAL, 500,
            "internal server error", "a route handler suspended with no resume",
            false));
    }
    ret suspended.resume(suspended.ctx, request_context, state, settlement,
        token);
}

pub fun terminal_handler(value: *Terminal) handler.Handler {
    if (value == nil) {
        ret handler.Handler{ctx: nil, call: nil, resume: nil};
    }
    ret handler.Handler{ctx: value::ptr, call: terminal_call,
        resume: terminal_resume};
}

fun text_decode(ctx: ptr, allocator: *A.Allocator,
    input: view.View, output: *Value) res[u8, error.AppError] {
    if (output == nil || (input.len != 0 && input.data == nil)) {
        ret res[u8, error.AppError].err{bad_parameter()};
    }
    var value: Value;
    value.kind = VALUE_TEXT;
    @output    = value;
    ret res[u8, error.AppError].ok{1};
}

fun u64_decode(ctx: ptr, allocator: *A.Allocator,
    input: view.View, output: *Value) res[u8, error.AppError] {
    if (output == nil || input.len == 0 || input.data == nil) {
        ret res[u8, error.AppError].err{bad_parameter()};
    }
    var value: u64   = 0;
    var i:     usize = 0;
    for (i < input.len) {
        val c: u8 = input.data[i];
        if (c < '0' || c > '9') { ret res[u8, error.AppError].err{bad_parameter()}; }
        val digit: u64 = (c - '0')::u64;
        if (value > (18446744073709551615 - digit) / 10) {
            ret res[u8, error.AppError].err{bad_parameter()};
        }
        value = value * 10 + digit;
        i     = i + 1;
    }
    var decoded: Value;
    decoded.kind           = VALUE_U64;
    decoded.unsigned_value = value;
    @output                = decoded;
    ret res[u8, error.AppError].ok{1};
}

fun i64_decode(ctx: ptr, allocator: *A.Allocator,
    input: view.View, output: *Value) res[u8, error.AppError] {
    if (output == nil || input.len == 0 || input.data == nil) {
        ret res[u8, error.AppError].err{bad_parameter()};
    }
    var negative: bool  = false;
    var start:    usize = 0;
    if (input.data[0] == '-') {
        negative = true;
        start    = 1;
        if (start == input.len) { ret res[u8, error.AppError].err{bad_parameter()}; }
    }
    var magnitude: u64 = 0;
    var limit:     u64 = 9223372036854775807;
    if (negative) { limit = 9223372036854775808; }
    var i: usize = start;
    for (i < input.len) {
        val c: u8 = input.data[i];
        if (c < '0' || c > '9') { ret res[u8, error.AppError].err{bad_parameter()}; }
        val digit: u64 = (c - '0')::u64;
        if (magnitude > (limit - digit) / 10) {
            ret res[u8, error.AppError].err{bad_parameter()};
        }
        magnitude = magnitude * 10 + digit;
        i         = i + 1;
    }
    var signed_value: i64 = 0;
    if (negative) {
        if (magnitude == 9223372036854775808) {
            signed_value = -9223372036854775807 - 1;
        }
        or { signed_value = 0 - magnitude::i64; }
    }
    or { signed_value = magnitude::i64; }
    var decoded: Value;
    decoded.kind         = VALUE_I64;
    decoded.signed_value = signed_value;
    @output              = decoded;
    ret res[u8, error.AppError].ok{1};
}

fun bool_decode(ctx: ptr, allocator: *A.Allocator,
    input: view.View, output: *Value) res[u8, error.AppError] {
    if (output == nil) { ret res[u8, error.AppError].err{bad_parameter()}; }
    var value: bool = false;
    if (same(input, view.view("true", 4)))  { value = true; }
    or (same(input, view.view("false", 5))) { value = false; }
    or                                      { ret res[u8, error.AppError].err{bad_parameter()}; }
    var decoded: Value;
    decoded.kind          = VALUE_BOOL;
    decoded.boolean_value = value;
    @output               = decoded;
    ret res[u8, error.AppError].ok{1};
}

fun hex(c: u8) i16 {
    if (c >= '0' && c <= '9') { ret (c - '0')::i16; }
    if (c >= 'A' && c <= 'F') { ret (c - 'A' + 10)::i16; }
    if (c >= 'a' && c <= 'f') { ret (c - 'a' + 10)::i16; }
    ret -1;
}

fun uuid_decode(ctx: ptr, allocator: *A.Allocator,
    input: view.View, output: *Value) res[u8, error.AppError] {
    if (output == nil || input.len != 36 || input.data == nil) {
        ret res[u8, error.AppError].err{bad_parameter()};
    }
    var decoded: Value;
    decoded.kind = VALUE_UUID;
    var input_index:  usize = 0;
    var output_index: usize = 0;
    for (output_index < 16) {
        if (input_index == 8 || input_index == 13 || input_index == 18
            || input_index == 23) {
            if (input.data[input_index] != '-') {
                ret res[u8, error.AppError].err{bad_parameter()};
            }
            input_index = input_index + 1;
        }
        val high: i16 = hex(input.data[input_index]);
        val low:  i16 = hex(input.data[input_index + 1]);
        if (high < 0 || low < 0) { ret res[u8, error.AppError].err{bad_parameter()}; }
        decoded.uuid_value[output_index] = (high * 16 + low)::u8;
        input_index                      = input_index + 2;
        output_index                     = output_index + 1;
    }
    @output = decoded;
    ret res[u8, error.AppError].ok{1};
}

pub fun text_decoder() Decoder {
    ret Decoder{ctx: nil, kind: VALUE_TEXT, call: text_decode};
}

pub fun u64_decoder() Decoder {
    ret Decoder{ctx: nil, kind: VALUE_U64, call: u64_decode};
}

pub fun i64_decoder() Decoder {
    ret Decoder{ctx: nil, kind: VALUE_I64, call: i64_decode};
}

pub fun bool_decoder() Decoder {
    ret Decoder{ctx: nil, kind: VALUE_BOOL, call: bool_decode};
}

pub fun uuid_decoder() Decoder {
    ret Decoder{ctx: nil, kind: VALUE_UUID, call: uuid_decode};
}

fun test_handler(ctx: ptr, request_context: *context.Context,
    state: *ptr) handler.Result {
    ret handler.respond();
}

fun test_route(route_method: Method, route_host: Host, route_path: Path,
    parameters: *Parameter, parameter_len: usize, name: str) Route {
    ret Route{method: route_method, host: route_host, path: route_path,
        name:    name, parameters: parameters, parameter_len: parameter_len,
        handler: handler.Handler{ctx: nil, call: test_handler, resume: nil}};
}

fun test_request(request: *message.Request, request_method: method.Method,
    request_path: view.View, host_item: *field.Field, host: view.View,
    generation: u64) bool {
    if (request == nil || host_item == nil) { ret false; }
    request.method     = request_method;
    request.target     = target.origin(request_path, request_path, view.view(nil, 0));
    request.generation = generation;
    request.fields     = field.init(host_item, 1, field.limits(1, 64, 16, 48));
    if (host.len != 0 && field.append(?request.fields, field.Field{
        name:      view.view("Host", 4), value: host,
        sensitive: false
    }) != field.ADD_OK) { ret false; }
    ret true;
}

test dispatch__typed_params {
    var parameters: [2]Parameter;
    parameters[0] = Parameter{name: view.view("rest", 4), wildcard: true,
        decoder: text_decoder()};
    parameters[1] = Parameter{name: view.view("id", 2), wildcard: false,
        decoder: u64_decoder()};
    var routes: [3]Route;
    routes[0] = test_route(any_method(), any_host(), path(view.view("/*rest", 6)),
        ?parameters[0], 1, "fallback");
    routes[1] = test_route(exact_method(method.from_kind(method.GET)),
        suffix_host(view.view("*.example.com", 13)),
        path(view.view("/users/:id", 10)), ?parameters[1], 1, "user");
    routes[2] = test_route(exact_method(method.from_kind(method.GET)),
        exact_host(view.view("api.example.com", 15)),
        path(view.view("/users/me", 9)), nil, 0, "self");
    var specifications: [3]http_router.Route;
    var compiled:       [3]http_router.CompiledRoute;
    var segments:       [8]http_router.Segment;
    val storage:        Storage = Storage{specifications: ?specifications[0],
        specification_cap:  3, compiled_routes: ?compiled[0],
        compiled_route_cap: 3, segments: ?segments[0], segment_cap: 8};
    var router: Router;
    if (compile(?router, ?routes[0], 3, storage, limits_default()).status
        != COMPILE_OK || router.generation == 0 || !router.initialized) { ret 1; }
    var allocation_bytes: [16384]u8;
    var allocation_state: fixed.FixedState;
    var allocator:        A.Allocator;
    if (!fixed_ok(fixed.make(?allocator, ?allocation_state,
        ?allocation_bytes[0], 16384))) { ret 2; }
    var request:   message.Request;
    var host_item: field.Field;
    if (!test_request(?request, method.from_kind(method.GET),
        view.view("/users/42", 9), ?host_item,
        view.view("x.example.com", 13), 7)) { ret 3; }
    val user: Dispatch = dispatch(?router, ?request, ?allocator);
    if (user.status != DISPATCH_MATCH || user.route != 1 || user.params.len != 1
        || user.params.generation != 7 || user.params.items[0].kind != VALUE_U64
        || user.params.items[0].unsigned_value != 42
        || !same(user.params.items[0].name, view.view("id", 2))
        || !same(user.params.items[0].value, view.view("42", 2))) { ret 4; }
    fixed.reset(?allocation_state);
    if (!test_request(?request, method.from_kind(method.GET),
        view.view("/users/me", 9), ?host_item,
        view.view("api.example.com", 15), 8)) { ret 5; }
    val exact: Dispatch = dispatch(?router, ?request, ?allocator);
    if (exact.status != DISPATCH_MATCH || exact.route != 2
        || exact.params.len != 0 || allocation_state.offset != 0) { ret 6; }
    fixed.reset(?allocation_state);
    if (!test_request(?request, method.from_kind(method.POST),
        view.view("/other/a%20b", 12), ?host_item,
        view.view("unmatched.test", 14), 9)) { ret 7; }
    val fallback: Dispatch = dispatch(?router, ?request, ?allocator);
    if (fallback.status != DISPATCH_MATCH || fallback.route != 0
        || fallback.params.len != 1 || fallback.params.items[0].kind != VALUE_TEXT
        || !same(fallback.params.items[0].value, view.view("other/a b", 9))) { ret 8; }
    fixed.reset(?allocation_state);
    if (!test_request(?request, method.from_kind(method.GET),
        view.view("/users/nope", 11), ?host_item,
        view.view("x.example.com", 13), 10)) { ret 9; }
    val rejected: Dispatch = dispatch(?router, ?request, ?allocator);
    if (rejected.status != DISPATCH_PARAMETER_ERROR
        || rejected.app_error.kind != error.BAD_REQUEST || rejected.params.len != 0) { ret 10; }
    fixed.reset(?allocation_state);
    if (!test_request(?request, method.from_kind(method.GET),
        view.view("/users/%2f", 10), ?host_item,
        view.view("x.example.com", 13), 11)) { ret 11; }
    val malformed: Dispatch = dispatch(?router, ?request, ?allocator);
    if (malformed.status != DISPATCH_BAD_REQUEST
        || malformed.app_error.kind != error.BAD_REQUEST) { ret 12; }
    var small_bytes:     [1]u8;
    var small_state:     fixed.FixedState;
    var small_allocator: A.Allocator;
    if (!fixed_ok(fixed.make(?small_allocator, ?small_state,
        ?small_bytes[0], 1)) || !test_request(?request,
        method.from_kind(method.GET), view.view("/users/42", 9), ?host_item,
        view.view("x.example.com", 13), 12)) { ret 13; }
    val exhausted: Dispatch = dispatch(?router, ?request, ?small_allocator);
    if (exhausted.status != DISPATCH_REJECTED
        || exhausted.app_error.kind != error.UNAVAILABLE
        || !exhausted.app_error.retryable) { ret 14; }
    router.configured.max_decoded_parameter_bytes = 4;
    fixed.reset(?allocation_state);
    if (!test_request(?request, method.from_kind(method.POST),
        view.view("/other", 6), ?host_item,
        view.view("unmatched.test", 14), 13)) { ret 15; }
    val oversized: Dispatch = dispatch(?router, ?request, ?allocator);
    if (oversized.status != DISPATCH_REJECTED
        || oversized.app_error.kind != error.TOO_LARGE) { ret 16; }
    router.configured.max_decoded_parameter_bytes = 8192;
    if (compile(?router, ?routes[0], 3, storage, limits_default()).status
        != COMPILE_INVALID) { ret 17; }
    ret 0;
}

test compile__conflicts_and_mismatches {
    var parameters: [2]Parameter;
    parameters[0] = Parameter{name: view.view("id", 2), wildcard: false,
        decoder: u64_decoder()};
    parameters[1] = Parameter{name: view.view("name", 4), wildcard: false,
        decoder: text_decoder()};
    var routes: [2]Route;
    routes[0] = test_route(exact_method(method.from_kind(method.GET)), any_host(),
        path(view.view("/x/:id", 6)), ?parameters[0], 1, "first");
    routes[1] = test_route(exact_method(method.from_kind(method.GET)), any_host(),
        path(view.view("/x/:name", 8)), ?parameters[1], 1, "second");
    var specifications: [2]http_router.Route;
    var compiled:       [2]http_router.CompiledRoute;
    var segments:       [4]http_router.Segment;
    val storage:        Storage = Storage{specifications: ?specifications[0],
        specification_cap:  2, compiled_routes: ?compiled[0],
        compiled_route_cap: 2, segments: ?segments[0], segment_cap: 4};
    var router:   Router;
    val conflict: Compile = compile(?router, ?routes[0], 2, storage,
        limits_default());
    if (conflict.status != COMPILE_CONFLICT || conflict.route != 1
        || conflict.conflict_route != 0 || conflict.app_error.kind != error.CONFLICT
        || router.initialized) { ret 1; }
    routes[1] = test_route(exact_method(method.from_kind(method.GET)), any_host(),
        path(view.view("/y/:id", 6)), ?parameters[1], 1, "mismatch");
    var mismatch_router: Router;
    val mismatch:        Compile = compile(?mismatch_router, ?routes[1], 1,
        Storage{specifications: ?specifications[0], specification_cap: 1,
        compiled_routes: ?compiled[0], compiled_route_cap: 1,
        segments:        ?segments[0], segment_cap: 2}, limits_default());
    if (mismatch.status != COMPILE_PARAMETER
        || mismatch.app_error.kind != error.BAD_REQUEST
        || mismatch_router.initialized) { ret 2; }
    var bad_method: method.Method;
    routes[1] = test_route(exact_method(bad_method), any_host(),
        path(view.view("/", 1)), nil, 0, "bad-method");
    var method_router: Router;
    if (compile(?method_router, ?routes[1], 1,
        Storage{specifications: ?specifications[0], specification_cap: 1,
        compiled_routes: ?compiled[0], compiled_route_cap: 1,
        segments:        ?segments[0], segment_cap: 2}, limits_default()).status
        != COMPILE_METHOD) { ret 3; }
    routes[1] = test_route(any_method(), exact_host(view.view("*", 1)),
        path(view.view("/", 1)), nil, 0, "bad-host-kind");
    var host_router: Router;
    if (compile(?host_router, ?routes[1], 1,
        Storage{specifications: ?specifications[0], specification_cap: 1,
        compiled_routes: ?compiled[0], compiled_route_cap: 1,
        segments:        ?segments[0], segment_cap: 2}, limits_default()).status
        != COMPILE_HOST) { ret 4; }
    ret 0;
}

test decoders__bounds_and_malformed {
    var value: Value;
    if (is_err_u8_error_apperror(u64_decode(nil, nil,
        view.view("18446744073709551615", 20), ?value))
        || value.kind != VALUE_U64
        || value.unsigned_value != 18446744073709551615) { ret 1; }
    if (is_ok_u8_error_apperror(u64_decode(nil, nil,
        view.view("18446744073709551616", 20), ?value))) { ret 2; }
    if (is_err_u8_error_apperror(i64_decode(nil, nil,
        view.view("-9223372036854775808", 20), ?value))
        || value.kind != VALUE_I64
        || value.signed_value != (-9223372036854775807 - 1)) { ret 3; }
    if (is_err_u8_error_apperror(i64_decode(nil, nil,
        view.view("9223372036854775807", 19), ?value))
        || value.signed_value != 9223372036854775807) { ret 4; }
    if (is_ok_u8_error_apperror(i64_decode(nil, nil,
        view.view("9223372036854775808", 19), ?value))) { ret 5; }
    if (is_err_u8_error_apperror(bool_decode(nil, nil,
        view.view("false", 5), ?value)) || value.kind != VALUE_BOOL
        || value.boolean_value) { ret 6; }
    if (is_ok_u8_error_apperror(bool_decode(nil, nil,
        view.view("TRUE", 4), ?value))) { ret 7; }
    if (is_err_u8_error_apperror(uuid_decode(nil, nil,
        view.view("00112233-4455-6677-8899-aabbccddeeff", 36), ?value))
        || value.kind != VALUE_UUID || value.uuid_value[0] != 0
        || value.uuid_value[1] != 0x11 || value.uuid_value[15] != 0xff) { ret 8; }
    if (is_ok_u8_error_apperror(uuid_decode(nil, nil,
        view.view("001122334455-6677-8899-aabbccddeeff", 36), ?value))) { ret 9; }
    ret 0;
}

fun test_fallback(ctx: ptr, request_context: *context.Context,
    state: *ptr) handler.Result {
    val seen: *usize = ctx::*usize;
    if (seen != nil) { @seen = @seen + 1; }
    ret handler.respond();
}

test terminal__maps_dispatch_status {
    var routes: [1]Route;
    routes[0] = test_route(any_method(), any_host(),
        path(view.view("/hello", 6)), nil, 0, "hello");
    var specifications: [1]http_router.Route;
    var compiled:       [1]http_router.CompiledRoute;
    var segments:       [8]http_router.Segment;
    val storage:        Storage = Storage{specifications: ?specifications[0],
        specification_cap:  1, compiled_routes: ?compiled[0],
        compiled_route_cap: 1, segments: ?segments[0], segment_cap: 8};
    var router: Router;
    if (compile(?router, ?routes[0], 1, storage, limits_default()).status
        != COMPILE_OK) { ret 1; }
    var calls:    usize           = 0;
    val fallback: handler.Handler =
        handler.Handler{ctx: (?calls)::ptr, call: test_fallback,
        resume: nil};

    val missing: Terminal = terminal(?router, fallback,
        dispatch_result(DISPATCH_NOT_FOUND, no_error()));
    var slot:        ptr            = nil;
    val to_fallback: handler.Result =
        terminal_call((?missing)::ptr, nil, ?slot);
    if (sel to_fallback.ok) {
        if (to_fallback.ok.action != handler.RESPOND || calls != 1) { ret 2; }
    }
    or { ret 2; }

    val refused: Terminal = terminal(?router, fallback,
        dispatch_result(DISPATCH_BAD_REQUEST, bad_parameter()));
    val reported: handler.Result = terminal_call((?refused)::ptr, nil, ?slot);
    if (sel reported.err) {
        if (reported.err.kind != error.BAD_REQUEST
            || reported.err.status != 400 || calls != 1) { ret 3; }
    }
    or { ret 3; }

    # a terminal reached before a dispatch was stored carries no error of its
    # own, so it must report that rather than fail with an empty one
    val unarmed: Terminal = terminal(?router, fallback,
        dispatch_result(0, no_error()));
    val stated: handler.Result = terminal_call((?unarmed)::ptr, nil, ?slot);
    if (sel stated.err) {
        if (stated.err.kind != error.INTERNAL || stated.err.status != 500
            || calls != 1) { ret 4; }
    }
    or { ret 4; }

    val invalid: Terminal = terminal(nil, fallback,
        dispatch_result(DISPATCH_NOT_FOUND, no_error()));
    val refused_routes: handler.Result =
        terminal_call((?invalid)::ptr, nil, ?slot);
    if (sel refused_routes.err) {
        if (refused_routes.err.kind != error.INTERNAL || calls != 1) { ret 5; }
    }
    or { ret 5; }

    if (terminal_handler(nil).call != nil
        || terminal_handler(?missing).call == nil
        || terminal_handler(?missing).resume == nil
        || terminal_handler(?missing).ctx != (?missing)::ptr) { ret 6; }

    # a route that suspends with no resume is refused rather than entered
    val unresumable: handler.Result = terminal_resume((?missing)::ptr, nil,
        nil, handler.SETTLE_READY, 5);
    if (sel unresumable.ok)                     { ret 7; }
    if (unresumable.err.kind != error.INTERNAL) { ret 7; }
    ret 0;
}
