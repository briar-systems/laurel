# explicit application assembly and lifecycle ownership

use http.core.body;
use http.core.exchange;
use http.core.field;
use http.core.message;
use http.core.method;
use http.core.target;
use laurel.context;
use laurel.error;
use laurel.handler;
use laurel.lifecycle;
use laurel.middleware;
use laurel.observability;
use laurel.provider;
use laurel.render;
use laurel.router;
use laurel.security;
use laurel.security.csrf;
use laurel.session;
use A: std.allocator;
use std.allocator.fixed;
use std.chrono.duration;
use std.chrono.time;
use std.sync.atomic;
use std.sync.cancel;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.view;

fun fixed_ok(outcome: err[A.Error]) bool {
    ret sel outcome.ok;
}

fun operation_ok(outcome: cancel.Operation) bool {
    ret sel outcome.ok;
}

fun transition_ok(outcome: cancel.Transition) bool {
    ret (sel outcome.ok) && outcome.ok;
}

fun is_ok_ptr_error_apperror(outcome: res[ptr, error.AppError]) bool {
    ret sel outcome.ok;
}

val ADMISSION_CLOSED: i64 = -1;

fun app_identity(app: *App) ptr {
    if (app == nil) { ret nil; }
    ret (?app.config)::ptr;
}

# handler_deadline_ns bounds each request from Admission.started_ns, and the host enforces it
pub rec Limits {
    max_body_bytes:          usize;
    max_form_fields:         usize;
    max_upload_bytes:        usize;
    max_route_params:        usize;
    max_request_id_bytes:    usize;
    max_active_requests:     usize;
    max_middleware_depth:    usize;
    handler_deadline_ns:     i64;
    max_providers:           usize;
    max_provider_key_bytes:  usize;
    max_background_services: usize;
}

pub rec Config {
    limits:       Limits;
    trust_proxy:  bool;
    panic_policy: middleware.PanicPolicy;
}

pub rec App {
    config:        Config;
    router:        *router.Router;
    middleware:    *middleware.Stack;
    fallback:      handler.Handler;
    errors:        error.Mapper;
    providers:     *provider.Set;
    lifecycle:     *lifecycle.Controller;
    sessions:      *session.Manager;
    security:      *security.HeadersPolicy;
    csrf:          *csrf.Protector;
    origins:       *security.OriginPolicy;
    authenticator: *security.Authenticator;
    renderer:      *render.Renderer;
    observer:      *observability.Observer;
    vocabulary:    *observability.Vocabulary;
    event_policy:  observability.Policy;
    app_state:     ptr;
    admission:     i64;
    generation:    u64;
    valid:         bool;
}

pub rec Assembly {
    config:        Config;
    router:        *router.Router;
    middleware:    *middleware.Stack;
    fallback:      handler.Handler;
    errors:        error.Mapper;
    providers:     *provider.Set;
    lifecycle:     *lifecycle.Controller;
    sessions:      *session.Manager;
    security:      *security.HeadersPolicy;
    csrf:          *csrf.Protector;
    origins:       *security.OriginPolicy;
    authenticator: *security.Authenticator;
    renderer:      *render.Renderer;
    observer:      *observability.Observer;
    vocabulary:    *observability.Vocabulary;
    event_policy:  observability.Policy;
    app_state:     ptr;
}

val MAX_INSTANT_NS: i64 = 9223372036854775807;

# everything one admitted request needs, gathered where the server dispatches it
# started_ns is the monotonic admission instant and the handler deadline base, an Instant from std 5
pub rec Admission {
    exchange:   *exchange.Exchange;
    params:     context.Params;
    allocator:  *A.Allocator;
    request_id: view.View;
    route_name: view.View;
    started_ns: i64;
}

# the facts only the server measures, carried back for the one terminal event
pub rec Termination {
    outcome:  middleware.Outcome;
    reason:   cancel.Reason;
    status:   u16;
    transfer: exchange.Completion;
    now_ns:   i64;
}

pub fun validate_limits(limits: Limits) bool {
    ret limits.max_body_bytes > 0 && limits.max_form_fields > 0 && limits.max_upload_bytes > 0
        && limits.max_route_params > 0 && limits.max_request_id_bytes > 0
        && limits.max_active_requests > 0 && limits.max_active_requests <= 9223372036854775807
        && limits.max_middleware_depth > 0
        && limits.handler_deadline_ns >= lifecycle.NO_DEADLINE
        && limits.max_provider_key_bytes > 0 && limits.max_background_services > 0;
}

fun valid_stack(stack: *middleware.Stack) bool {
    if (stack == nil || (stack.len > 0 && stack.items == nil)) { ret false; }
    var i: usize = 0;
    for (i < stack.len) {
        if (stack.items[i].before == nil) { ret false; }
        i = i + 1;
    }
    ret true;
}

fun valid_observer(observer: *observability.Observer) bool {
    ret observer != nil && observer.start != nil && observer.finish != nil && observer.error != nil;
}

fun valid_optional_components(assembly: Assembly) bool {
    if (assembly.sessions != nil && !session.manager_valid(assembly.sessions)) {
        ret false;
    }
    if (assembly.csrf != nil && !csrf.valid(assembly.csrf)) { ret false; }
    if (assembly.origins != nil && !security.origins_valid(assembly.origins)) {
        ret false;
    }
    if (assembly.authenticator != nil &&
        !security.authenticator_valid(assembly.authenticator)) { ret false; }
    if (assembly.renderer != nil && assembly.renderer.render == nil) { ret false; }
    ret true;
}

pub fun validate_assembly(assembly: Assembly) bool {
    if (!validate_limits(assembly.config.limits) || assembly.router == nil
        || !assembly.router.initialized || !valid_stack(assembly.middleware)
        || assembly.middleware.len > assembly.config.limits.max_middleware_depth
        || assembly.config.panic_policy != middleware.PANIC_ABORT
        || assembly.fallback.call == nil || assembly.errors.render == nil ||
        !security.headers_valid(assembly.security)
        || !provider.validate(assembly.providers) || !lifecycle.validate(assembly.lifecycle)
        || assembly.lifecycle.state != lifecycle.ASSEMBLED || !valid_observer(assembly.observer)
        || !observability.vocabulary_valid(assembly.vocabulary)
        || !observability.policy_valid(assembly.event_policy)
        || !valid_optional_components(assembly)) { ret false; }
    if (assembly.providers.len > assembly.config.limits.max_providers
        || assembly.providers.max_key_bytes > assembly.config.limits.max_provider_key_bytes
        || assembly.lifecycle.len > assembly.config.limits.max_background_services) { ret false; }
    ret true;
}

pub fun assemble(app: *App, assembly: Assembly) bool {
    if (app == nil || app.valid || app.generation == 18446744073709551615
        || !validate_assembly(assembly)) { ret false; }
    app.config        = assembly.config;
    app.router        = assembly.router;
    app.middleware    = assembly.middleware;
    app.fallback      = assembly.fallback;
    app.errors        = assembly.errors;
    app.providers     = assembly.providers;
    app.lifecycle     = assembly.lifecycle;
    app.sessions      = assembly.sessions;
    app.security      = assembly.security;
    app.csrf          = assembly.csrf;
    app.origins       = assembly.origins;
    app.authenticator = assembly.authenticator;
    app.renderer      = assembly.renderer;
    app.observer      = assembly.observer;
    app.vocabulary    = assembly.vocabulary;
    app.event_policy  = assembly.event_policy;
    app.app_state     = assembly.app_state;
    app.admission     = ADMISSION_CLOSED;
    app.generation    = app.generation + 1;
    app.valid         = true;
    ret true;
}

pub fun start(app: *App) lifecycle.Transition {
    if (app == nil || !app.valid) {
        ret lifecycle.Transition{status: lifecycle.TRANSITION_INVALID, state: lifecycle.FAILED,
            component: lifecycle.NO_COMPONENT, error: view.view("invalid application", 19)};
    }
    atomic.store(?app.admission, ADMISSION_CLOSED);
    ret lifecycle.start(app.lifecycle);
}

pub fun poll_ready(app: *App) lifecycle.Transition {
    if (app == nil || !app.valid) {
        ret lifecycle.Transition{status: lifecycle.TRANSITION_INVALID, state: lifecycle.FAILED,
            component: lifecycle.NO_COMPONENT, error: view.view("invalid application", 19)};
    }
    val result: lifecycle.Transition = lifecycle.poll_ready(app.lifecycle);
    if (result.status == lifecycle.TRANSITION_OK && lifecycle.accepting(app.lifecycle)) {
        var expected: i64 = ADMISSION_CLOSED;
        if (!atomic.cas(?app.admission, ?expected, 0) && expected < 0) {
            ret request_transition(app, lifecycle.TRANSITION_INVALID);
        }
    }
    ret result;
}

fun request_transition(app: *App, status: lifecycle.TransitionStatus) lifecycle.Transition {
    var state: lifecycle.State = lifecycle.FAILED;
    if (app != nil && app.lifecycle != nil) { state = app.lifecycle.state; }
    ret lifecycle.Transition{status: status, state: state, component: lifecycle.NO_COMPONENT,
        error: view.view(nil, 0)};
}

pub fun active_request_count(app: *App) usize {
    if (app == nil) { ret 0; }
    val admission: i64 = atomic.load(?app.admission);
    if (admission >= 0) { ret admission::usize; }
    ret (0 - admission - 1)::usize;
}

fun close_admission(app: *App) {
    for (true) {
        val current: i64 = atomic.load(?app.admission);
        if (current < 0) { ret; }
        var expected: i64 = current;
        if (atomic.cas(?app.admission, ?expected, 0 - current - 1)) { ret; }
    }
}

fun reserve_context(app: *App) bool {
    if (app == nil || app.generation == 0) { ret false; }
    val limit: i64 = app.config.limits.max_active_requests::i64;
    for (true) {
        val current: i64 = atomic.load(?app.admission);
        if (current < 0 || current >= limit) { ret false; }
        var expected: i64 = current;
        if (atomic.cas(?app.admission, ?expected, current + 1)) { ret true; }
    }
    ret false;
}

fun release_reservation(app: *App) bool {
    for (true) {
        val current: i64 = atomic.load(?app.admission);
        if ((current == 0) || (current == ADMISSION_CLOSED)) { ret false; }
        var next: i64 = current - 1;
        if (current < 0) { next = current + 1; }
        var expected: i64 = current;
        if (atomic.cas(?app.admission, ?expected, next)) { ret true; }
    }
    ret false;
}

# the handler deadline counts from the host's monotonic started_ns, so laurel reads no clock
fun narrow_handler_deadline(app: *App, request_context: *context.Context,
    started_ns: i64) bool {
    val limit: i64 = app.config.limits.handler_deadline_ns;
    if (limit == lifecycle.NO_DEADLINE)                        { ret true; }
    if (started_ns < 0 || started_ns > MAX_INSTANT_NS - limit) { ret false; }
    val at_ns: i64 = started_ns + limit;
    ret context.narrow_deadline(request_context,
        time.Time{sec: at_ns / duration.SECOND, nsec: at_ns % duration.SECOND});
}

# admission and the start event are one step, so an admitted request is always
# an observed request
pub fun bind_context(app: *App, request_context: *context.Context,
    recorder: *observability.Recorder, admission: Admission) bool {
    if (app == nil || !app.valid || recorder == nil) { ret false; }
    if (!reserve_context(app))                       { ret false; }
    if (!context.bind(request_context, admission.exchange, admission.params,
        app.config.limits.max_route_params, admission.allocator, app_identity(app),
        app.generation, app.app_state, admission.request_id,
        app.config.limits.max_request_id_bytes)) {
        release_reservation(app);
        ret false;
    }
    if (!narrow_handler_deadline(app, request_context, admission.started_ns)) {
        context.unbind(request_context, app_identity(app), app.generation);
        release_reservation(app);
        ret false;
    }
    request_context.recorder = recorder::ptr;
    val observer_ref: *observability.Observer = app.observer;
    if (!observability.init_recorder(recorder, @observer_ref, app.vocabulary,
        app.event_policy)
        || observability.begin(recorder, request_context, admission.route_name,
        admission.started_ns) != observability.RECORD_OK) {
        context.unbind(request_context, app_identity(app), app.generation);
        release_reservation(app);
        ret false;
    }
    ret true;
}

# the recorder an admitted request is being observed through, so middleware and
# handlers can label an event they do not own
pub fun request_recorder(app: *App,
    request_context: *context.Context) *observability.Recorder {
    if (app == nil || !app.valid
        || !context.owned_by(request_context, app_identity(app), app.generation)) {
        ret nil;
    }
    ret request_context.recorder::*observability.Recorder;
}

# release and the terminal event are one step, for the same reason
pub fun release_context(app: *App, request_context: *context.Context,
    termination: Termination) bool {
    if (app == nil || request_context == nil ||
        !context.owned_by(request_context, app_identity(app), app.generation)) {
        ret false;
    }
    if (request_context.principal_state == context.PRINCIPAL_OWNED) {
        if (app.authenticator == nil ||
            !security.release_principal(app.authenticator, request_context)) {
            ret false;
        }
    }
    val recorder: *observability.Recorder =
        request_context.recorder::*observability.Recorder;
    if (!context.unbind(request_context, app_identity(app), app.generation)) {
        ret false;
    }
    var settled: bool = true;
    if (recorder != nil) {
        if (observability.observe_completion(recorder, termination.transfer)
            != observability.RECORD_OK
            || observability.observe_execution(recorder, termination.outcome,
            termination.reason, termination.status, termination.now_ns)
            != observability.RECORD_OK) {
            settled = false;
            observability.unreported(recorder,
                "request termination could not be described");
        }
        if (!observability.release(recorder)) { settled = false; }
    }
    if (!release_reservation(app)) { ret false; }
    ret settled;
}

fun invalid_execution(detail: str) middleware.Outcome {
    ret middleware.Outcome{
        status:    middleware.EXECUTION_ERROR_UNMAPPED,
        action:    0,
        token:     0,
        app_error: error.make(error.INTERNAL, 500,
            "internal server error", detail, false),
        render_error: error.render_failure(detail),
    };
}

fun executable(app: *App, request_context: *context.Context) bool {
    ret app != nil && app.valid && request_context != nil
        && context.owned_by(request_context, app_identity(app), app.generation);
}

# the execution record belongs to the host, alongside the context and the
# recorder, because a request that suspends outlives this call
pub fun execute(app: *App, execution: *middleware.Execution,
    terminal: handler.Handler,
    request_context: *context.Context) middleware.Outcome {
    if (!executable(app, request_context)) {
        ret invalid_execution("middleware context is not owned by the application");
    }
    ret middleware.execute(execution, app.middleware, terminal, app.errors,
        request_context, middleware.Policy{
        max_depth:    app.config.limits.max_middleware_depth,
        panic_policy: app.config.panic_policy,
    });
}

# the body i/o the pending outcome named has settled. only the suspended step is
# entered, and nothing that already ran runs again
pub fun resume(app: *App, execution: *middleware.Execution,
    request_context: *context.Context) middleware.Outcome {
    if (!executable(app, request_context)) {
        ret invalid_execution("middleware context is not owned by the application");
    }
    ret middleware.resume(execution, request_context);
}

# the request is going away while a step holds it. every exit half that is owed
# still runs, and the host must call this before releasing a suspended context
pub fun abandon(app: *App, execution: *middleware.Execution,
    request_context: *context.Context) middleware.Outcome {
    if (!executable(app, request_context)) {
        ret invalid_execution("middleware context is not owned by the application");
    }
    ret middleware.abandon(execution, request_context);
}

pub fun drain(app: *App, deadline_ns: i64) lifecycle.Transition {
    if (app == nil || !app.valid) {
        ret lifecycle.Transition{status: lifecycle.TRANSITION_INVALID, state: lifecycle.FAILED,
            component: lifecycle.NO_COMPONENT, error: view.view("invalid application", 19)};
    }
    close_admission(app);
    var result: lifecycle.Transition;
    if (app.lifecycle.state == lifecycle.DRAINED) {
        result = request_transition(app, lifecycle.TRANSITION_OK);
    }
    or {
        result = lifecycle.drain(app.lifecycle, deadline_ns);
    }
    if (result.status == lifecycle.TRANSITION_OK && active_request_count(app) > 0) {
        ret request_transition(app, lifecycle.TRANSITION_PENDING);
    }
    ret result;
}

pub fun stop(app: *App) lifecycle.Transition {
    if (app == nil || !app.valid) {
        ret lifecycle.Transition{status: lifecycle.TRANSITION_INVALID, state: lifecycle.FAILED,
            component: lifecycle.NO_COMPONENT, error: view.view("invalid application", 19)};
    }
    close_admission(app);
    if (active_request_count(app) > 0) {
        ret request_transition(app, lifecycle.TRANSITION_PENDING);
    }
    ret lifecycle.stop(app.lifecycle);
}

pub fun cleanup_failure(app: *App) lifecycle.Transition {
    if (app == nil || !app.valid) {
        ret lifecycle.Transition{status: lifecycle.TRANSITION_INVALID, state: lifecycle.FAILED,
            component: lifecycle.NO_COMPONENT, error: view.view("invalid application", 19)};
    }
    ret lifecycle.cleanup_failure(app.lifecycle);
}

pub fun can_accept(app: *App) bool {
    if (app == nil || !app.valid) { ret false; }
    val admission: i64 = atomic.load(?app.admission);
    ret admission >= 0 && admission < app.config.limits.max_active_requests::i64;
}

pub fun drained(app: *App) bool {
    ret app != nil && app.valid && atomic.load(?app.admission) == ADMISSION_CLOSED
        && app.lifecycle.state == lifecycle.DRAINED;
}

pub fun release(app: *App) bool {
    if (app == nil || !app.valid || atomic.load(?app.admission) != ADMISSION_CLOSED
        || !lifecycle.terminal(app.lifecycle)) { ret false; }
    app.router        = nil;
    app.middleware    = nil;
    app.providers     = nil;
    app.lifecycle     = nil;
    app.sessions      = nil;
    app.security      = nil;
    app.csrf          = nil;
    app.origins       = nil;
    app.authenticator = nil;
    app.renderer      = nil;
    app.observer      = nil;
    app.vocabulary    = nil;
    app.app_state     = nil;
    app.admission     = ADMISSION_CLOSED;
    app.valid         = false;
    ret true;
}

fun test_lifecycle_start(context: ptr) res[lifecycle.CallbackStatus, view.View] {
    ret res[lifecycle.CallbackStatus, view.View].ok{lifecycle.CALLBACK_DONE};
}

fun test_lifecycle_ready(context: ptr) lifecycle.Readiness {
    ret lifecycle.READY_NOW;
}

fun test_lifecycle_drain(context: ptr, deadline_ns: i64) res[lifecycle.CallbackStatus, view.View] {
    ret res[lifecycle.CallbackStatus, view.View].ok{lifecycle.CALLBACK_DONE};
}

fun test_lifecycle_stop(context: ptr) res[lifecycle.CallbackStatus, view.View] {
    ret res[lifecycle.CallbackStatus, view.View].ok{lifecycle.CALLBACK_DONE};
}

rec TestLifecycleFailure {
    fail_start: bool;
    fail_stop:  bool;
}

fun test_failed_lifecycle_start(context: ptr) res[lifecycle.CallbackStatus, view.View] {
    val state: *TestLifecycleFailure = context::*TestLifecycleFailure;
    if (state != nil && state.fail_start) {
        ret res[lifecycle.CallbackStatus, view.View].err{view.view("start failed", 12)};
    }
    ret res[lifecycle.CallbackStatus, view.View].ok{lifecycle.CALLBACK_DONE};
}

fun test_failed_lifecycle_stop(context: ptr) res[lifecycle.CallbackStatus, view.View] {
    val state: *TestLifecycleFailure = context::*TestLifecycleFailure;
    if (state != nil && state.fail_stop) {
        state.fail_stop = false;
        ret res[lifecycle.CallbackStatus, view.View].err{view.view("stop failed", 11)};
    }
    ret res[lifecycle.CallbackStatus, view.View].ok{lifecycle.CALLBACK_DONE};
}

fun test_handler(context_ptr: ptr, request_context: *context.Context,
    state: *ptr) handler.Result {
    ret handler.respond();
}

fun test_failing_handler(context_ptr: ptr,
    request_context: *context.Context, state: *ptr) handler.Result {
    ret handler.fail(error.make(error.NOT_FOUND, 404, "not found",
        "no matching resource", false));
}

fun test_error(context_ptr: ptr, app_error: error.AppError,
    request_context: *context.Context) res[u8, error.RenderFailure] {
    ret res[u8, error.RenderFailure].ok{1};
}

rec EventSink {
    start_calls:  usize;
    finish_calls: usize;
    error_calls:  usize;
    status:       u16;
    outcome:      observability.Outcome;
    kind:         error.Kind;
    sequence:     u64;
    route:        [16]u8;
    route_len:    usize;
    label_len:    usize;
}

fun record_event(state: *EventSink, event: *observability.RequestEvent) {
    if (state == nil || event == nil) { ret; }
    state.status    = event.status;
    state.outcome   = event.outcome;
    state.kind      = event.error_kind;
    state.sequence  = event.sequence;
    state.label_len = event.label_len;
    val name: view.View = observability.event_route_name(event);
    state.route_len = 0;
    if (name.len == 0 || name.len > 16) { ret; }
    var i: usize = 0;
    for (i < name.len) {
        state.route[i] = name.data[i];
        i              = i + 1;
    }
    state.route_len = name.len;
}

fun test_observer_start(context_ptr: ptr, event: *observability.RequestEvent) {
    val state: *EventSink = context_ptr::*EventSink;
    if (state == nil) { ret; }
    state.start_calls = state.start_calls + 1;
    record_event(state, event);
}

fun test_observer_finish(context_ptr: ptr, event: *observability.RequestEvent) {
    val state: *EventSink = context_ptr::*EventSink;
    if (state == nil) { ret; }
    state.finish_calls = state.finish_calls + 1;
    record_event(state, event);
}

fun test_observer_error(context_ptr: ptr, event: *observability.RequestEvent,
    app_error: error.AppError) {
    val state: *EventSink = context_ptr::*EventSink;
    if (state == nil) { ret; }
    state.error_calls = state.error_calls + 1;
    record_event(state, event);
}

fun test_vocabulary(vocabulary: *observability.Vocabulary,
    specs: *observability.LabelSpec) bool {
    if (!observability.term(?specs[0].name, view.view("kind", 4))) { ret false; }
    specs[0].values          = nil;
    specs[0].value_count     = 0;
    specs[0].max_value_bytes = 16;
    ret observability.init_vocabulary(vocabulary, specs, 1);
}

rec TestAuthenticator {
    principal:          i64;
    authenticate_calls: usize;
    release_calls:      usize;
    owned:              bool;
    fail_authenticate:  bool;
    empty_principal:    bool;
    fail_release:       bool;
}

fun test_auth_aliases(context_ptr: ptr, data: *u8, len: usize) bool {
    if (context_ptr == nil || len == 0 || data == nil) { ret false; }
    val state:  *TestAuthenticator = context_ptr::*TestAuthenticator;
    val first:  usize              = state::usize;
    val second: usize              = data::usize;
    if (len - 1 > ~(0::usize) - second) { ret true; }
    ret first <= second + len - 1 &&
        second <= first + $size_of(TestAuthenticator) - 1;
}

fun test_authenticate(context_ptr: ptr, request: *message.Request)
    res[ptr, error.AppError] {
    val state: *TestAuthenticator = context_ptr::*TestAuthenticator;
    if (request == nil || state.owned) {
        ret res[ptr, error.AppError].err{error.make(error.INTERNAL, 500,
            "internal server error", "invalid test authentication", false)};
    }
    state.authenticate_calls = state.authenticate_calls + 1;
    if (state.fail_authenticate) {
        ret res[ptr, error.AppError].err{error.make(error.UNAUTHORIZED, 401,
            "authentication required", "test authentication rejected", false)};
    }
    if (state.empty_principal) {
        ret res[ptr, error.AppError].ok{nil};
    }
    state.owned = true;
    ret res[ptr, error.AppError].ok{?state.principal};
}

fun test_release_principal(context_ptr: ptr, principal: ptr) bool {
    val state: *TestAuthenticator = context_ptr::*TestAuthenticator;
    if (!state.owned || principal != ?state.principal) { ret false; }
    state.release_calls = state.release_calls + 1;
    if (state.fail_release) { ret false; }
    state.owned = false;
    ret true;
}

test "laurel.app: assembly and lifecycle retain caller ownership" {
    var providers: provider.Set;
    if (!provider.init(?providers, nil, 0, 0, 32)) { ret 1; }
    var lifecycle_item: lifecycle.Lifecycle = lifecycle.Lifecycle{ctx: nil, start: test_lifecycle_start,
        ready: test_lifecycle_ready, drain: test_lifecycle_drain, stop: test_lifecycle_stop};
    var controller: lifecycle.Controller;
    if (!lifecycle.init(?controller, ?lifecycle_item, 1, 1)) { ret 2; }
    var routes: router.Router;
    if (router.compile(?routes, nil, 0, router.Storage{specifications: nil, specification_cap: 0,
        compiled_routes: nil, compiled_route_cap: 0, segments: nil,
        segment_cap:     0},
        router.limits_default()).status != router.COMPILE_OK) { ret 2; }
    var middlewares: middleware.Stack = middleware.Stack{items: nil, len: 0};
    var headers:     security.HeadersPolicy;
    if (!security.secure_headers(?headers)) { ret 2; }
    var sink: EventSink;
    sink.start_calls  = 0;
    sink.finish_calls = 0;
    sink.error_calls  = 0;
    sink.status       = 0;
    sink.outcome      = 0;
    sink.kind         = 0;
    sink.sequence     = 0;
    sink.route_len    = 0;
    sink.label_len    = 0;
    var observer: observability.Observer = observability.Observer{ctx: (?sink)::ptr,
        start: test_observer_start, finish: test_observer_finish,
        error: test_observer_error};
    var label_specs: [1]observability.LabelSpec;
    var vocabulary:  observability.Vocabulary;
    if (!test_vocabulary(?vocabulary, ?label_specs[0])) { ret 2; }
    var auth_state:    TestAuthenticator      = TestAuthenticator{principal: 7, authenticate_calls: 0, release_calls: 0, owned: false, fail_authenticate: false, empty_principal: false, fail_release: false};
    var authenticator: security.Authenticator = security.Authenticator{
        ctx:           ?auth_state, context_size: $size_of(TestAuthenticator),
        aliases_state: test_auth_aliases, authenticate: test_authenticate,
        release:       test_release_principal
    };
    var app:      App;
    val assembly: Assembly = Assembly{
        config: Config{limits: Limits{max_body_bytes: 1024, max_form_fields: 16, max_upload_bytes: 4096,
            max_route_params:       8, max_request_id_bytes: 64, max_active_requests: 1,
            max_middleware_depth:   16,
            handler_deadline_ns:    lifecycle.NO_DEADLINE, max_providers: 0,
            max_provider_key_bytes: 32, max_background_services: 1}, trust_proxy: false,
            panic_policy:           middleware.PANIC_ABORT},
        router:        ?routes,
        middleware:    ?middlewares,
        fallback:      handler.Handler{ctx: nil, call: test_handler, resume: nil},
        errors:        error.Mapper{ctx: nil, render: test_error},
        providers:     ?providers,
        lifecycle:     ?controller,
        sessions:      nil,
        security:      ?headers,
        csrf:          nil,
        origins:       nil,
        authenticator: ?authenticator,
        renderer:      nil,
        observer:      ?observer,
        vocabulary:    ?vocabulary,
        event_policy:  observability.policy_default(),
        app_state:     nil,
    };
    if (!assemble(?app, assembly) || can_accept(?app))                           { ret 3; }
    if (start(?app).status != lifecycle.TRANSITION_OK || can_accept(?app))       { ret 4; }
    if (poll_ready(?app).status != lifecycle.TRANSITION_OK || !can_accept(?app)) { ret 5; }

    val configured: message.Limits = message.limits_default();
    var scope:      cancel.Scope;
    if (!operation_ok(cancel.make_root(?scope, false, time.Time{sec: 0, nsec: 0}))) { ret 6; }
    var request_fields:   field.Fields     = field.init(nil, 0, field.limits(0, 0, 0, 0));
    var request_trailers: field.Fields     = field.init(nil, 0, field.limits(0, 0, 0, 0));
    var request_body:     body.Reader      = body.empty_reader(101);
    var request:          message.Request;
    val metadata:         message.Metadata = message.Metadata{
        version:     message.version_h1(1, 1), secure: true, early_data: false,
        peer:        message.unspecified_endpoint(), local: message.unspecified_endpoint(),
        received_at: time.Time{sec: 1, nsec: 0}, has_deadline: false,
        deadline:    time.Time{sec: 0, nsec: 0}, request_index: 1,
    };
    if (!message.init_request(?request, method.from_kind(method.GET),
        target.origin(view.view("/", 1), view.view("/", 1), view.view(nil, 0)), metadata,
        request_fields, request_trailers, ?request_body, 101, configured)) { ret 7; }
    var response_fields:   [100]field.Field;
    var response_trailers: [32]field.Field;
    var response:          message.Response;
    if (!message.init_response(?response, ?response_fields[0], 100,
        ?response_trailers[0], 32, 101, configured)) { ret 8; }
    var informationals: [8]message.Informational;
    var http_exchange:  exchange.Exchange;
    if (!exchange.init(?http_exchange, ?request, ?response, ?informationals[0], 8,
        ?scope, 101, configured) || !exchange.begin(?http_exchange)) { ret 9; }
    var allocation_bytes: [4096]u8;
    var allocation_state: fixed.FixedState;
    var allocator:        A.Allocator;
    if (!fixed_ok(fixed.make(?allocator, ?allocation_state,
        ?allocation_bytes[0], 4096))) { ret 10; }
    var request_context: context.Context;
    var recorder:        observability.Recorder;
    val admission:       Admission = Admission{exchange: ?http_exchange,
        params:     context.Params{items: nil, len: 0, generation: 101},
        allocator:  ?allocator, request_id: view.view("request-101", 11),
        route_name: view.view("orders.show", 11), started_ns: 0};
    if (!bind_context(?app, ?request_context, ?recorder, admission)
        || active_request_count(?app) != 1 || sink.start_calls != 1
        || sink.route_len != 11
        || request_recorder(?app, ?request_context) != ?recorder) { ret 10; }
    auth_state.fail_authenticate = true;
    if (is_ok_ptr_error_apperror(security.authenticate(?authenticator, ?request_context)) ||
        request_context.principal_state != context.PRINCIPAL_NONE ||
        request_context.principal != nil || auth_state.authenticate_calls != 1) {
        ret 15;
    }
    auth_state.fail_authenticate = false;
    auth_state.empty_principal   = true;
    if (is_ok_ptr_error_apperror(security.authenticate(?authenticator, ?request_context)) ||
        request_context.principal_state != context.PRINCIPAL_NONE ||
        request_context.principal != nil || auth_state.authenticate_calls != 2) {
        ret 15;
    }
    auth_state.empty_principal = false;
    val authenticated: res[ptr, error.AppError] =
        security.authenticate(?authenticator, ?request_context);
    if (sel authenticated.err)                                                                                                                                                                                                              { ret 15; }
    if (authenticated.ok != ?auth_state.principal || request_context.principal_state != context.PRINCIPAL_OWNED || auth_state.authenticate_calls != 3 || is_ok_ptr_error_apperror(security.authenticate(?authenticator, ?request_context))) { ret 15; }
    var executed_execution: middleware.Execution;
    executed_execution.active = false;
    val executed: middleware.Outcome = execute(?app, ?executed_execution,
        handler.Handler{ctx: nil, call: test_handler, resume: nil}, ?request_context);
    if (executed.status != middleware.EXECUTION_RESPOND
        || executed.action != handler.RESPOND) { ret 10; }
    var rejected_context:  context.Context;
    var rejected_recorder: observability.Recorder;
    val rejected:          Admission = Admission{exchange: ?http_exchange,
        params:     context.Params{items: nil, len: 0, generation: 101},
        allocator:  ?allocator, request_id: view.view("rejected-101", 12),
        route_name: view.view(nil, 0), started_ns: 0};
    if (can_accept(?app)
        || bind_context(?app, ?rejected_context, ?rejected_recorder, rejected)
        || rejected_context.bound || active_request_count(?app) != 1
        || sink.start_calls != 1) { ret 10; }
    if (drain(?app, lifecycle.NO_DEADLINE).status != lifecycle.TRANSITION_PENDING
        || can_accept(?app) || stop(?app).status != lifecycle.TRANSITION_PENDING) { ret 11; }
    val termination: Termination = Termination{outcome: executed,
        reason:   cancel.Reason.active{}, status: 200,
        transfer: http_exchange.completion, now_ns: 1};
    auth_state.fail_release = true;
    if (release_context(?app, ?request_context, termination) ||
        request_context.principal_state != context.PRINCIPAL_OWNED ||
        request_context.principal != ?auth_state.principal ||
        auth_state.release_calls != 1 || sink.finish_calls != 0) { ret 12; }
    auth_state.fail_release = false;
    if (!release_context(?app, ?request_context, termination)
        || release_context(?app, ?request_context, termination)
        || drain(?app, lifecycle.NO_DEADLINE).status != lifecycle.TRANSITION_OK
        || !drained(?app) || auth_state.release_calls != 2 ||
        auth_state.owned) { ret 12; }
    if (sink.start_calls != 1 || sink.finish_calls != 1 || sink.error_calls != 0
        || sink.status != 200 || sink.outcome != observability.OUTCOME_COMPLETED
        || sink.route_len != 11) { ret 12; }
    if (stop(?app).status != lifecycle.TRANSITION_OK || !lifecycle.terminal(?controller))             { ret 13; }
    if (!release(?app) || app.valid || app.app_state != nil || !operation_ok(cancel.destroy(?scope))) { ret 14; }
    ret 0;
}

test "laurel.app: cleanup failure remains observable after primary failure" {
    var providers: provider.Set;
    if (!provider.init(?providers, nil, 0, 0, 32)) { ret 1; }
    var failures: TestLifecycleFailure;
    failures.fail_start = true;
    failures.fail_stop  = false;
    var lifecycle_item: lifecycle.Lifecycle = lifecycle.Lifecycle{
        ctx: (?failures)::ptr, start: test_failed_lifecycle_start,
        ready:                        test_lifecycle_ready, drain: test_lifecycle_drain,
        stop:                         test_failed_lifecycle_stop
    };
    var controller: lifecycle.Controller;
    if (!lifecycle.init(?controller, ?lifecycle_item, 1, 1)) { ret 2; }
    var routes: router.Router;
    if (router.compile(?routes, nil, 0, router.Storage{specifications: nil, specification_cap: 0,
        compiled_routes: nil, compiled_route_cap: 0, segments: nil,
        segment_cap:     0},
        router.limits_default()).status != router.COMPILE_OK) { ret 2; }
    var middlewares: middleware.Stack = middleware.Stack{items: nil, len: 0};
    var headers:     security.HeadersPolicy;
    if (!security.secure_headers(?headers)) { ret 2; }
    var sink: EventSink;
    sink.start_calls  = 0;
    sink.finish_calls = 0;
    sink.error_calls  = 0;
    sink.status       = 0;
    sink.outcome      = 0;
    sink.kind         = 0;
    sink.sequence     = 0;
    sink.route_len    = 0;
    sink.label_len    = 0;
    var observer: observability.Observer = observability.Observer{ctx: (?sink)::ptr,
        start: test_observer_start, finish: test_observer_finish,
        error: test_observer_error};
    var label_specs: [1]observability.LabelSpec;
    var vocabulary:  observability.Vocabulary;
    if (!test_vocabulary(?vocabulary, ?label_specs[0])) { ret 2; }
    var application: App;
    if (!observed_app(?application, ?providers, ?controller, ?routes, ?middlewares,
        ?headers, ?observer, ?vocabulary, lifecycle.NO_DEADLINE)) { ret 3; }
    val primary:    lifecycle.Transition = start(?application);
    val no_cleanup: lifecycle.Transition = cleanup_failure(?application);
    if (primary.status != lifecycle.TRANSITION_FAILED || primary.component != 0
        || primary.error.len != 12 || no_cleanup.status != lifecycle.TRANSITION_OK
        || no_cleanup.component != lifecycle.NO_COMPONENT || no_cleanup.error.len != 0) {
        ret 4;
    }
    failures.fail_stop = true;
    if (stop(?application).status != lifecycle.TRANSITION_FAILED) { ret 5; }
    val cleanup: lifecycle.Transition = cleanup_failure(?application);
    if (cleanup.status != lifecycle.TRANSITION_FAILED || cleanup.component != 0
        || cleanup.error.len != 11) { ret 6; }
    val retained: lifecycle.Transition = stop(?application);
    if (retained.status != lifecycle.TRANSITION_FAILED || retained.component != 0
        || retained.error.len != 12 || !lifecycle.terminal(?controller)) { ret 7; }
    if (!release(?application) || !lifecycle.destroy(?controller)) { ret 8; }
    ret 0;
}

rec RequestFixture {
    scope:             cancel.Scope;
    request_body:      body.Reader;
    request:           message.Request;
    response_fields:   [8]field.Field;
    response_trailers: [4]field.Field;
    response:          message.Response;
    informationals:    [2]message.Informational;
    exchange:          exchange.Exchange;
    allocation_bytes:  [512]u8;
    allocation_state:  fixed.FixedState;
    allocator:         A.Allocator;
    request_context:   context.Context;
}

fun request_fixture(state: *RequestFixture, generation: u64, path: view.View) bool {
    ret request_fixture_until(state, generation, path, false, time.Time{sec: 0, nsec: 0});
}

fun request_fixture_until(state: *RequestFixture, generation: u64, path: view.View,
    has_deadline: bool, deadline: time.Time) bool {
    if (state == nil
        || !operation_ok(cancel.make_root(?state.scope, has_deadline, deadline))) {
        ret false;
    }
    if (!fixed_ok(fixed.make(?state.allocator, ?state.allocation_state,
        ?state.allocation_bytes[0], 512))) { ret false; }
    val configured:       message.Limits = message.limits_default();
    val request_fields:   field.Fields   = field.init(nil, 0, field.limits(0, 0, 0, 0));
    val request_trailers: field.Fields   = field.init(nil, 0, field.limits(0, 0, 0, 0));
    state.request_body = body.empty_reader(generation);
    val metadata: message.Metadata = message.Metadata{
        version:     message.version_h1(1, 1), secure: true, early_data: false,
        peer:        message.unspecified_endpoint(), local: message.unspecified_endpoint(),
        received_at: time.Time{sec: 1, nsec: 0}, has_deadline: has_deadline,
        deadline:    deadline, request_index: 1
    };
    if (!message.init_request(?state.request, method.from_kind(method.GET),
        target.origin(path, path, view.view(nil, 0)), metadata, request_fields,
        request_trailers, ?state.request_body, generation, configured)) { ret false; }
    if (!message.init_response(?state.response, ?state.response_fields[0], 8,
        ?state.response_trailers[0], 4, generation, configured)) { ret false; }
    ret exchange.init(?state.exchange, ?state.request, ?state.response,
        ?state.informationals[0], 2, ?state.scope, generation, configured)
        && exchange.begin(?state.exchange);
}

fun fixture_admission(state: *RequestFixture, generation: u64, request_id: view.View,
    route_name: view.View) Admission {
    ret Admission{exchange: ?state.exchange,
        params:     context.Params{items: nil, len: 0, generation: generation},
        allocator:  ?state.allocator, request_id: request_id, route_name: route_name,
        started_ns: 0};
}

fun observed_app(app: *App, providers: *provider.Set,
    controller: *lifecycle.Controller, routes: *router.Router,
    stack: *middleware.Stack, headers: *security.HeadersPolicy,
    observer: *observability.Observer,
    vocabulary: *observability.Vocabulary, handler_deadline_ns: i64) bool {
    val assembly: Assembly = Assembly{
        config: Config{limits: Limits{max_body_bytes: 1024, max_form_fields: 16,
            max_upload_bytes:       4096, max_route_params: 8, max_request_id_bytes: 64,
            max_active_requests:    1, max_middleware_depth: 16,
            handler_deadline_ns:    handler_deadline_ns, max_providers: 0,
            max_provider_key_bytes: 32, max_background_services: 1},
            trust_proxy:            false, panic_policy: middleware.PANIC_ABORT},
        router:        routes,
        middleware:    stack,
        fallback:      handler.Handler{ctx: nil, call: test_handler, resume: nil},
        errors:        error.Mapper{ctx: nil, render: test_error},
        providers:     providers,
        lifecycle:     controller,
        sessions:      nil,
        security:      headers,
        csrf:          nil,
        origins:       nil,
        authenticator: nil,
        renderer:      nil,
        observer:      observer,
        vocabulary:    vocabulary,
        event_policy:  observability.policy_default(),
        app_state:     nil,
    };
    ret assemble(app, assembly);
}

test "laurel.app: an admitted request reaches the assembled observer" {
    var providers: provider.Set;
    if (!provider.init(?providers, nil, 0, 0, 32)) { ret 1; }
    var lifecycle_item: lifecycle.Lifecycle = lifecycle.Lifecycle{ctx: nil,
        start: test_lifecycle_start, ready: test_lifecycle_ready,
        drain: test_lifecycle_drain, stop: test_lifecycle_stop};
    var controller: lifecycle.Controller;
    if (!lifecycle.init(?controller, ?lifecycle_item, 1, 1)) { ret 2; }
    var routes: router.Router;
    if (router.compile(?routes, nil, 0, router.Storage{specifications: nil, specification_cap: 0,
        compiled_routes: nil, compiled_route_cap: 0, segments: nil,
        segment_cap:     0},
        router.limits_default()).status != router.COMPILE_OK) { ret 2; }
    var middlewares: middleware.Stack = middleware.Stack{items: nil, len: 0};
    var headers:     security.HeadersPolicy;
    if (!security.secure_headers(?headers)) { ret 2; }
    var sink: EventSink;
    sink.start_calls  = 0;
    sink.finish_calls = 0;
    sink.error_calls  = 0;
    sink.status       = 0;
    sink.outcome      = 0;
    sink.kind         = 0;
    sink.sequence     = 0;
    sink.route_len    = 0;
    sink.label_len    = 0;
    var observer: observability.Observer = observability.Observer{ctx: (?sink)::ptr,
        start: test_observer_start, finish: test_observer_finish,
        error: test_observer_error};
    var label_specs: [1]observability.LabelSpec;
    var vocabulary:  observability.Vocabulary;
    if (!test_vocabulary(?vocabulary, ?label_specs[0])) { ret 2; }
    var app: App;
    if (!observed_app(?app, ?providers, ?controller, ?routes, ?middlewares,
        ?headers, ?observer, ?vocabulary, lifecycle.NO_DEADLINE)
        || start(?app).status != lifecycle.TRANSITION_OK
        || poll_ready(?app).status != lifecycle.TRANSITION_OK) { ret 3; }

    # one recorder serves the whole application, exactly as a single-slot host
    # would reuse its per-request storage
    var recorder: observability.Recorder;

    # a start the recorder refuses is a request that was never admitted
    var unstartable: RequestFixture;
    if (!request_fixture(?unstartable, 100, view.view("/orders", 7))) { ret 4; }
    if (bind_context(?app, ?unstartable.request_context, ?recorder,
        fixture_admission(?unstartable, 100, view.view("request-100", 11),
        view.view("orders index", 12)))
        || unstartable.request_context.bound || sink.start_calls != 0
        || active_request_count(?app) != 0 || !can_accept(?app)
        || !operation_ok(cancel.destroy(?unstartable.scope))) { ret 4; }

    var completed: RequestFixture;
    if (!request_fixture(?completed, 101, view.view("/orders", 7))) { ret 4; }
    if (!bind_context(?app, ?completed.request_context, ?recorder,
        fixture_admission(?completed, 101, view.view("request-101", 11),
        view.view("orders.index", 12)))) { ret 5; }
    if (sink.start_calls != 1 || sink.route_len != 12 || sink.sequence != 1
        || request_recorder(?app, ?completed.request_context) != ?recorder) { ret 5; }
    var responded_execution: middleware.Execution;
    responded_execution.active = false;
    val responded: middleware.Outcome = execute(?app, ?responded_execution,
        handler.Handler{ctx: nil, call: test_handler, resume: nil}, ?completed.request_context);
    if (responded.status != middleware.EXECUTION_RESPOND) { ret 6; }
    if (observability.set_label(request_recorder(?app, ?completed.request_context),
        view.view("kind", 4), view.view("read", 4)) != observability.RECORD_OK) {
        ret 6;
    }
    if (!release_context(?app, ?completed.request_context,
        Termination{outcome: responded, reason: cancel.Reason.active{}, status: 200,
        transfer: completed.exchange.completion, now_ns: 3})
        || !operation_ok(cancel.destroy(?completed.scope))) { ret 7; }
    if (sink.start_calls != 1 || sink.finish_calls != 1 || sink.error_calls != 0
        || sink.status != 200 || sink.outcome != observability.OUTCOME_COMPLETED
        || sink.route_len != 12 || sink.label_len != 1) { ret 7; }

    var faulted: RequestFixture;
    if (!request_fixture(?faulted, 102, view.view("/absent", 7))) { ret 8; }
    if (!bind_context(?app, ?faulted.request_context, ?recorder,
        fixture_admission(?faulted, 102, view.view("request-102", 11),
        view.view(nil, 0)))
        || sink.start_calls != 2 || sink.route_len != 0 || sink.sequence != 2) {
        ret 9;
    }
    var refused_execution: middleware.Execution;
    refused_execution.active = false;
    val refused: middleware.Outcome = execute(?app, ?refused_execution,
        handler.Handler{ctx: nil, call: test_failing_handler, resume: nil},
        ?faulted.request_context);
    if (refused.status != middleware.EXECUTION_ERROR_RENDERED) { ret 10; }
    if (!release_context(?app, ?faulted.request_context,
        Termination{outcome: refused, reason: cancel.Reason.active{}, status: 404,
        transfer: faulted.exchange.completion, now_ns: 3})
        || !operation_ok(cancel.destroy(?faulted.scope))) { ret 11; }
    if (sink.start_calls != 2 || sink.finish_calls != 1 || sink.error_calls != 1
        || sink.status != 404 || sink.kind != error.NOT_FOUND
        || sink.outcome != observability.OUTCOME_FAILED) { ret 11; }

    var stopped: RequestFixture;
    if (!request_fixture(?stopped, 103, view.view("/slow", 5))) { ret 12; }
    if (!bind_context(?app, ?stopped.request_context, ?recorder,
        fixture_admission(?stopped, 103, view.view("request-103", 11),
        view.view(nil, 0)))
        || sink.start_calls != 3 || sink.sequence != 3) { ret 13; }
    if (!transition_ok(cancel.cancel(?stopped.scope))) { ret 14; }
    var abandoned_execution: middleware.Execution;
    abandoned_execution.active = false;
    val abandoned: middleware.Outcome = execute(?app, ?abandoned_execution,
        handler.Handler{ctx: nil, call: test_handler, resume: nil}, ?stopped.request_context);
    if (abandoned.status != middleware.EXECUTION_CANCELLED) { ret 15; }
    if (!release_context(?app, ?stopped.request_context,
        Termination{outcome: abandoned, reason: cancel.reason(?stopped.scope),
        status: 408, transfer: stopped.exchange.completion, now_ns: 3})
        || !operation_ok(cancel.destroy(?stopped.scope))) { ret 16; }
    if (sink.start_calls != 3 || sink.finish_calls != 2 || sink.error_calls != 1
        || sink.status != 408
        || sink.outcome != observability.OUTCOME_CANCELLED) { ret 16; }

    # a termination the recorder refuses is still exactly one terminal event
    var undescribed:          RequestFixture;
    var undescribed_recorder: observability.Recorder;
    if (!request_fixture(?undescribed, 200, view.view("/orders", 7))) { ret 17; }
    if (!bind_context(?app, ?undescribed.request_context, ?undescribed_recorder,
        Admission{exchange: ?undescribed.exchange,
        params:     context.Params{items: nil, len: 0, generation: 200},
        allocator:  ?undescribed.allocator,
        request_id: view.view("request-200", 11),
        route_name: view.view(nil, 0), started_ns: 10})
        || sink.start_calls != 4) { ret 17; }
    var undescribed_out_execution: middleware.Execution;
    undescribed_out_execution.active = false;
    val undescribed_out: middleware.Outcome = execute(?app, ?undescribed_out_execution,
        handler.Handler{ctx: nil, call: test_handler, resume: nil},
        ?undescribed.request_context);
    # a host clock that goes backwards cannot describe the request it served
    if (release_context(?app, ?undescribed.request_context,
        Termination{outcome: undescribed_out, reason: cancel.Reason.active{},
        status: 200, transfer: undescribed.exchange.completion,
        now_ns: 5})
        || sink.finish_calls != 2 || sink.error_calls != 2
        || sink.outcome != observability.OUTCOME_UNREPORTED
        || sink.kind != error.INTERNAL
        || active_request_count(?app) != 0 || !can_accept(?app)
        || !operation_ok(cancel.destroy(?undescribed.scope))) { ret 18; }

    # an outcome outside the execution vocabulary cannot be described either
    var unsettled: RequestFixture;
    var spare:     observability.Recorder;
    if (!request_fixture(?unsettled, 104, view.view("/orders", 7))) { ret 19; }
    if (!bind_context(?app, ?unsettled.request_context, ?spare,
        fixture_admission(?unsettled, 104, view.view("request-104", 11),
        view.view(nil, 0))) || sink.start_calls != 5) { ret 19; }
    if (release_context(?app, ?unsettled.request_context,
        Termination{outcome: middleware.Outcome{status: 0, action: 0, token: 0,
        app_error: error.make(error.INTERNAL, 500, "internal server error",
        "unmeasured", false),
        render_error: error.render_failure("unmeasured")},
        reason:       cancel.Reason.active{}, status: 0,
        transfer:     unsettled.exchange.completion, now_ns: 3})
        || sink.finish_calls != 2 || sink.error_calls != 3
        || sink.outcome != observability.OUTCOME_UNREPORTED
        || active_request_count(?app) != 0 || !can_accept(?app)
        || !operation_ok(cancel.destroy(?unsettled.scope))) { ret 20; }

    if (drain(?app, lifecycle.NO_DEADLINE).status != lifecycle.TRANSITION_OK
        || stop(?app).status != lifecycle.TRANSITION_OK || !release(?app)) {
        ret 21;
    }
    ret 0;
}

fun admit_at(app: *App, state: *RequestFixture, recorder: *observability.Recorder,
    generation: u64, has_deadline: bool, deadline: time.Time, started_ns: i64) bool {
    if (!request_fixture_until(state, generation, view.view("/orders", 7),
        has_deadline, deadline)) { ret false; }
    ret bind_context(app, ?state.request_context, recorder,
        Admission{exchange: ?state.exchange,
        params:     context.Params{items: nil, len: 0, generation: generation},
        allocator:  ?state.allocator, request_id: view.view("request", 7),
        route_name: view.view(nil, 0), started_ns: started_ns});
}

fun finish_at(app: *App, state: *RequestFixture, now_ns: i64) bool {
    var execution: middleware.Execution;
    execution.active = false;
    val outcome: middleware.Outcome = execute(app, ?execution,
        handler.Handler{ctx: nil, call: test_handler, resume: nil}, ?state.request_context);
    var status: u16 = 200;
    if (outcome.status == middleware.EXECUTION_CANCELLED) { status = 408; }
    ret release_context(app, ?state.request_context,
        Termination{outcome: outcome, reason: cancel.reason(?state.scope), status: status,
        transfer: state.exchange.completion, now_ns: now_ns})
        && operation_ok(cancel.destroy(?state.scope));
}

fun deadline_is(state: *RequestFixture, sec: i64, nsec: i64) bool {
    var at: time.Time;
    ret context.deadline(?state.request_context, ?at) && at.sec == sec && at.nsec == nsec;
}

test "laurel.app: the handler deadline narrows the exchange deadline from started_ns" {
    var providers: provider.Set;
    if (!provider.init(?providers, nil, 0, 0, 32)) { ret 1; }
    var lifecycle_item: lifecycle.Lifecycle = lifecycle.Lifecycle{ctx: nil,
        start: test_lifecycle_start, ready: test_lifecycle_ready,
        drain: test_lifecycle_drain, stop: test_lifecycle_stop};
    var controller: lifecycle.Controller;
    if (!lifecycle.init(?controller, ?lifecycle_item, 1, 1)) { ret 1; }
    var routes: router.Router;
    if (router.compile(?routes, nil, 0, router.Storage{specifications: nil, specification_cap: 0,
        compiled_routes: nil, compiled_route_cap: 0, segments: nil,
        segment_cap:     0},
        router.limits_default()).status != router.COMPILE_OK) { ret 1; }
    var middlewares: middleware.Stack = middleware.Stack{items: nil, len: 0};
    var headers:     security.HeadersPolicy;
    if (!security.secure_headers(?headers)) { ret 1; }
    var sink: EventSink;
    sink.start_calls  = 0;
    sink.finish_calls = 0;
    sink.error_calls  = 0;
    var observer: observability.Observer = observability.Observer{ctx: (?sink)::ptr,
        start: test_observer_start, finish: test_observer_finish,
        error: test_observer_error};
    var label_specs: [1]observability.LabelSpec;
    var vocabulary:  observability.Vocabulary;
    if (!test_vocabulary(?vocabulary, ?label_specs[0])) { ret 1; }
    var app: App;
    if (!observed_app(?app, ?providers, ?controller, ?routes, ?middlewares,
        ?headers, ?observer, ?vocabulary, 5000000000)
        || start(?app).status != lifecycle.TRANSITION_OK
        || poll_ready(?app).status != lifecycle.TRANSITION_OK) { ret 2; }
    var recorder: observability.Recorder;
    val none:     time.Time = time.Time{sec: 0, nsec: 0};

    # instants sit far past any real monotonic reading, since std expires a scope
    # whose deadline has already passed

    # with no exchange deadline the handler deadline is started_ns plus the limit
    var open: RequestFixture;
    if (!admit_at(?app, ?open, ?recorder, 300, false, none, 1000000010000000007)) { ret 3; }
    if (!deadline_is(?open, 1000000015, 7))                                       { ret 4; }
    if (!finish_at(?app, ?open, 1000000010000000008))                             { ret 5; }

    # an earlier exchange deadline is never widened
    var tight: RequestFixture;
    if (!admit_at(?app, ?tight, ?recorder, 301, true, time.Time{sec: 1000000012, nsec: 0},
        1000000010000000000)) { ret 6; }
    if (!deadline_is(?tight, 1000000012, 0))           { ret 7; }
    if (!finish_at(?app, ?tight, 1000000010000000001)) { ret 8; }

    # a later exchange deadline is narrowed to the handler deadline
    var loose: RequestFixture;
    if (!admit_at(?app, ?loose, ?recorder, 302, true, time.Time{sec: 1000000020, nsec: 0},
        1000000010000000000)) { ret 9; }
    if (!deadline_is(?loose, 1000000015, 0)) { ret 10; }

    # a timed out scope reports no deadline at all
    if (!transition_ok(cancel.timeout(?loose.scope)) || deadline_is(?loose, 1000000015, 0)) { ret 11; }
    if (!finish_at(?app, ?loose, 1000000010000000001))                                      { ret 12; }

    # a started_ns that is not a monotonic instant cannot base a deadline
    var negative: RequestFixture;
    if (admit_at(?app, ?negative, ?recorder, 303, false, none, -1)
        || negative.request_context.bound || active_request_count(?app) != 0
        || !operation_ok(cancel.destroy(?negative.scope))) { ret 13; }
    var overflow: RequestFixture;
    if (admit_at(?app, ?overflow, ?recorder, 304, false, none, 9223372036854775807)
        || overflow.request_context.bound || active_request_count(?app) != 0
        || !operation_ok(cancel.destroy(?overflow.scope))) { ret 14; }

    if (drain(?app, lifecycle.NO_DEADLINE).status != lifecycle.TRANSITION_OK
        || stop(?app).status != lifecycle.TRANSITION_OK || !release(?app)) { ret 15; }
    ret 0;
}
