# host-supplied read-only application configuration

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.size.usize;
use std.types.view;

pub val MAX_KEY_BYTES: usize = 128;

pub def Status: u8;
pub val READ_FOUND:     Status = 1;
pub val READ_MISSING:   Status = 2;
pub val READ_TOO_LARGE: Status = 3;
pub val READ_INVALID:   Status = 4;

pub rec Read {
    status: Status;
    len:    usize;
}

# copies the value for key into output; on READ_TOO_LARGE len is the size needed
pub def ReadFun: fun(ptr, view.View, *u8, usize) Read;

pub rec Provider {
    ctx:  ptr;
    read: ReadFun;
}

# the provider.Set key under which a host supplies a *Provider
pub fun key() view.View {
    ret view.view("laurel.config", 13);
}

# lowercase letters, digits, and . _ - with no leading, trailing, or doubled dot
pub fun key_valid(name: view.View) bool {
    if (name.len == 0 || name.len > MAX_KEY_BYTES || name.data == nil
        || name.data[0] == '.' || name.data[name.len - 1] == '.') { ret false; }
    var i: usize = 0;
    for (i < name.len) {
        val byte: u8 = name.data[i];
        if (!((byte >= 'a' && byte <= 'z') || (byte >= '0' && byte <= '9')
            || byte == '_' || byte == '-' || byte == '.')) { ret false; }
        if (byte == '.' && i > 0 && name.data[i - 1] == '.') { ret false; }
        i = i + 1;
    }
    ret true;
}

pub fun valid(provider: *Provider) bool {
    ret provider != nil && provider.read != nil;
}

pub fun read(provider: *Provider, name: view.View, output: *u8, capacity: usize) Read {
    if (!valid(provider) || !key_valid(name) || (capacity > 0 && output == nil)) {
        ret Read{status: READ_INVALID, len: 0};
    }
    val result: Read = provider.read(provider.ctx, name, output, capacity);
    if (result.status == READ_FOUND && result.len <= capacity)    { ret result; }
    if (result.status == READ_MISSING)                            { ret Read{status: READ_MISSING, len: 0}; }
    if (result.status == READ_TOO_LARGE && result.len > capacity) { ret result; }
    ret Read{status: READ_INVALID, len: 0};
}

#[testing]
fun test_read(context: ptr, name: view.View, output: *u8, capacity: usize) Read {
    if (name.len != 8 || name.data[0] != 't') { ret Read{status: READ_MISSING, len: 0}; }
    if (capacity < 3)                         { ret Read{status: READ_TOO_LARGE, len: 3}; }
    output[0] = '3';
    output[1] = '0';
    output[2] = '0';
    ret Read{status: READ_FOUND, len: 3};
}

#[testing]
fun test_lying_read(context: ptr, name: view.View, output: *u8, capacity: usize) Read {
    ret Read{status: READ_FOUND, len: capacity + 1};
}

test read__bounded_copy {
    var provider: Provider = Provider{ctx: nil, read: test_read};
    var output:   [8]u8;
    val found:    Read     = read(?provider, view.view("task.one", 8), ?output[0], 8);
    if (found.status != READ_FOUND || found.len != 3 || output[0] != '3') { ret 1; }
    val small: Read = read(?provider, view.view("task.one", 8), ?output[0], 2);
    if (small.status != READ_TOO_LARGE || small.len != 3)                                { ret 2; }
    if (read(?provider, view.view("other.it", 8), ?output[0], 8).status != READ_MISSING) { ret 3; }
    if (read(?provider, view.view("Task..x", 7), ?output[0], 8).status != READ_INVALID
        || read(?provider, view.view("task..x", 7), ?output[0], 8).status != READ_INVALID) { ret 4; }
    var lying: Provider = Provider{ctx: nil, read: test_lying_read};
    if (read(?lying, view.view("task.one", 8), ?output[0], 8).status != READ_INVALID) { ret 5; }
    ret 0;
}
