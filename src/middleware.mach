# resumable middleware and error execution

use http.core.body;
use http.core.exchange;
use http.core.field;
use http.core.message;
use http.core.method;
use http.core.target;
use laurel.context;
use laurel.error;
use laurel.handler;
use A: std.allocator;
use std.allocator.fixed;
use std.chrono.time;
use std.sync.cancel;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.view;

fun fixed_ok(outcome: err[A.Error]) bool {
    ret sel outcome.ok;
}

fun operation_ok(outcome: cancel.Operation) bool {
    ret sel outcome.ok;
}

fun transition_ok(outcome: cancel.Transition) bool {
    ret (sel outcome.ok) && outcome.ok;
}

fun scope_active(scope: *cancel.Scope) bool {
    val reason: cancel.Reason = cancel.reason(scope);
    ret sel reason.active;
}

pub def PanicPolicy: u8;
pub val PANIC_ABORT: PanicPolicy = 1;

pub def ExecutionStatus: u8;
pub val EXECUTION_RESPOND:        ExecutionStatus = 1;
pub val EXECUTION_NEXT:           ExecutionStatus = 2;
pub val EXECUTION_ERROR_RENDERED: ExecutionStatus = 3;
pub val EXECUTION_ERROR_UNMAPPED: ExecutionStatus = 4;
pub val EXECUTION_CANCELLED:      ExecutionStatus = 5;
pub val EXECUTION_PENDING:        ExecutionStatus = 6;

pub def Phase: u8;
pub val PHASE_IDLE:     Phase = 0;
pub val PHASE_BEFORE:   Phase = 1;
pub val PHASE_TERMINAL: Phase = 2;
pub val PHASE_AFTER:    Phase = 3;
pub val PHASE_DONE:     Phase = 4;

pub rec Policy {
    max_depth:    usize;
    panic_policy: PanicPolicy;
}

# a step's exit half. it gets the state its entry left and the result travelling
# outward, and returns the result that keeps travelling
pub def LeaveFun: fun(ptr, *context.Context, ptr, handler.Result) handler.Result;

# before runs on the way in, after on the way out, and after runs exactly once
# for every before that ran. resume re-enters a half that returned PENDING and
# may be nil on a step that never suspends, as may after
pub rec Middleware {
    ctx:    ptr;
    before: handler.EnterFun;
    resume: handler.ResumeFun;
    after:  LeaveFun;
}

pub rec Stack {
    items: *Middleware;
    len:   usize;
}

pub rec Outcome {
    status:       ExecutionStatus;
    action:       u8;
    token:        u64;
    app_error:    error.AppError;
    render_error: error.RenderFailure;
}

pub rec Slot {
    middleware: Middleware;
    state:      ptr;
}

# one request's position in the chain. the host owns this storage per exchange,
# because a suspended execution outlives the call that started it
pub rec Execution {
    terminal:       handler.Handler;
    terminal_state: ptr;
    context:        *context.Context;
    mapper:         error.Mapper;
    slots:          *Slot;
    len:            usize;
    cursor:         usize;
    pending_index:  usize;
    phase:          Phase;
    carry:          handler.Result;
    token:          u64;
    generation:     u64;
    execution_id:   u64;
    suspended:      bool;
    active:         bool;
}

pub fun policy_default() Policy {
    ret Policy{max_depth: 64, panic_policy: PANIC_ABORT};
}

fun internal(detail: str) error.AppError {
    ret error.make(error.INTERNAL, 500, "internal server error", detail, false);
}

fun unavailable(detail: str) error.AppError {
    ret error.make(error.UNAVAILABLE, 503, "service unavailable", detail, true);
}

fun cancellation(reason: cancel.Reason) error.AppError {
    if (sel reason.timed_out) {
        ret error.make(error.CANCELLED, 408, "request timed out",
            "request scope timed out", true);
    }
    ret error.make(error.CANCELLED, 408, "request cancelled",
        "request scope was cancelled", false);
}

fun current_cancellation(request_context: *context.Context) error.AppError {
    var reason: cancel.Reason = cancel.Reason.invalid{};
    if (request_context != nil) { reason = context.reason(request_context); }
    ret cancellation(reason);
}

fun outcome(status: ExecutionStatus, action: u8,
    app_error: error.AppError, render_error: error.RenderFailure) Outcome {
    ret Outcome{status: status, action: action, token: 0,
        app_error: app_error, render_error: render_error};
}

fun empty_render_failure() error.RenderFailure {
    ret error.render_failure(nil);
}

fun unmapped(app_error: error.AppError, detail: str) Outcome {
    ret outcome(EXECUTION_ERROR_UNMAPPED, 0, app_error,
        error.render_failure(detail));
}

fun map_error(app_error: error.AppError, mapper: error.Mapper,
    request_context: *context.Context) Outcome {
    if (app_error.kind == error.CANCELLED || !context.active(request_context)) {
        ret outcome(EXECUTION_CANCELLED, 0, app_error,
            empty_render_failure());
    }
    if (mapper.render == nil || !context.allocator_valid(request_context.alloc)) {
        ret unmapped(app_error, "error mapper unavailable");
    }
    val rendered: res[u8, error.RenderFailure] = mapper.render(mapper.ctx,
        app_error, request_context);
    if (sel rendered.err) {
        ret outcome(EXECUTION_ERROR_UNMAPPED, 0, app_error,
            rendered.err);
    }
    ret outcome(EXECUTION_ERROR_RENDERED, 0, app_error,
        empty_render_failure());
}

fun fault(execution: *Execution, app_error: error.AppError) {
    execution.carry = handler.fail(app_error);
    execution.phase = PHASE_AFTER;
}

fun unwind_cancelled(execution: *Execution) {
    fault(execution, current_cancellation(execution.context));
}

# a step's entry decided. its after already owes a run, so the cursor has moved
# past it before this is reached
fun settle_entry(execution: *Execution, index: usize,
    result: handler.Result) {
    if (sel result.err) {
        execution.carry = result;
        execution.phase = PHASE_AFTER;
        ret;
    }
    val disposition: handler.Disposition = result.ok;
    if (!handler.disposition_valid(disposition)) {
        fault(execution, internal("a middleware returned an invalid action"));
        ret;
    }
    if (disposition.action == handler.PENDING) {
        if (!context.active(execution.context)) {
            unwind_cancelled(execution);
            ret;
        }
        if (execution.slots[index].middleware.resume == nil) {
            fault(execution, internal("a middleware suspended with no resume"));
            ret;
        }
        execution.suspended     = true;
        execution.pending_index = index;
        execution.token         = disposition.token;
        execution.phase         = PHASE_BEFORE;
        ret;
    }
    if (!context.active(execution.context)) {
        unwind_cancelled(execution);
        ret;
    }
    if (disposition.action == handler.RESPOND) {
        execution.carry = result;
        execution.phase = PHASE_AFTER;
        ret;
    }
    if (execution.cursor == execution.len) { execution.phase = PHASE_TERMINAL; }
    or                                     { execution.phase = PHASE_BEFORE; }
}

fun settle_terminal(execution: *Execution, result: handler.Result) {
    if (sel result.err) {
        execution.carry = result;
        execution.phase = PHASE_AFTER;
        ret;
    }
    val disposition: handler.Disposition = result.ok;
    if (!handler.disposition_valid(disposition)) {
        fault(execution, internal("the terminal returned an invalid action"));
        ret;
    }
    if (disposition.action == handler.PENDING) {
        if (!context.active(execution.context)) {
            unwind_cancelled(execution);
            ret;
        }
        if (execution.terminal.resume == nil) {
            fault(execution, internal("the terminal suspended with no resume"));
            ret;
        }
        execution.suspended     = true;
        execution.pending_index = execution.len;
        execution.token         = disposition.token;
        execution.phase         = PHASE_TERMINAL;
        ret;
    }
    if (!context.active(execution.context)) {
        unwind_cancelled(execution);
        ret;
    }
    execution.carry = result;
    execution.phase = PHASE_AFTER;
}

# an exit half decided. a cancelled scope replaces whatever was travelling, but
# the remaining exit halves still run
fun settle_after(execution: *Execution, index: usize,
    result: handler.Result) {
    if (sel result.ok) {
        val disposition: handler.Disposition = result.ok;
        if (!handler.disposition_valid(disposition)) {
            execution.carry = handler.fail(
                internal("a middleware returned an invalid action"));
            execution.cursor = index;
            ret;
        }
        if (disposition.action == handler.PENDING) {
            if (!context.active(execution.context)) {
                execution.carry = handler.fail(
                    current_cancellation(execution.context));
                execution.cursor = index;
                ret;
            }
            if (execution.slots[index].middleware.resume == nil) {
                execution.carry = handler.fail(
                    internal("a middleware suspended with no resume"));
                execution.cursor = index;
                ret;
            }
            execution.suspended     = true;
            execution.pending_index = index;
            execution.token         = disposition.token;
            execution.phase         = PHASE_AFTER;
            ret;
        }
    }
    execution.carry  = result;
    execution.cursor = index;
    if (!context.active(execution.context)) {
        execution.carry = handler.fail(current_cancellation(execution.context));
    }
}

fun step_before(execution: *Execution) {
    if (execution.suspended || execution.phase != PHASE_BEFORE) { ret; }
    if (!context.active(execution.context)) {
        unwind_cancelled(execution);
        ret;
    }
    val index: usize = execution.cursor;
    if (execution.slots == nil || index >= execution.len) {
        fault(execution, internal("the middleware snapshot is unavailable"));
        ret;
    }
    val slot: *Slot = ?execution.slots[index];
    if (slot.middleware.before == nil) {
        fault(execution, internal("a middleware before callback is missing"));
        ret;
    }
    var state:  ptr            = nil;
    val result: handler.Result = slot.middleware.before(slot.middleware.ctx,
        execution.context, ?state);
    slot.state       = state;
    execution.cursor = index + 1;
    settle_entry(execution, index, result);
}

fun step_terminal(execution: *Execution) {
    if (execution.suspended || execution.phase != PHASE_TERMINAL) { ret; }
    if (!context.active(execution.context)) {
        unwind_cancelled(execution);
        ret;
    }
    if (execution.terminal.call == nil) {
        fault(execution, internal("the terminal callback is missing"));
        ret;
    }
    var state:  ptr            = nil;
    val result: handler.Result = execution.terminal.call(execution.terminal.ctx,
        execution.context, ?state);
    execution.terminal_state = state;
    settle_terminal(execution, result);
}

fun step_after(execution: *Execution) {
    if (execution.suspended || execution.phase != PHASE_AFTER) { ret; }
    if (execution.cursor == 0) {
        execution.phase = PHASE_DONE;
        ret;
    }
    val index: usize = execution.cursor - 1;
    if (execution.slots == nil || index >= execution.len) {
        execution.carry = handler.fail(
            internal("the middleware snapshot is unavailable"));
        execution.cursor = 0;
        ret;
    }
    val slot: *Slot = ?execution.slots[index];
    if (slot.middleware.after == nil) {
        execution.cursor = index;
        ret;
    }
    val result: handler.Result = slot.middleware.after(slot.middleware.ctx,
        execution.context, slot.state, execution.carry);
    settle_after(execution, index, result);
}

fun pending_outcome(execution: *Execution) Outcome {
    ret Outcome{status: EXECUTION_PENDING, action: handler.PENDING,
        token:        execution.token, app_error: error.no_error(),
        render_error: empty_render_failure()};
}

fun finished_outcome(execution: *Execution) Outcome {
    execution.active = false;
    context.release_execution(execution.context, execution.execution_id);
    if (sel execution.carry.err) {
        ret map_error(execution.carry.err, execution.mapper,
            execution.context);
    }
    val disposition: handler.Disposition = execution.carry.ok;
    if (disposition.action == handler.RESPOND) {
        ret outcome(EXECUTION_RESPOND, handler.RESPOND, error.no_error(),
            empty_render_failure());
    }
    ret outcome(EXECUTION_NEXT, handler.NEXT, error.no_error(),
        empty_render_failure());
}

fun pump(execution: *Execution) Outcome {
    for (!execution.suspended && execution.phase != PHASE_DONE) {
        step_before(execution);
        step_terminal(execution);
        step_after(execution);
    }
    if (execution.suspended) { ret pending_outcome(execution); }
    ret finished_outcome(execution);
}

fun clear_execution(execution: *Execution) {
    execution.terminal       = handler.Handler{ctx: nil, call: nil, resume: nil};
    execution.terminal_state = nil;
    execution.context        = nil;
    execution.mapper         = error.Mapper{ctx: nil, render: nil};
    execution.slots          = nil;
    execution.len            = 0;
    execution.cursor         = 0;
    execution.pending_index  = 0;
    execution.phase          = PHASE_IDLE;
    execution.carry          = handler.proceed();
    execution.token          = 0;
    execution.generation     = 0;
    execution.execution_id   = 0;
    execution.suspended      = false;
    execution.active         = false;
}

fun claimed(execution: *Execution, request_context: *context.Context) bool {
    ret execution != nil && execution.active && execution.context != nil
        && execution.context == request_context
        && execution.generation != 0 && execution.execution_id != 0
        && request_context.generation == execution.generation
        && context.active_execution(request_context, execution.generation,
        execution.execution_id) == execution::ptr;
}

fun snapshot(execution: *Execution, items: *Middleware, len: usize) bool {
    if (len == 0) { ret true; }
    val allocation: res[*Slot, A.Error] =
        A.allocate[Slot](execution.context.alloc, len);
    if (sel allocation.err) { ret false; }
    execution.slots = allocation.ok;
    var i: usize = 0;
    for (i < len) {
        execution.slots[i].middleware = items[i];
        execution.slots[i].state      = nil;
        i                             = i + 1;
    }
    ret true;
}

# the first entry. the execution record belongs to the host and is live from
# here until a terminal outcome, across any number of suspensions
pub fun execute(execution: *Execution, stack: *Stack,
    terminal: handler.Handler, mapper: error.Mapper,
    request_context: *context.Context, policy: Policy) Outcome {
    if (execution == nil) {
        ret unmapped(internal("middleware execution storage is missing"),
            "middleware execution storage is missing");
    }
    if (execution.active) {
        ret unmapped(internal("middleware execution storage is in use"),
            "middleware execution storage is in use");
    }
    clear_execution(execution);
    if (request_context != nil) {
        val reason: cancel.Reason = context.reason(request_context);
        if ((sel reason.cancelled) || (sel reason.timed_out)) {
            ret outcome(EXECUTION_CANCELLED, 0, cancellation(reason),
                empty_render_failure());
        }
    }
    if (request_context == nil || !context.active(request_context)
        || !context.allocator_valid(request_context.alloc)) {
        ret unmapped(internal("invalid middleware policy or input"),
            "error mapper unavailable");
    }
    var source_items:   *Middleware = nil;
    var source_len:     usize       = 0;
    val stack_supplied: bool        = stack != nil;
    if (stack_supplied) {
        source_items = stack.items;
        source_len   = stack.len;
    }
    execution.terminal   = terminal;
    execution.context    = request_context;
    execution.mapper     = mapper;
    execution.len        = source_len;
    execution.generation = request_context.generation;
    execution.carry      = handler.proceed();
    execution.active     = true;
    if (!stack_supplied || (source_len != 0 && source_items == nil)
        || terminal.call == nil || policy.max_depth == 0
        || source_len > policy.max_depth || policy.panic_policy != PANIC_ABORT
        || mapper.render == nil) {
        execution.active = false;
        ret map_error(internal("invalid middleware policy or input"), mapper,
            request_context);
    }
    var i: usize = 0;
    for (i < source_len) {
        if (source_items[i].before == nil) {
            execution.active = false;
            ret map_error(internal("a middleware before callback is missing"),
                mapper, request_context);
        }
        i = i + 1;
    }
    var execution_id: u64 = 0;
    if (!context.claim_execution(request_context, execution::ptr,
        ?execution_id)) {
        execution.active = false;
        ret unmapped(internal("middleware context already executing"),
            "middleware context already executing");
    }
    execution.execution_id = execution_id;
    if (!snapshot(execution, source_items, source_len)) {
        execution.carry = handler.fail(
            unavailable("middleware snapshot allocation failed"));
        execution.len   = 0;
        execution.phase = PHASE_DONE;
        ret finished_outcome(execution);
    }
    if (source_len == 0) { execution.phase = PHASE_TERMINAL; }
    or                   { execution.phase = PHASE_BEFORE; }
    ret pump(execution);
}

fun stale(request_context: *context.Context) Outcome {
    ret unmapped(internal("the middleware execution is not suspended here"),
        "the middleware execution is not suspended here");
}

fun enter_resume(execution: *Execution,
    settlement: handler.Settlement) Outcome {
    val index: usize = execution.pending_index;
    val token: u64   = execution.token;
    val phase: Phase = execution.phase;
    execution.suspended = false;
    execution.token     = 0;
    var result: handler.Result = handler.proceed();
    if (phase == PHASE_TERMINAL) {
        result = execution.terminal.resume(execution.terminal.ctx,
            execution.context, execution.terminal_state, settlement, token);
    }
    or {
        val slot: *Slot = ?execution.slots[index];
        result = slot.middleware.resume(slot.middleware.ctx, execution.context,
            slot.state, settlement, token);
    }
    if (settlement == handler.SETTLE_ABANDONED) {
        var app_error: error.AppError = current_cancellation(execution.context);
        if (sel result.ok) {
            if (result.ok.action == handler.PENDING) {
                app_error = internal(
                    "a middleware suspended again while being abandoned");
            }
        }
        execution.carry = handler.fail(app_error);
        if (phase == PHASE_AFTER) { execution.cursor = index; }
        or                        { execution.phase = PHASE_AFTER; }
        ret pump(execution);
    }
    if (phase == PHASE_TERMINAL) { settle_terminal(execution, result); }
    or {
        if (phase == PHASE_AFTER) { settle_after(execution, index, result); }
        or                        { settle_entry(execution, index, result); }
    }
    ret pump(execution);
}

# the suspended step is re-entered, and nothing that already ran runs again. a
# scope that died while the request was suspended abandons instead
pub fun resume(execution: *Execution,
    request_context: *context.Context) Outcome {
    if (!claimed(execution, request_context) || !execution.suspended) {
        ret stale(request_context);
    }
    if (!context.active(request_context)) {
        ret enter_resume(execution, handler.SETTLE_ABANDONED);
    }
    ret enter_resume(execution, handler.SETTLE_READY);
}

# the request is going away while a step holds it. the suspended step is entered
# once to release, every exit half that is owed still runs, and the execution
# reaches a terminal outcome so the host can release the context
pub fun abandon(execution: *Execution,
    request_context: *context.Context) Outcome {
    if (!claimed(execution, request_context)) { ret stale(request_context); }
    # abandonment is cancellation stated plainly, so the scope says so too and
    # every observer of this request describes the same thing
    if (context.active(request_context)) {
        transition_ok(cancel.cancel(request_context.scope));
    }
    if (!execution.suspended) {
        execution.carry = handler.fail(current_cancellation(request_context));
        execution.phase = PHASE_AFTER;
        ret pump(execution);
    }
    ret enter_resume(execution, handler.SETTLE_ABANDONED);
}

pub fun suspended(execution: *Execution) bool {
    ret execution != nil && execution.active && execution.suspended;
}

# the body token a suspended execution is waiting on, zero when it is not
pub fun pending_token(execution: *Execution) u64 {
    if (!suspended(execution)) { ret 0; }
    ret execution.token;
}

rec Fixture {
    limits:            message.Limits;
    scope:             cancel.Scope;
    request_body:      body.Reader;
    request_fields:    [1]field.Field;
    request_trailers:  [1]field.Field;
    request:           message.Request;
    response_fields:   [8]field.Field;
    response_trailers: [4]field.Field;
    response:          message.Response;
    informationals:    [4]message.Informational;
    exchange:          exchange.Exchange;
    allocation_bytes:  [32768]u8;
    allocation_state:  fixed.FixedState;
    allocator:         A.Allocator;
    request_context:   context.Context;
}

rec Trace {
    events:         [32]u8;
    len:            usize;
    terminal_calls: usize;
}

rec MutableError {
    message: [14]u8;
}

rec StackMutation {
    trace:             *Trace;
    stack:             *Stack;
    replacement_items: *Middleware;
    replacement_len:   usize;
}

rec Reentrant {
    trace:        *Trace;
    stack:        *Stack;
    terminal:     handler.Handler;
    mapper:       error.Mapper;
    inner:        *Execution;
    calls:        usize;
    inner_status: ExecutionStatus;
}

rec ReentrantMapper {
    stack:        *Stack;
    terminal:     handler.Handler;
    inner:        *Execution;
    calls:        usize;
    inner_status: ExecutionStatus;
}

# per-request state a step leaves in its driver slot, allocated from the request
# arena so it survives a suspension
rec Work {
    done:    usize;
    resumes: usize;
    carried: handler.Result;
}

rec Suspender {
    trace:      *Trace;
    suspends:   usize;
    entries:    usize;
    work:       usize;
    resumes:    usize;
    settlement: handler.Settlement;
    token:      u64;
}

rec Halves {
    trace:  *Trace;
    before: u8;
    after:  u8;
    action: u8;
    states: usize;
    token:  u64;
}

fun fixture_init(fixture: *Fixture, generation: u64) bool {
    if (fixture == nil || generation == 0) { ret false; }
    fixture.limits = message.limits_default();
    if (!operation_ok(cancel.make_root(?fixture.scope, opt[time.Instant].none{}))) { ret false; }
    fixture.request_body = body.empty_reader(generation);
    val request_fields: field.Fields = field.init(?fixture.request_fields[0], 1,
        fixture.limits.request_fields);
    val request_trailers: field.Fields = field.init(?fixture.request_trailers[0], 1,
        fixture.limits.request_trailers);
    val metadata: message.Metadata = message.Metadata{
        version:     message.version_h1(1, 1), secure: true, early_data: false,
        peer:        message.unspecified_endpoint(), local: message.unspecified_endpoint(),
        received_at: time.Time{sec: 1, nsec: 0}, deadline: opt[time.Instant].none{}, request_index: generation,
    };
    if (!message.init_request(?fixture.request,
        method.from_kind(method.GET),
        target.origin(view.view("/", 1), view.view("/", 1),
        view.view(nil, 0)), metadata, request_fields, request_trailers,
        ?fixture.request_body, generation, fixture.limits)
        || !message.init_response(?fixture.response,
        ?fixture.response_fields[0], 8, ?fixture.response_trailers[0], 4,
        generation, fixture.limits)
        || !exchange.init(?fixture.exchange, ?fixture.request,
        ?fixture.response, ?fixture.informationals[0], 4,
        ?fixture.scope, generation, fixture.limits)
        || !exchange.begin(?fixture.exchange)
        || !fixed_ok(fixed.make(?fixture.allocator,
        ?fixture.allocation_state, ?fixture.allocation_bytes[0], 32768))
        || !context.bind(?fixture.request_context, ?fixture.exchange,
        context.Params{items: nil, len: 0, generation: generation},
        8, ?fixture.allocator, fixture::ptr, 1, nil,
        view.view("request", 7), 64)) { ret false; }
    ret true;
}

fun fixture_end(fixture: *Fixture) bool {
    if (fixture == nil) { ret false; }
    if (fixture.request_context.bound
        && !context.unbind(?fixture.request_context, fixture::ptr, 1)) { ret false; }
    if (scope_active(?fixture.scope)
        && !transition_ok(cancel.cancel(?fixture.scope))) { ret false; }
    ret operation_ok(cancel.destroy(?fixture.scope));
}

fun record(trace: *Trace, event: u8) bool {
    if (trace == nil || trace.len >= 32) { ret false; }
    trace.events[trace.len] = event;
    trace.len               = trace.len + 1;
    ret true;
}

fun trace_error(detail: str) handler.Result {
    ret handler.fail(internal(detail));
}

fun first_before(ctx: ptr, request_context: *context.Context,
    state: *ptr) handler.Result {
    val trace: *Trace = ctx::*Trace;
    if (!record(trace, 1)) { ret trace_error("trace overflow"); }
    ret handler.proceed();
}

fun first_after(ctx: ptr, request_context: *context.Context, state: ptr,
    carried: handler.Result) handler.Result {
    val trace: *Trace = ctx::*Trace;
    if (!record(trace, 5)) { ret trace_error("trace overflow"); }
    ret carried;
}

fun second_before(ctx: ptr, request_context: *context.Context,
    state: *ptr) handler.Result {
    val trace: *Trace = ctx::*Trace;
    if (!record(trace, 2)) { ret trace_error("trace overflow"); }
    ret handler.proceed();
}

fun second_after(ctx: ptr, request_context: *context.Context, state: ptr,
    carried: handler.Result) handler.Result {
    val trace: *Trace = ctx::*Trace;
    if (!record(trace, 4)) { ret trace_error("trace overflow"); }
    ret carried;
}

fun traced_terminal(ctx: ptr, request_context: *context.Context,
    state: *ptr) handler.Result {
    val trace: *Trace = ctx::*Trace;
    trace.terminal_calls = trace.terminal_calls + 1;
    if (!record(trace, 3)) { ret trace_error("trace overflow"); }
    ret handler.respond();
}

fun short_before(ctx: ptr, request_context: *context.Context,
    state: *ptr) handler.Result {
    val trace: *Trace = ctx::*Trace;
    if (!record(trace, 7)) { ret trace_error("trace overflow"); }
    ret handler.respond();
}

fun invalid_terminal(ctx: ptr, request_context: *context.Context,
    state: *ptr) handler.Result {
    val trace: *Trace = ctx::*Trace;
    trace.terminal_calls = trace.terminal_calls + 1;
    ret handler.Result.ok{handler.Disposition{action: 99, token: 0}};
}

fun private_error_terminal(ctx: ptr, request_context: *context.Context,
    state: *ptr) handler.Result {
    ret handler.fail(error.make(error.INTERNAL, 500,
        "unsafe public text", "top-secret database detail", false));
}

fun mutable_error_terminal(ctx: ptr, request_context: *context.Context,
    state: *ptr) handler.Result {
    val source: *MutableError = ctx::*MutableError;
    ret handler.fail(error.make_view(error.CONFLICT, 418,
        view.view(?source.message[0], 14),
        view.view("private detail", 14), false));
}

fun inner_error_before(ctx: ptr, request_context: *context.Context,
    state: *ptr) handler.Result {
    val trace: *Trace = ctx::*Trace;
    if (!record(trace, 2)) { ret trace_error("trace overflow"); }
    ret handler.fail(error.make(error.FORBIDDEN, 403,
        "inner forbidden", "inner private detail", false));
}

fun replace_error_before(ctx: ptr, request_context: *context.Context,
    state: *ptr) handler.Result {
    val trace: *Trace = ctx::*Trace;
    if (!record(trace, 1)) { ret trace_error("trace overflow"); }
    ret handler.proceed();
}

fun replace_error_after(ctx: ptr, request_context: *context.Context,
    state: ptr, carried: handler.Result) handler.Result {
    val trace: *Trace = ctx::*Trace;
    if (!record(trace, 3)) { ret trace_error("trace overflow"); }
    if (sel carried.err) {
        ret handler.fail(error.make(error.CONFLICT, 409,
            "outer conflict", "outer private detail", false));
    }
    ret carried;
}

fun cancel_before(ctx: ptr, request_context: *context.Context,
    state: *ptr) handler.Result {
    val trace: *Trace = ctx::*Trace;
    if (!record(trace, 1) || !transition_ok(cancel.cancel(request_context.scope))) {
        ret trace_error("cancellation failed");
    }
    ret handler.proceed();
}

fun cancel_after(ctx: ptr, request_context: *context.Context, state: ptr,
    carried: handler.Result) handler.Result {
    val trace: *Trace = ctx::*Trace;
    if (!record(trace, 2)) { ret trace_error("trace overflow"); }
    ret carried;
}

fun mutate_stack_before(ctx: ptr, request_context: *context.Context,
    state: *ptr) handler.Result {
    val mutation: *StackMutation = ctx::*StackMutation;
    if (mutation == nil || mutation.stack == nil || mutation.trace == nil
        || !record(mutation.trace, 8)) {
        ret trace_error("invalid stack mutation test");
    }
    mutation.stack.items = mutation.replacement_items;
    mutation.stack.len   = mutation.replacement_len;
    ret handler.proceed();
}

fun reentrant_before(ctx: ptr, request_context: *context.Context,
    state: *ptr) handler.Result {
    val reentrant: *Reentrant = ctx::*Reentrant;
    if (reentrant == nil || reentrant.stack == nil || reentrant.trace == nil) {
        ret trace_error("invalid reentrant test");
    }
    val inner: Outcome = execute(reentrant.inner, reentrant.stack,
        reentrant.terminal, reentrant.mapper, request_context,
        policy_default());
    reentrant.calls        = reentrant.calls + 1;
    reentrant.inner_status = inner.status;
    if (inner.status != EXECUTION_ERROR_UNMAPPED) {
        ret trace_error("reentrant execution was accepted");
    }
    ret handler.proceed();
}

fun failing_mapper(ctx: ptr, app_error: error.AppError,
    request_context: *context.Context) res[u8, error.RenderFailure] {
    val failure: error.RenderFailure = error.render_failure(
        "mapper stack-local failure");
    ret res[u8, error.RenderFailure].err{failure};
}

fun reentrant_mapper(ctx: ptr, app_error: error.AppError,
    request_context: *context.Context) res[u8, error.RenderFailure] {
    val reentrant: *ReentrantMapper = ctx::*ReentrantMapper;
    if (reentrant == nil || reentrant.stack == nil) {
        ret res[u8, error.RenderFailure].err{error.render_failure(
            "invalid reentrant mapper test")};
    }
    val inner: Outcome = execute(reentrant.inner, reentrant.stack,
        reentrant.terminal, error.Mapper{ctx: nil, render: failing_mapper},
        request_context, policy_default());
    reentrant.calls        = reentrant.calls + 1;
    reentrant.inner_status = inner.status;
    ret res[u8, error.RenderFailure].err{error.render_failure(
        "mapper stack-local failure")};
}

fun suspending_terminal(ctx: ptr, request_context: *context.Context,
    state: *ptr) handler.Result {
    val suspender: *Suspender = ctx::*Suspender;
    suspender.entries = suspender.entries + 1;
    val allocation: res[*Work, A.Error] =
        A.allocate[Work](request_context.alloc, 1);
    if (sel allocation.err) { ret trace_error("work allocation failed"); }
    val work: *Work = allocation.ok;
    work.done    = 0;
    work.resumes = 0;
    work.carried = handler.proceed();
    @state       = work::ptr;
    if (!record(suspender.trace, 3)) { ret trace_error("trace overflow"); }
    suspender.work = suspender.work + 1;
    if (suspender.suspends == 0) { ret handler.respond(); }
    work.done = 1;
    ret handler.suspend(1001);
}

fun suspending_resume(ctx: ptr, request_context: *context.Context,
    state: ptr, settlement: handler.Settlement, token: u64) handler.Result {
    val suspender: *Suspender = ctx::*Suspender;
    val work:      *Work      = state::*Work;
    suspender.entries    = suspender.entries + 1;
    suspender.settlement = settlement;
    suspender.token      = token;
    if (work == nil || work.done != 1) {
        ret trace_error("terminal state did not survive the suspension");
    }
    work.resumes      = work.resumes + 1;
    suspender.resumes = work.resumes;
    if (settlement == handler.SETTLE_ABANDONED) {
        if (!record(suspender.trace, 9)) { ret trace_error("trace overflow"); }
        ret handler.respond();
    }
    if (work.resumes < suspender.suspends) {
        ret handler.suspend(1001 + work.resumes);
    }
    if (!record(suspender.trace, 6)) { ret trace_error("trace overflow"); }
    ret handler.respond();
}

fun no_resume_terminal(ctx: ptr, request_context: *context.Context,
    state: *ptr) handler.Result {
    ret handler.suspend(7);
}

# a middleware that suspends in whichever half the test arms
fun halves_before(ctx: ptr, request_context: *context.Context,
    state: *ptr) handler.Result {
    val halves: *Halves = ctx::*Halves;
    if (!record(halves.trace, halves.before)) { ret trace_error("trace overflow"); }
    val allocation: res[*Work, A.Error] =
        A.allocate[Work](request_context.alloc, 1);
    if (sel allocation.err) { ret trace_error("work allocation failed"); }
    val work: *Work = allocation.ok;
    work.done     = 1;
    work.resumes  = 0;
    work.carried  = handler.proceed();
    @state        = work::ptr;
    halves.states = halves.states + 1;
    if (halves.action == 1) { ret handler.suspend(2001); }
    ret handler.proceed();
}

fun halves_after(ctx: ptr, request_context: *context.Context, state: ptr,
    carried: handler.Result) handler.Result {
    val halves: *Halves = ctx::*Halves;
    val work:   *Work   = state::*Work;
    if (work == nil || work.done != 1) {
        ret trace_error("middleware state did not survive");
    }
    if (!record(halves.trace, halves.after)) { ret trace_error("trace overflow"); }
    if (halves.action == 2 && work.resumes == 0) {
        work.resumes = 1;
        work.carried = carried;
        ret handler.suspend(2002);
    }
    ret carried;
}

fun halves_resume(ctx: ptr, request_context: *context.Context, state: ptr,
    settlement: handler.Settlement, token: u64) handler.Result {
    val halves: *Halves = ctx::*Halves;
    val work:   *Work   = state::*Work;
    if (work == nil || work.done != 1) {
        ret trace_error("middleware state did not survive");
    }
    if (!record(halves.trace, 10)) { ret trace_error("trace overflow"); }
    halves.token = token;
    if (settlement == handler.SETTLE_ABANDONED) { ret handler.respond(); }
    # an exit half that suspends owns the result it was carrying
    if (halves.action == 2) { ret work.carried; }
    ret handler.proceed();
}

fun response_text(fixture: *Fixture, output: *u8,
    output_capacity: usize, output_len: *usize) bool {
    if (fixture == nil || output == nil || output_len == nil
        || fixture.response.body_kind != message.BODY_READER
        || fixture.response.body_reader == nil) { ret false; }
    val read: body.Progress = body.read(fixture.response.body_reader,
        output, output_capacity);
    if (read.status != body.DATA || read.count == 0) { ret false; }
    @output_len = read.count;
    val finished: body.Progress = body.read(fixture.response.body_reader,
        output, output_capacity);
    ret finished.status == body.COMPLETE;
}

fun bytes_equal(actual: *u8, actual_len: usize,
    expected: *u8, expected_len: usize) bool {
    if (actual_len != expected_len || actual == nil || expected == nil) { ret false; }
    var i: usize = 0;
    for (i < actual_len) {
        if (actual[i] != expected[i]) { ret false; }
        i = i + 1;
    }
    ret true;
}

fun default_error_mapper(fixture: *Fixture,
    renderer: *error.Default) error.Mapper {
    if (!error.initialize_default(renderer, fixture.limits, 128)) {
        ret error.Mapper{ctx: nil, render: nil};
    }
    ret error.default_mapper(renderer);
}

fun traced_handler(trace: *Trace) handler.Handler {
    ret handler.Handler{ctx: trace::ptr, call: traced_terminal, resume: nil};
}

fun traced_middleware(trace: *Trace, before: handler.EnterFun,
    after: LeaveFun) Middleware {
    ret Middleware{ctx: trace::ptr, before: before, resume: nil, after: after};
}

test "laurel.middleware: before terminal and after run once in order" {
    var fixture: Fixture;
    if (!fixture_init(?fixture, 31)) { ret 1; }
    var renderer: error.Default;
    val mapper:   error.Mapper = default_error_mapper(?fixture, ?renderer);
    if (mapper.render == nil) { ret 2; }
    var trace: Trace;
    var items: [2]Middleware;
    items[0] = traced_middleware(?trace, first_before, first_after);
    items[1] = traced_middleware(?trace, second_before, second_after);
    var stack:     Stack = Stack{items: ?items[0], len: 2};
    var execution: Execution;
    execution.active = false;
    val completed: Outcome = execute(?execution, ?stack, traced_handler(?trace),
        mapper, ?fixture.request_context, policy_default());
    if (completed.status != EXECUTION_RESPOND || trace.len != 5
        || trace.terminal_calls != 1 || trace.events[0] != 1
        || trace.events[1] != 2 || trace.events[2] != 3
        || trace.events[3] != 4 || trace.events[4] != 5
        || suspended(?execution) || pending_token(?execution) != 0) { ret 3; }

    # a short-circuiting before still owes its own after
    trace.len            = 0;
    trace.terminal_calls = 0;
    items[0]             = traced_middleware(?trace, short_before, first_after);
    stack.len            = 1;
    var shorted_execution: Execution;
    shorted_execution.active = false;
    val shorted: Outcome = execute(?shorted_execution, ?stack,
        traced_handler(?trace), mapper, ?fixture.request_context,
        policy_default());
    if (shorted.status != EXECUTION_RESPOND || trace.len != 2
        || trace.events[0] != 7 || trace.events[1] != 5
        || trace.terminal_calls != 0) { ret 4; }

    trace.len = 0;
    var invalid_execution: Execution;
    invalid_execution.active = false;
    val invalid: Outcome = execute(?invalid_execution, ?stack,
        traced_handler(?trace), mapper, ?fixture.request_context,
        Policy{max_depth: 1, panic_policy: 0});
    if (invalid.status != EXECUTION_ERROR_RENDERED
        || invalid.app_error.kind != error.INTERNAL
        || trace.terminal_calls != 0
        || fixture.response.status != 500) { ret 5; }
    var rendered:     [64]u8;
    var rendered_len: usize = 0;
    if (!response_text(?fixture, ?rendered[0], 64, ?rendered_len)
        || !bytes_equal(?rendered[0], rendered_len,
        "internal server error", 21) || !fixture_end(?fixture)) { ret 6; }
    ret 0;
}

test "laurel.middleware: private errors never render" {
    var private_fixture: Fixture;
    if (!fixture_init(?private_fixture, 42)) { ret 1; }
    var private_renderer: error.Default;
    val private_mapper:   error.Mapper = default_error_mapper(
        ?private_fixture, ?private_renderer);
    var empty_stack:      Stack = Stack{items: nil, len: 0};
    var hidden_execution: Execution;
    hidden_execution.active = false;
    val hidden: Outcome = execute(?hidden_execution, ?empty_stack,
        handler.Handler{ctx: nil, call: private_error_terminal, resume: nil},
        private_mapper, ?private_fixture.request_context, policy_default());
    var rendered:     [64]u8;
    var rendered_len: usize = 0;
    if (hidden.status != EXECUTION_ERROR_RENDERED
        || !response_text(?private_fixture, ?rendered[0], 64, ?rendered_len)
        || !bytes_equal(?rendered[0], rendered_len,
        "internal server error", 21) || !fixture_end(?private_fixture)) { ret 2; }

    var action_fixture: Fixture;
    if (!fixture_init(?action_fixture, 43)) { ret 3; }
    var action_renderer: error.Default;
    val action_mapper:   error.Mapper = default_error_mapper(
        ?action_fixture, ?action_renderer);
    var trace:            Trace;
    var action_execution: Execution;
    action_execution.active = false;
    val bad_action: Outcome = execute(?action_execution, ?empty_stack,
        handler.Handler{ctx: ?trace, call: invalid_terminal, resume: nil},
        action_mapper, ?action_fixture.request_context, policy_default());
    if (bad_action.status != EXECUTION_ERROR_RENDERED
        || bad_action.app_error.kind != error.INTERNAL
        || trace.terminal_calls != 1) { ret 4; }
    rendered_len = 0;
    if (!response_text(?action_fixture, ?rendered[0], 64, ?rendered_len)
        || !bytes_equal(?rendered[0], rendered_len,
        "internal server error", 21) || !fixture_end(?action_fixture)) { ret 5; }

    var copied_fixture: Fixture;
    if (!fixture_init(?copied_fixture, 44)) { ret 6; }
    var copied_renderer: error.Default;
    val copied_mapper:   error.Mapper = default_error_mapper(
        ?copied_fixture, ?copied_renderer);
    var source: MutableError;
    var i:      usize = 0;
    for (i < 14) {
        source.message[i] = "original error"[i];
        i                 = i + 1;
    }
    var copied_execution: Execution;
    copied_execution.active = false;
    val copied: Outcome = execute(?copied_execution, ?empty_stack,
        handler.Handler{ctx: ?source, call: mutable_error_terminal,
        resume: nil}, copied_mapper, ?copied_fixture.request_context,
        policy_default());
    i = 0;
    for (i < 14) {
        source.message[i] = 'x';
        i                 = i + 1;
    }
    rendered_len = 0;
    if (copied.status != EXECUTION_ERROR_RENDERED
        || copied_fixture.response.status != 409
        || !response_text(?copied_fixture, ?rendered[0], 64, ?rendered_len)
        || !bytes_equal(?rendered[0], rendered_len,
        "original error", 14)
        || !bytes_equal(error.public_text(?copied.app_error).data,
        error.public_text(?copied.app_error).len,
        "original error", 14)
        || !fixture_end(?copied_fixture)) { ret 7; }
    ret 0;
}

test "laurel.middleware: nested errors and cancellation unwind in order" {
    var fixture: Fixture;
    if (!fixture_init(?fixture, 51)) { ret 1; }
    var renderer: error.Default;
    val mapper:   error.Mapper = default_error_mapper(?fixture, ?renderer);
    var trace:    Trace;
    var items:    [2]Middleware;
    items[0] = traced_middleware(?trace, replace_error_before,
        replace_error_after);
    items[1] = traced_middleware(?trace, inner_error_before, nil);
    var stack:     Stack = Stack{items: ?items[0], len: 2};
    var execution: Execution;
    execution.active = false;
    val nested: Outcome = execute(?execution, ?stack, traced_handler(?trace),
        mapper, ?fixture.request_context, policy_default());
    if (nested.status != EXECUTION_ERROR_RENDERED
        || nested.app_error.kind != error.CONFLICT || trace.len != 3
        || trace.events[0] != 1 || trace.events[1] != 2
        || trace.events[2] != 3 || trace.terminal_calls != 0
        || fixture.response.status != 409) { ret 2; }
    var rendered:     [64]u8;
    var rendered_len: usize = 0;
    if (!response_text(?fixture, ?rendered[0], 64, ?rendered_len)
        || !bytes_equal(?rendered[0], rendered_len,
        "outer conflict", 14) || !fixture_end(?fixture)) { ret 3; }

    var cancelled_fixture: Fixture;
    if (!fixture_init(?cancelled_fixture, 52)) { ret 4; }
    var cancelled_renderer: error.Default;
    val cancelled_mapper:   error.Mapper = default_error_mapper(
        ?cancelled_fixture, ?cancelled_renderer);
    var cancelled_trace: Trace;
    var cancel_item:     Middleware = traced_middleware(?cancelled_trace,
        cancel_before, cancel_after);
    stack = Stack{items: ?cancel_item, len: 1};
    var cancelled_execution: Execution;
    cancelled_execution.active = false;
    val cancelled: Outcome = execute(?cancelled_execution, ?stack,
        traced_handler(?cancelled_trace), cancelled_mapper,
        ?cancelled_fixture.request_context, policy_default());
    if (cancelled.status != EXECUTION_CANCELLED
        || cancelled.app_error.kind != error.CANCELLED
        || cancelled_trace.len != 2 || cancelled_trace.events[0] != 1
        || cancelled_trace.events[1] != 2
        || cancelled_trace.terminal_calls != 0
        || cancelled_fixture.response.body_kind != message.BODY_NONE
        || !fixture_end(?cancelled_fixture)) { ret 5; }
    ret 0;
}

test "laurel.middleware: stack snapshots survive growth and shrinkage" {
    var shrink_fixture: Fixture;
    if (!fixture_init(?shrink_fixture, 61)) { ret 1; }
    var shrink_renderer: error.Default;
    val shrink_mapper:   error.Mapper = default_error_mapper(
        ?shrink_fixture, ?shrink_renderer);
    var shrink_trace: Trace;
    var shrink_stack: Stack;
    var shrink_state: StackMutation = StackMutation{trace: ?shrink_trace,
        stack: ?shrink_stack, replacement_items: nil, replacement_len: 0};
    var shrink_items: [2]Middleware;
    shrink_items[0] = Middleware{ctx: ?shrink_state, before: mutate_stack_before,
        resume: nil, after: nil};
    shrink_items[1] = traced_middleware(?shrink_trace, second_before,
        second_after);
    shrink_stack = Stack{items: ?shrink_items[0], len: 2};
    var shrink_execution: Execution;
    shrink_execution.active = false;
    val shrunk: Outcome = execute(?shrink_execution, ?shrink_stack,
        traced_handler(?shrink_trace), shrink_mapper,
        ?shrink_fixture.request_context, policy_default());
    if (shrunk.status != EXECUTION_RESPOND || shrink_trace.len != 4
        || shrink_trace.events[0] != 8 || shrink_trace.events[1] != 2
        || shrink_trace.events[2] != 3 || shrink_trace.events[3] != 4
        || shrink_trace.terminal_calls != 1 || !fixture_end(?shrink_fixture)) {
        ret 2;
    }

    var grow_fixture: Fixture;
    if (!fixture_init(?grow_fixture, 62)) { ret 3; }
    var grow_renderer: error.Default;
    val grow_mapper:   error.Mapper = default_error_mapper(
        ?grow_fixture, ?grow_renderer);
    var grow_trace:  Trace;
    var grow_stack:  Stack;
    var replacement: [2]Middleware;
    replacement[0] = traced_middleware(?grow_trace, short_before, nil);
    replacement[1] = traced_middleware(?grow_trace, short_before, nil);
    var grow_state: StackMutation = StackMutation{trace: ?grow_trace,
        stack:           ?grow_stack, replacement_items: ?replacement[0],
        replacement_len: 2};
    var grow_item: Middleware = Middleware{ctx: ?grow_state,
        before: mutate_stack_before, resume: nil, after: nil};
    grow_stack = Stack{items: ?grow_item, len: 1};
    var grow_execution: Execution;
    grow_execution.active = false;
    val grown: Outcome = execute(?grow_execution, ?grow_stack,
        traced_handler(?grow_trace), grow_mapper,
        ?grow_fixture.request_context, policy_default());
    if (grown.status != EXECUTION_RESPOND || grow_trace.len != 2
        || grow_trace.events[0] != 8 || grow_trace.events[1] != 3
        || grow_trace.terminal_calls != 1 || !fixture_end(?grow_fixture)) {
        ret 4;
    }
    ret 0;
}

test "laurel.middleware: reentrancy fails closed" {
    var reentrant_fixture: Fixture;
    if (!fixture_init(?reentrant_fixture, 72)) { ret 1; }
    var reentrant_renderer: error.Default;
    val reentrant_mapper:   error.Mapper = default_error_mapper(
        ?reentrant_fixture, ?reentrant_renderer);
    var reentrant_trace: Trace;
    var reentrant_stack: Stack;
    var inner_execution: Execution;
    inner_execution.active = false;
    var reentrant: Reentrant = Reentrant{trace: ?reentrant_trace,
        stack:        ?reentrant_stack, terminal: traced_handler(?reentrant_trace),
        mapper:       reentrant_mapper, inner: ?inner_execution, calls: 0,
        inner_status: 0};
    var reentrant_item: Middleware = Middleware{ctx: ?reentrant,
        before: reentrant_before, resume: nil, after: nil};
    reentrant_stack = Stack{items: ?reentrant_item, len: 1};
    var outer_execution: Execution;
    outer_execution.active = false;
    val first: Outcome = execute(?outer_execution, ?reentrant_stack,
        reentrant.terminal, reentrant_mapper,
        ?reentrant_fixture.request_context, policy_default());
    val second: Outcome = execute(?outer_execution, ?reentrant_stack,
        reentrant.terminal, reentrant_mapper,
        ?reentrant_fixture.request_context, policy_default());
    if (first.status != EXECUTION_RESPOND || second.status != EXECUTION_RESPOND
        || reentrant.calls != 2
        || reentrant.inner_status != EXECUTION_ERROR_UNMAPPED
        || reentrant_trace.terminal_calls != 2
        || !fixture_end(?reentrant_fixture)) { ret 2; }
    ret 0;
}

test "laurel.middleware: pre-cancel and allocator failures do not render" {
    var cancelled_fixture: Fixture;
    if (!fixture_init(?cancelled_fixture, 81)) { ret 1; }
    var cancelled_renderer: error.Default;
    val cancelled_mapper:   error.Mapper = default_error_mapper(
        ?cancelled_fixture, ?cancelled_renderer);
    var trace:       Trace;
    var empty_stack: Stack = Stack{items: nil, len: 0};
    if (!transition_ok(cancel.cancel(?cancelled_fixture.scope))) { ret 2; }
    var cancelled_execution: Execution;
    cancelled_execution.active = false;
    val cancelled: Outcome = execute(?cancelled_execution, ?empty_stack,
        traced_handler(?trace), cancelled_mapper,
        ?cancelled_fixture.request_context, policy_default());
    if (cancelled.status != EXECUTION_CANCELLED
        || cancelled.app_error.kind != error.CANCELLED
        || trace.terminal_calls != 0
        || cancelled_fixture.response.body_kind != message.BODY_NONE
        || !fixture_end(?cancelled_fixture)) { ret 3; }

    var timed_fixture: Fixture;
    if (!fixture_init(?timed_fixture, 82)) { ret 4; }
    var timed_renderer: error.Default;
    val timed_mapper:   error.Mapper = default_error_mapper(
        ?timed_fixture, ?timed_renderer);
    if (!transition_ok(cancel.timeout(?timed_fixture.scope))) { ret 5; }
    var timed_execution: Execution;
    timed_execution.active = false;
    val timed: Outcome = execute(?timed_execution, ?empty_stack,
        traced_handler(?trace), timed_mapper, ?timed_fixture.request_context,
        policy_default());
    if (timed.status != EXECUTION_CANCELLED
        || timed.app_error.kind != error.CANCELLED
        || timed.app_error.retryable == false || trace.terminal_calls != 0
        || timed_fixture.response.body_kind != message.BODY_NONE
        || !fixture_end(?timed_fixture)) { ret 6; }

    var allocator_fixture: Fixture;
    if (!fixture_init(?allocator_fixture, 83)) { ret 7; }
    var allocator_renderer: error.Default;
    val allocator_mapper:   error.Mapper = default_error_mapper(
        ?allocator_fixture, ?allocator_renderer);
    allocator_fixture.allocator.fn_allocate = nil;
    val direct: res[u8, error.RenderFailure] = allocator_mapper.render(
        allocator_mapper.ctx, internal("direct allocator test"),
        ?allocator_fixture.request_context);
    var allocator_execution: Execution;
    allocator_execution.active = false;
    val failed: Outcome = execute(?allocator_execution, ?empty_stack,
        traced_handler(?trace), allocator_mapper,
        ?allocator_fixture.request_context, policy_default());
    if ((sel direct.ok)
        || failed.status != EXECUTION_ERROR_UNMAPPED
        || allocator_fixture.response.body_kind != message.BODY_NONE
        || !fixture_end(?allocator_fixture)) { ret 8; }
    ret 0;
}

test "laurel.middleware: mapper failures are value owned" {
    var fixture: Fixture;
    if (!fixture_init(?fixture, 91)) { ret 1; }
    var empty_stack: Stack = Stack{items: nil, len: 0};
    var execution:   Execution;
    execution.active = false;
    val mapped: Outcome = execute(?execution, ?empty_stack,
        handler.Handler{ctx: nil, call: private_error_terminal, resume: nil},
        error.Mapper{ctx: nil, render: failing_mapper},
        ?fixture.request_context, policy_default());
    val detail: view.View = error.render_failure_view(?mapped.render_error);
    if (mapped.status != EXECUTION_ERROR_UNMAPPED
        || !bytes_equal(detail.data, detail.len,
        "mapper stack-local failure", 26)
        || !fixture_end(?fixture)) { ret 2; }

    var reentrant_fixture: Fixture;
    if (!fixture_init(?reentrant_fixture, 92)) { ret 3; }
    var reentrant_stack: Stack = Stack{items: nil, len: 0};
    var inner_execution: Execution;
    inner_execution.active = false;
    var mapper_state: ReentrantMapper = ReentrantMapper{
        stack:    ?reentrant_stack,
        terminal: handler.Handler{ctx: nil, call: private_error_terminal,
            resume: nil}, inner: ?inner_execution, calls: 0, inner_status: 0
    };
    var outer_execution: Execution;
    outer_execution.active = false;
    val reentrant: Outcome = execute(?outer_execution, ?reentrant_stack,
        mapper_state.terminal,
        error.Mapper{ctx: ?mapper_state, render: reentrant_mapper},
        ?reentrant_fixture.request_context, policy_default());
    if (reentrant.status != EXECUTION_ERROR_UNMAPPED
        || mapper_state.calls != 1
        || mapper_state.inner_status != EXECUTION_ERROR_UNMAPPED
        || !fixture_end(?reentrant_fixture)) { ret 4; }
    ret 0;
}

test "laurel.middleware: a resumed terminal never re-runs what already ran" {
    var fixture: Fixture;
    if (!fixture_init(?fixture, 101)) { ret 1; }
    var renderer: error.Default;
    val mapper:   error.Mapper = default_error_mapper(?fixture, ?renderer);
    var trace:    Trace;
    var items:    [2]Middleware;
    items[0] = traced_middleware(?trace, first_before, first_after);
    items[1] = traced_middleware(?trace, second_before, second_after);
    var stack:     Stack     = Stack{items: ?items[0], len: 2};
    var suspender: Suspender = Suspender{trace: ?trace, suspends: 3,
        entries: 0, work: 0, resumes: 0, settlement: 0, token: 0};
    var execution: Execution;
    execution.active = false;
    var current: Outcome = execute(?execution, ?stack,
        handler.Handler{ctx: ?suspender, call: suspending_terminal,
        resume: suspending_resume}, mapper, ?fixture.request_context,
        policy_default());
    if (current.status != EXECUTION_PENDING || current.token != 1001
        || pending_token(?execution) != 1001 || !suspended(?execution)
        || suspender.entries != 1 || suspender.work != 1) { ret 2; }

    # a suspended request still holds its context, so a host that drops it
    # without abandoning it cannot release the context behind laurel's back
    if (context.unbind(?fixture.request_context, (?fixture)::ptr, 1)) { ret 3; }

    current = resume(?execution, ?fixture.request_context);
    if (current.status != EXECUTION_PENDING || current.token != 1002
        || suspender.settlement != handler.SETTLE_READY
        || suspender.token != 1001) { ret 4; }
    current = resume(?execution, ?fixture.request_context);
    if (current.status != EXECUTION_PENDING || current.token != 1003) { ret 5; }
    current = resume(?execution, ?fixture.request_context);
    if (current.status != EXECUTION_RESPOND || current.action != handler.RESPOND
        || suspended(?execution) || pending_token(?execution) != 0) { ret 6; }

    # the terminal was entered once and resumed three times, and every half of
    # every middleware ran exactly once around all four entries
    if (suspender.work != 1 || suspender.entries != 4
        || suspender.resumes != 3 || trace.len != 6
        || trace.events[0] != 1 || trace.events[1] != 2
        || trace.events[2] != 3 || trace.events[3] != 6
        || trace.events[4] != 4 || trace.events[5] != 5) { ret 7; }
    if (!fixture_end(?fixture)) { ret 8; }
    ret 0;
}

test "laurel.middleware: an abandoned suspension releases every entered half" {
    var fixture: Fixture;
    if (!fixture_init(?fixture, 102)) { ret 1; }
    var renderer: error.Default;
    val mapper:   error.Mapper = default_error_mapper(?fixture, ?renderer);
    var trace:    Trace;
    var items:    [2]Middleware;
    items[0] = traced_middleware(?trace, first_before, first_after);
    items[1] = traced_middleware(?trace, second_before, second_after);
    var stack:     Stack     = Stack{items: ?items[0], len: 2};
    var suspender: Suspender = Suspender{trace: ?trace, suspends: 2,
        entries: 0, work: 0, resumes: 0, settlement: 0, token: 0};
    var execution: Execution;
    execution.active = false;
    val pending: Outcome = execute(?execution, ?stack,
        handler.Handler{ctx: ?suspender, call: suspending_terminal,
        resume: suspending_resume}, mapper, ?fixture.request_context,
        policy_default());
    if (pending.status != EXECUTION_PENDING) { ret 2; }
    val abandoned: Outcome = abandon(?execution, ?fixture.request_context);
    if (abandoned.status != EXECUTION_CANCELLED
        || abandoned.app_error.kind != error.CANCELLED
        || suspender.settlement != handler.SETTLE_ABANDONED
        || suspender.token != 1001 || suspender.entries != 2
        || suspender.work != 1 || trace.len != 6
        || trace.events[3] != 9 || trace.events[4] != 4
        || trace.events[5] != 5
        || fixture.response.body_kind != message.BODY_NONE) { ret 3; }
    # the context is releasable again once the execution has been wound up
    if (suspended(?execution) || !fixture_end(?fixture)) { ret 4; }
    ret 0;
}

test "laurel.middleware: a scope that dies under a suspension abandons" {
    var fixture: Fixture;
    if (!fixture_init(?fixture, 103)) { ret 1; }
    var renderer: error.Default;
    val mapper:   error.Mapper = default_error_mapper(?fixture, ?renderer);
    var trace:    Trace;
    var item:     Middleware   = traced_middleware(?trace, first_before,
        first_after);
    var stack:     Stack     = Stack{items: ?item, len: 1};
    var suspender: Suspender = Suspender{trace: ?trace, suspends: 2,
        entries: 0, work: 0, resumes: 0, settlement: 0, token: 0};
    var execution: Execution;
    execution.active = false;
    val pending: Outcome = execute(?execution, ?stack,
        handler.Handler{ctx: ?suspender, call: suspending_terminal,
        resume: suspending_resume}, mapper, ?fixture.request_context,
        policy_default());
    if (pending.status != EXECUTION_PENDING)           { ret 2; }
    if (!transition_ok(cancel.cancel(?fixture.scope))) { ret 3; }
    val cancelled: Outcome = resume(?execution, ?fixture.request_context);
    if (cancelled.status != EXECUTION_CANCELLED
        || suspender.settlement != handler.SETTLE_ABANDONED
        || suspender.entries != 2 || trace.len != 4
        || trace.events[3] != 5
        || fixture.response.body_kind != message.BODY_NONE
        || !fixture_end(?fixture)) { ret 4; }
    ret 0;
}

test "laurel.middleware: a middleware suspends in either half" {
    var fixture: Fixture;
    if (!fixture_init(?fixture, 104)) { ret 1; }
    var renderer: error.Default;
    val mapper:   error.Mapper = default_error_mapper(?fixture, ?renderer);
    var trace:    Trace;
    var halves:   Halves       = Halves{trace: ?trace, before: 11, after: 12,
        action: 1, states: 0, token: 0};
    var item: Middleware = Middleware{ctx: ?halves, before: halves_before,
        resume: halves_resume, after: halves_after};
    var stack:     Stack = Stack{items: ?item, len: 1};
    var execution: Execution;
    execution.active = false;
    var current: Outcome = execute(?execution, ?stack, traced_handler(?trace),
        mapper, ?fixture.request_context, policy_default());
    if (current.status != EXECUTION_PENDING || current.token != 2001
        || trace.terminal_calls != 0) { ret 2; }
    current = resume(?execution, ?fixture.request_context);
    if (current.status != EXECUTION_RESPOND || halves.token != 2001
        || halves.states != 1 || trace.terminal_calls != 1
        || trace.len != 4 || trace.events[0] != 11 || trace.events[1] != 10
        || trace.events[2] != 3 || trace.events[3] != 12) { ret 3; }
    if (!fixture_end(?fixture)) { ret 4; }

    var exit_fixture: Fixture;
    if (!fixture_init(?exit_fixture, 105)) { ret 5; }
    var exit_renderer: error.Default;
    val exit_mapper:   error.Mapper = default_error_mapper(?exit_fixture,
        ?exit_renderer);
    var exit_trace:  Trace;
    var exit_halves: Halves = Halves{trace: ?exit_trace, before: 11,
        after: 12, action: 2, states: 0, token: 0};
    var exit_item: Middleware = Middleware{ctx: ?exit_halves,
        before: halves_before, resume: halves_resume, after: halves_after};
    var exit_stack:     Stack = Stack{items: ?exit_item, len: 1};
    var exit_execution: Execution;
    exit_execution.active = false;
    var exit_current: Outcome = execute(?exit_execution, ?exit_stack,
        traced_handler(?exit_trace), exit_mapper,
        ?exit_fixture.request_context, policy_default());
    if (exit_current.status != EXECUTION_PENDING || exit_current.token != 2002
        || exit_trace.terminal_calls != 1) { ret 6; }
    exit_current = resume(?exit_execution, ?exit_fixture.request_context);
    if (exit_current.status != EXECUTION_RESPOND || exit_halves.token != 2002
        || exit_trace.len != 4 || exit_trace.events[0] != 11
        || exit_trace.events[1] != 3 || exit_trace.events[2] != 12
        || exit_trace.events[3] != 10
        || !fixture_end(?exit_fixture)) { ret 7; }
    ret 0;
}

test "laurel.middleware: suspending with no resume fails closed" {
    var fixture: Fixture;
    if (!fixture_init(?fixture, 106)) { ret 1; }
    var renderer: error.Default;
    val mapper:   error.Mapper = default_error_mapper(?fixture, ?renderer);
    var trace:    Trace;
    var item:     Middleware   = traced_middleware(?trace, first_before,
        first_after);
    var stack:     Stack = Stack{items: ?item, len: 1};
    var execution: Execution;
    execution.active = false;
    val refused: Outcome = execute(?execution, ?stack,
        handler.Handler{ctx: nil, call: no_resume_terminal, resume: nil},
        mapper, ?fixture.request_context, policy_default());
    if (refused.status != EXECUTION_ERROR_RENDERED
        || refused.app_error.kind != error.INTERNAL
        || suspended(?execution) || trace.len != 2
        || trace.events[1] != 5) { ret 2; }

    # a resume that nothing is waiting on is refused, and a settled execution
    # cannot be resumed a second time
    val stale_resume: Outcome = resume(?execution, ?fixture.request_context);
    if (stale_resume.status != EXECUTION_ERROR_UNMAPPED
        || !fixture_end(?fixture)) { ret 3; }
    ret 0;
}
