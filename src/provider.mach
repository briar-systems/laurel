# bounded caller-owned service providers

use R: std.types.result;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.size.usize;
use std.types.view;

pub def ResolveFun: fun(ptr, view.View) R.Result[ptr, view.View];

pub rec Provider {
    ctx:     ptr;
    resolve: ResolveFun;
}

pub rec Set {
    items:         *Provider;
    len:           usize;
    max_providers: usize;
    max_key_bytes: usize;
    valid:         bool;
}

pub fun init(set: *Set, items: *Provider, length: usize,
    max_providers: usize, max_key_bytes: usize) bool {
    if (set == nil || length > max_providers || max_key_bytes == 0
        || (length > 0 && items == nil)) { ret false; }
    var i: usize = 0;
    for (i < length) {
        if (items[i].resolve == nil) { ret false; }
        i = i + 1;
    }
    set.items = items;
    set.len = length;
    set.max_providers = max_providers;
    set.max_key_bytes = max_key_bytes;
    set.valid = true;
    ret true;
}

pub fun validate(set: *Set) bool {
    if (set == nil || !set.valid || set.len > set.max_providers || set.max_key_bytes == 0
        || (set.len > 0 && set.items == nil)) { ret false; }
    var i: usize = 0;
    for (i < set.len) {
        if (set.items[i].resolve == nil) { ret false; }
        i = i + 1;
    }
    ret true;
}

# an ok nil result means this provider does not own the key
pub fun resolve(set: *Set, key: view.View) R.Result[ptr, view.View] {
    if (!validate(set) || key.len == 0 || key.len > set.max_key_bytes || key.data == nil) {
        ret R.err[ptr, view.View](view.view("invalid provider key", 20));
    }
    var i: usize = 0;
    for (i < set.len) {
        val resolved: R.Result[ptr, view.View] = set.items[i].resolve(set.items[i].ctx, key);
        if (R.is_err[ptr, view.View](resolved)) { ret resolved; }
        val value: ptr = R.unwrap_ok[ptr, view.View](resolved);
        if (value != nil) { ret resolved; }
        i = i + 1;
    }
    ret R.err[ptr, view.View](view.view("provider not found", 18));
}

rec TestProvider {
    key:   view.View;
    value: ptr;
    calls: usize;
    fail:  bool;
}

fun view_equal(a: view.View, b: view.View) bool {
    if (a.len != b.len) { ret false; }
    var i: usize = 0;
    for (i < a.len) {
        if (a.data[i] != b.data[i]) { ret false; }
        i = i + 1;
    }
    ret true;
}

fun test_resolve(context: ptr, key: view.View) R.Result[ptr, view.View] {
    val state: *TestProvider = context::*TestProvider;
    state.calls = state.calls + 1;
    if (state.fail) { ret R.err[ptr, view.View](view.view("provider failed", 15)); }
    if (view_equal(state.key, key)) { ret R.ok[ptr, view.View](state.value); }
    ret R.ok[ptr, view.View](nil);
}

test "laurel.provider: resolution is ordered, bounded, and explicit" {
    var value: u8 = 7;
    var states: [2]TestProvider;
    states[0] = TestProvider{key: view.view("cache", 5), value: nil, calls: 0, fail: false};
    states[1] = TestProvider{key: view.view("database", 8), value: (?value)::ptr, calls: 0, fail: false};
    var items: [2]Provider;
    items[0] = Provider{ctx: (?states[0])::ptr, resolve: test_resolve};
    items[1] = Provider{ctx: (?states[1])::ptr, resolve: test_resolve};
    var set: Set;
    if (!init(?set, ?items[0], 2, 2, 8)) { ret 1; }
    val found: R.Result[ptr, view.View] = resolve(?set, view.view("database", 8));
    if (R.is_err[ptr, view.View](found) || R.unwrap_ok[ptr, view.View](found) != (?value)::ptr
        || states[0].calls != 1 || states[1].calls != 1) { ret 2; }
    val missing: R.Result[ptr, view.View] = resolve(?set, view.view("queue", 5));
    if (!R.is_err[ptr, view.View](missing)) { ret 3; }
    val oversized: R.Result[ptr, view.View] = resolve(?set, view.view("longer-key", 10));
    if (!R.is_err[ptr, view.View](oversized) || states[0].calls != 2 || states[1].calls != 2) { ret 4; }
    states[0].fail = true;
    val failed: R.Result[ptr, view.View] = resolve(?set, view.view("database", 8));
    if (!R.is_err[ptr, view.View](failed) || states[1].calls != 2) { ret 5; }
    ret 0;
}
