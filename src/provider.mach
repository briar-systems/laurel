# bounded caller-owned service providers

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.result.res;
use std.types.size.usize;
use std.types.view;

pub def ResolveFun: fun(ptr, view.View) res[ptr, view.View];

pub rec Provider {
    ctx:     ptr;
    resolve: ResolveFun;
}

pub rec Set {
    items:         *Provider;
    len:           usize;
    max_providers: usize;
    max_key_bytes: usize;
    valid:         bool;
}

pub fun init(set: *Set, items: *Provider, length: usize,
    max_providers: usize, max_key_bytes: usize) bool {
    if (set == nil || length > max_providers || max_key_bytes == 0
        || (length > 0 && items == nil)) { ret false; }
    var i: usize = 0;
    for (i < length) {
        if (items[i].resolve == nil) { ret false; }
        i = i + 1;
    }
    set.items         = items;
    set.len           = length;
    set.max_providers = max_providers;
    set.max_key_bytes = max_key_bytes;
    set.valid         = true;
    ret true;
}

pub fun validate(set: *Set) bool {
    if (set == nil || !set.valid || set.len > set.max_providers || set.max_key_bytes == 0
        || (set.len > 0 && set.items == nil)) { ret false; }
    var i: usize = 0;
    for (i < set.len) {
        if (set.items[i].resolve == nil) { ret false; }
        i = i + 1;
    }
    ret true;
}

# an ok nil result means this provider does not own the key
pub fun resolve(set: *Set, key: view.View) res[ptr, view.View] {
    if (!validate(set) || key.len == 0 || key.len > set.max_key_bytes || key.data == nil) {
        ret res[ptr, view.View].err{view.view("invalid provider key", 20)};
    }
    var i: usize = 0;
    for (i < set.len) {
        val resolved: res[ptr, view.View] = set.items[i].resolve(set.items[i].ctx, key);
        if (sel resolved.err) { ret resolved; }
        val value: ptr = resolved.ok;
        if (value != nil) { ret resolved; }
        i = i + 1;
    }
    ret res[ptr, view.View].err{view.view("provider not found", 18)};
}

rec TestProvider {
    key:   view.View;
    value: ptr;
    calls: usize;
    fail:  bool;
}

fun view_equal(a: view.View, b: view.View) bool {
    if (a.len != b.len) { ret false; }
    var i: usize = 0;
    for (i < a.len) {
        if (a.data[i] != b.data[i]) { ret false; }
        i = i + 1;
    }
    ret true;
}

fun test_resolve(context: ptr, key: view.View) res[ptr, view.View] {
    val state: *TestProvider = context::*TestProvider;
    state.calls = state.calls + 1;
    if (state.fail)                 { ret res[ptr, view.View].err{view.view("provider failed", 15)}; }
    if (view_equal(state.key, key)) { ret res[ptr, view.View].ok{state.value}; }
    ret res[ptr, view.View].ok{nil};
}

test "laurel.provider: resolution is ordered, bounded, and explicit" {
    var value:  u8 = 7;
    var states: [2]TestProvider;
    states[0] = TestProvider{key: view.view("cache", 5), value: nil, calls: 0, fail: false};
    states[1] = TestProvider{key: view.view("database", 8), value: (?value)::ptr, calls: 0, fail: false};
    var items: [2]Provider;
    items[0] = Provider{ctx: (?states[0])::ptr, resolve: test_resolve};
    items[1] = Provider{ctx: (?states[1])::ptr, resolve: test_resolve};
    var set: Set;
    if (!init(?set, ?items[0], 2, 2, 8)) { ret 1; }
    val found: res[ptr, view.View] = resolve(?set, view.view("database", 8));
    if (sel found.err)                                                             { ret 2; }
    if (found.ok != (?value)::ptr || states[0].calls != 1 || states[1].calls != 1) { ret 2; }
    val missing: res[ptr, view.View] = resolve(?set, view.view("queue", 5));
    if (sel missing.ok) { ret 3; }
    val oversized: res[ptr, view.View] = resolve(?set, view.view("longer-key", 10));
    if (sel oversized.ok)                             { ret 4; }
    if (states[0].calls != 2 || states[1].calls != 2) { ret 4; }
    states[0].fail = true;
    val failed: res[ptr, view.View] = resolve(?set, view.view("database", 8));
    if (sel failed.ok)        { ret 5; }
    if (states[1].calls != 2) { ret 5; }
    ret 0;
}
