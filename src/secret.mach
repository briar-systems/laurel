# host-owned secret resolution behind a public source handle

use crypto.contracts;
use std.crypto.ct;
use std.sync.mutex;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.size.usize;
use std.types.view;

pub val MAX_RESOLVERS:  usize = 8;
pub val MAX_NAME_BYTES: usize = 64;

pub def Status: u8;
pub val BORROW_OK:      Status = 1;
pub val BORROW_MISSING: Status = 2;
pub val BORROW_REFUSED: Status = 3;
pub val BORROW_INVALID: Status = 4;

# the secret is valid only for the duration of the call and must not be retained
pub def UseFun:    fun(ptr, contracts.SecretBytes) bool;
pub def BorrowFun: fun(ptr, view.View, UseFun, ptr) Status;

# a resolver is secret welded through its callback type, so it never erases to
# ptr. only this module's table names it, and everything else holds a Source.
pub rec Resolver {
    ctx:    ptr;
    borrow: BorrowFun;
}

# an opaque public name for one registered resolver; it holds no pointer
pub rec Source {
    slot:       u32;
    generation: u32;
}

var registry_resolvers:   [8]*Resolver;
var registry_generations: [8]u32;
var registry_used:        [8]bool;
var registry_borrows:     [8]usize;
var registry_lock:        mutex.Mutex = 0;

# the provider.Set key under which a host supplies a *Source
pub fun key() view.View {
    ret view.view("laurel.secret", 13);
}

pub fun name_valid(name: view.View) bool {
    if (name.len == 0 || name.len > MAX_NAME_BYTES || name.data == nil) { ret false; }
    var i: usize = 0;
    for (i < name.len) {
        val byte: u8 = name.data[i];
        if (byte < 0x21 || byte > 0x7e) { ret false; }
        i = i + 1;
    }
    ret true;
}

pub fun register(resolver: *Resolver, output: *Source) bool {
    if (resolver == nil || resolver.borrow == nil || output == nil) { ret false; }
    mutex.lock(?registry_lock);
    var i: usize = 0;
    for (i < MAX_RESOLVERS) {
        if (registry_used[i] && registry_resolvers[i] == resolver) {
            mutex.unlock(?registry_lock);
            ret false;
        }
        i = i + 1;
    }
    i = 0;
    for (i < MAX_RESOLVERS) {
        if (!registry_used[i] && registry_generations[i] != 4294967295) {
            registry_generations[i] = registry_generations[i] + 1;
            registry_resolvers[i]   = resolver;
            registry_used[i]        = true;
            registry_borrows[i]     = 0;
            @output                 = Source{slot: i::u32, generation: registry_generations[i]};
            mutex.unlock(?registry_lock);
            ret true;
        }
        i = i + 1;
    }
    mutex.unlock(?registry_lock);
    ret false;
}

fun live(source: Source) bool {
    if (source.generation == 0 || source.slot::usize >= MAX_RESOLVERS) { ret false; }
    val slot: usize = source.slot::usize;
    ret registry_used[slot] && registry_generations[slot] == source.generation;
}

pub fun registered(source: Source) bool {
    mutex.lock(?registry_lock);
    val found: bool = live(source);
    mutex.unlock(?registry_lock);
    ret found;
}

# refused while a borrow through the source is still in flight
pub fun unregister(source: Source) bool {
    mutex.lock(?registry_lock);
    if (!live(source) || registry_borrows[source.slot::usize] != 0) {
        mutex.unlock(?registry_lock);
        ret false;
    }
    registry_resolvers[source.slot::usize] = nil;
    registry_used[source.slot::usize]      = false;
    mutex.unlock(?registry_lock);
    ret true;
}

# hands the named secret to use for one call, never to the caller's storage
pub fun borrow(source: Source, name: view.View, use: UseFun, use_ctx: ptr) Status {
    if (!name_valid(name) || use == nil) { ret BORROW_INVALID; }
    mutex.lock(?registry_lock);
    if (!live(source)) {
        mutex.unlock(?registry_lock);
        ret BORROW_INVALID;
    }
    val slot:     usize     = source.slot::usize;
    val resolver: *Resolver = registry_resolvers[slot];
    registry_borrows[slot] = registry_borrows[slot] + 1;
    mutex.unlock(?registry_lock);
    var status: Status = resolver.borrow(resolver.ctx, name, use, use_ctx);
    if (status != BORROW_OK && status != BORROW_MISSING && status != BORROW_REFUSED) {
        status = BORROW_INVALID;
    }
    mutex.lock(?registry_lock);
    registry_borrows[slot] = registry_borrows[slot] - 1;
    mutex.unlock(?registry_lock);
    ret status;
}

#[testing]
var test_key: [4]^u8;

#[testing]
rec TestUse {
    source:   Source;
    matched:  bool;
    released: bool;
}

#[testing]
fun test_borrow(context: ptr, name: view.View, use: UseFun, use_ctx: ptr) Status {
    if (name.len != 5 || name.data[0] != 't') { ret BORROW_MISSING; }
    var scratch: [4]^u8;
    var i:       usize = 0;
    for (i < 4) {
        scratch[i] = test_key[i];
        i          = i + 1;
    }
    val used: bool = use(use_ctx, contracts.SecretBytes{data: ?scratch[0], len: 4});
    ct.zeroize(?scratch[0], 4);
    if (!used) { ret BORROW_REFUSED; }
    ret BORROW_OK;
}

#[testing]
fun test_use(context: ptr, secret: contracts.SecretBytes) bool {
    val state:    *TestUse = context::*TestUse;
    var expected: [4]^u8;
    expected[0] = 'k';
    expected[1] = 'e';
    expected[2] = 'y';
    expected[3] = '!';
    ct.begin();
    val equal: ^u8 = ct.eq_bytes(secret.data, ?expected[0], 4);
    state.matched = secret.len == 4 && equal:>u8 == 1;
    ct.end();
    state.released = unregister(state.source);
    ret state.matched;
}

test borrow__scoped_to_the_call {
    test_key[0] = 'k';
    test_key[1] = 'e';
    test_key[2] = 'y';
    test_key[3] = '!';
    var resolver: Resolver = Resolver{ctx: nil, borrow: test_borrow};
    var source:   Source;
    if (!register(?resolver, ?source) || !registered(source)) { ret 1; }
    var twice: Source;
    if (register(?resolver, ?twice)) { ret 2; }
    var state: TestUse = TestUse{source: source, matched: false, released: true};
    if (borrow(source, view.view("token", 5), test_use, (?state)::ptr) != BORROW_OK
        || !state.matched || state.released) { ret 3; }
    if (borrow(source, view.view("other", 5), test_use, (?state)::ptr) != BORROW_MISSING) { ret 4; }
    if (borrow(source, view.view("", 0), test_use, (?state)::ptr) != BORROW_INVALID)      { ret 5; }
    if (!unregister(source) || registered(source))                                        { ret 6; }
    if (borrow(source, view.view("token", 5), test_use, (?state)::ptr) != BORROW_INVALID) { ret 7; }
    ret 0;
}
