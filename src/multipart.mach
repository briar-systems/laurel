    if (!init(?parser, view.view("g", 1), storage, test_limits(),
        test_store(?state), ?uploader)) { ret 1; }
    val body_text: str       = "--g\r\nContent-Disposition: form-data; name=\"a\"; filename=\"a.txt\"\r\n\r\none\r\n--g\r\nBroken Header\r\n\r\n";
    val uncertain: Operation = feed(?parser, body_text::*u8,
        str_len(body_text));
    if (uncertain.status != STORAGE_UNKNOWN ||
        parser.state != UNKNOWN_STATE || state.seal_calls != 1 ||
        state.commit_calls != 0 || state.abort_calls != 1) { ret 2; }
    val reconciled: Operation = resolve_storage(?parser,
        upload.OUTCOME_ABORTED);
    if (reconciled.status != MALFORMED || parser.state != FAILED_STATE ||
        parser.published_parts != 0 || state.len != 0 ||
        result(?parser).status != INVALID) { ret 3; }
    ret 0;
}

test limits__fail_closed {
    var limits: Limits = test_limits();
    limits.max_header_bytes = 32;
    if (rejected_status("b",
        "--b\r\nContent-Disposition: form-data; name=\"a\"\r\n\r\nx\r\n--b--\r\n",
        limits) != LIMIT) { ret 1; }

    limits           = test_limits();
    limits.max_parts = 1;
    if (rejected_status("b",
        "--b\r\nContent-Disposition: form-data; name=\"a\"\r\n\r\nx\r\n--b\r\nContent-Disposition: form-data; name=\"b\"\r\n\r\ny\r\n--b--\r\n",
        limits) != LIMIT) { ret 2; }

    limits                 = test_limits();
    limits.max_field_bytes = 3;
    if (rejected_status("b",
        "--b\r\nContent-Disposition: form-data; name=\"a\"\r\n\r\nfour\r\n--b--\r\n",
        limits) != LIMIT) { ret 3; }

    limits                = test_limits();
    limits.max_file_bytes = 3;
    if (rejected_status("b",
        "--b\r\nContent-Disposition: form-data; name=\"a\"; filename=\"a.txt\"\r\n\r\nfour\r\n--b--\r\n",
        limits) != LIMIT) { ret 4; }

    limits             = test_limits();
    limits.max_nesting = 1;
    if (rejected_status("b",
        "--b\r\nContent-Disposition: form-data; name=\"a\"\r\nContent-Type: multipart/mixed; boundary=i\r\n\r\n--i--\r\n--b--\r\n",
        limits) != LIMIT) { ret 5; }

    limits                 = test_limits();
    limits.max_total_bytes = 8;
    if (rejected_status("b", "--b\r\nanything", limits) != LIMIT) {
        ret 6;
    }

    limits                      = test_limits();
    limits.max_headers_per_part = 1;
    if (rejected_status("b",
        "--b\r\nContent-Disposition: form-data; name=\"a\"\r\nContent-Type: text/plain\r\n\r\nx\r\n--b--\r\n",
        limits) != LIMIT) { ret 7; }

    limits                     = test_limits();
    limits.max_temporary_bytes = 3;
    if (rejected_status("b",
        "--b\r\nContent-Disposition: form-data; name=\"a\"\r\n\r\nabc\r\n--b--\r\n",
        limits) != LIMIT) { ret 8; }
    ret 0;
}

#[testing]
rec TestBody {
    input:            view.View;
    offset:           usize;
    pending_output:   *u8;
    pending_capacity: usize;
    pending_mode:     body.Mode;
    pending_read:     bool;
    pending_finish:   bool;
    finish_calls:     usize;
    release_calls:    usize;
}

#[testing]
fun test_body_emit(state: *TestBody, output: *u8,
    capacity: usize) body.Progress {
    if (state.offset == state.input.len) {
        ret body.complete(body.REUSE_ALLOWED);
    }
    if (output == nil || capacity == 0) {
        ret body.failed("test body output was empty", body.REUSE_FORBIDDEN);
    }
    var count: usize = state.input.len - state.offset;
    if (count > capacity) { count = capacity; }
    if (count > 3)        { count = 3; }
    var i: usize = 0;
    for (i < count) {
        output[i] = state.input.data[state.offset + i];
        i         = i + 1;
    }
    state.offset = state.offset + count;
    ret body.data(count);
}

#[testing]
fun test_body_read(ctx: ptr, output: *u8, capacity: usize,
    trailers: *field.Fields) body.Progress {
    val state: *TestBody = ctx::*TestBody;
    if (state.pending_read) {
        state.pending_read     = false;
        state.pending_output   = output;
        state.pending_capacity = capacity;
        ret body.pending(91);
    }
    ret test_body_emit(state, output, capacity);
}

#[testing]
fun test_body_finish(ctx: ptr, mode: body.Mode,
    trailers: *field.Fields) body.Progress {
    val state: *TestBody = ctx::*TestBody;
    state.finish_calls = state.finish_calls + 1;
    if (state.pending_finish) {
        state.pending_finish = false;
        state.pending_mode   = mode;
        ret body.pending(92);
    }
    if (mode == body.REJECT)  { ret body.rejected(body.REUSE_FORBIDDEN); }
    if (mode == body.CANCEL)  { ret body.cancelled(body.REUSE_FORBIDDEN); }
    if (mode == body.TIMEOUT) { ret body.timed_out(body.REUSE_FORBIDDEN); }
    ret body.complete(body.REUSE_ALLOWED);
}

#[testing]
fun test_body_complete(ctx: ptr, token: u64,
    trailers: *field.Fields) body.Progress {
    val state: *TestBody = ctx::*TestBody;
    if (token == 91) {
        val output:   *u8   = state.pending_output;
        val capacity: usize = state.pending_capacity;
        state.pending_output   = nil;
        state.pending_capacity = 0;
        ret test_body_emit(state, output, capacity);
    }
    if (token == 92) {
        val mode: body.Mode = state.pending_mode;
        state.pending_mode = 0;
        if (mode == body.REJECT)  { ret body.rejected(body.REUSE_FORBIDDEN); }
        if (mode == body.CANCEL)  { ret body.cancelled(body.REUSE_FORBIDDEN); }
        if (mode == body.TIMEOUT) { ret body.timed_out(body.REUSE_FORBIDDEN); }
    }
    ret body.failed("invalid test completion token", body.REUSE_FORBIDDEN);
}

#[testing]
fun test_body_release(ctx: ptr) {
    val state: *TestBody = ctx::*TestBody;
    state.release_calls = state.release_calls + 1;
}

#[testing]
fun test_reader(state: *TestBody, scope: *cancel.Scope,
    trailers: *field.Fields, maximum: u64) body.Reader {
    ret body.init_reader(state::ptr, test_body_read, test_body_finish,
        test_body_complete, test_body_release, body.OWNER_APPLICATION, 501,
        false, 0, body.limits(maximum, 16, 1024), trailers, scope);
}

test body__spans_reader_and_storage_pending {
    var parts:       [8]Part;
    var bytes:       [2048]u8;
    var work:        [512]u8;
    var read_buffer: [5]u8;
    var store_state: TestStore;
    store_state.pending_batch_begin  = true;
    store_state.pending_file_begin   = true;
    store_state.pending_write        = true;
    store_state.pending_file_seal    = true;
    store_state.pending_batch_commit = true;
    var uploader: upload.Upload;
    var decoder:  Parser;
    val storage:  Storage = Storage{parts: ?parts[0], part_capacity: 8,
        bytes: ?bytes[0], byte_capacity: 2048,
        work:  ?work[0], work_capacity: 512};
    if (!init(?decoder, view.view("r", 1), storage, test_limits(),
        test_store(?store_state), ?uploader)) { ret 1; }
    var scope: cancel.Scope;
    if (!operation_ok(cancel.make_root(?scope, opt[time.Instant].none{}))) { ret 2; }
    var trailers: field.Fields = field.init(nil, 0,
        field.limits(0, 0, 0, 0));
    val text:       str      = "--r\r\nContent-Disposition: form-data; name=\"f\"; filename=\"a.txt\"\r\n\r\ndata\r\n--r--\r\n";
    var body_state: TestBody = TestBody{
        input: view.view(text, str_len(text)), pending_read: true, offset: 0, pending_output: nil, pending_capacity: 0, pending_mode: 0, pending_finish: false, finish_calls: 0, release_calls: 0
    };
    var reader: body.Reader = test_reader(?body_state, ?scope, ?trailers,
        4096);
    var parser: BodyParser;
    if (!init_body(?parser, ?decoder, ?reader, ?read_buffer[0], 5)) {
        ret 3;
    }
    var current: Operation = poll_body(?parser);
    var turns:   usize     = 0;
    for (current.status <= PENDING) {
        if (current.status == PENDING) {
            current = complete_body(?parser, current.token);
        }
        or { current = poll_body(?parser); }
        turns = turns + 1;
        if (turns > 256) { ret 4; }
    }
    if (current.status != COMPLETE) { ret 5; }
    if (current.result.len != 1 || parts[0].file.size != 4 ||
        store_state.len != 4) { ret 6; }
    if (body_state.release_calls != 1 ||
        !body.reader_terminal_state(?reader)) { ret 7; }
    if (!operation_ok(cancel.destroy(?scope))) { ret 8; }
    ret 0;
}

test body__rejection_settles_once {
    var parts:       [8]Part;
    var bytes:       [2048]u8;
    var work:        [512]u8;
    var read_buffer: [8]u8;
    var store_state: TestStore;
    var uploader:    upload.Upload;
    var decoder:     Parser;
    val storage:     Storage = Storage{parts: ?parts[0], part_capacity: 8,
        bytes: ?bytes[0], byte_capacity: 2048,
        work:  ?work[0], work_capacity: 512};
    if (!init(?decoder, view.view("r", 1), storage, test_limits(),
        test_store(?store_state), ?uploader)) { ret 1; }
    var scope: cancel.Scope;
    if (!operation_ok(cancel.make_root(?scope, opt[time.Instant].none{}))) { ret 2; }
    var trailers: field.Fields = field.init(nil, 0,
        field.limits(0, 0, 0, 0));
    val text:       str      = "not-a-boundary";
    var body_state: TestBody = TestBody{
        input: view.view(text, str_len(text)), pending_finish: true, offset: 0, pending_output: nil, pending_capacity: 0, pending_mode: 0, pending_read: false, finish_calls: 0, release_calls: 0
    };
    var reader: body.Reader = test_reader(?body_state, ?scope, ?trailers,
        4096);
    var parser: BodyParser;
    if (!init_body(?parser, ?decoder, ?reader, ?read_buffer[0], 8)) {
        ret 3;
    }
    var current: Operation = poll_body(?parser);
    var turns:   usize     = 0;
    for (current.status == MORE || current.status == PENDING) {
        if (current.status == PENDING) {
            current = complete_body(?parser, current.token);
        }
        or { current = poll_body(?parser); }
        turns = turns + 1;
        if (turns > 32) { ret 4; }
    }
    if (current.status != MALFORMED || body_state.finish_calls != 1 ||
        body_state.release_calls != 1 ||
        !body.reader_terminal_state(?reader) || !operation_ok(cancel.destroy(?scope))) {
        ret 5;
    }
    ret 0;
}
