# asynchronous request-wide upload transactions

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.size.usize;
use std.types.string.str;
use std.types.view;

pub val MAX_FIELD_NAME_BYTES:     usize = 256;
pub val MAX_FILE_NAME_BYTES:      usize = 1024;
pub val MAX_CONTENT_TYPE_BYTES:   usize = 256;
pub val MAX_STORED_FILE_ID_BYTES: usize = 4096;

pub def Status:  u8;
pub def Kind:    u8;
pub def Outcome: u8;
pub def State:   u8;

pub val OK:      Status = 1;
pub val PENDING: Status = 2;
pub val ERROR:   Status = 3;
pub val INVALID: Status = 4;
pub val LIMIT:   Status = 5;

pub val BATCH_BEGIN:  Kind = 1;
pub val FILE_BEGIN:   Kind = 2;
pub val WRITE:        Kind = 3;
pub val FILE_SEAL:    Kind = 4;
pub val BATCH_COMMIT: Kind = 5;
pub val BATCH_ABORT:  Kind = 6;

pub val OUTCOME_NONE:      Outcome = 0;
pub val OUTCOME_ACTIVE:    Outcome = 1;
pub val OUTCOME_STAGED:    Outcome = 2;
pub val OUTCOME_COMMITTED: Outcome = 3;
pub val OUTCOME_ABORTED:   Outcome = 4;
pub val OUTCOME_UNKNOWN:   Outcome = 5;

pub val UNINITIALIZED:    State = 0;
pub val READY:            State = 1;
pub val BATCH_BEGINNING:  State = 2;
pub val BATCH_ACTIVE:     State = 3;
pub val FILE_BEGINNING:   State = 4;
pub val FILE_ACTIVE:      State = 5;
pub val WRITING:          State = 6;
pub val FILE_SEALING:     State = 7;
pub val BATCH_COMMITTING: State = 8;
pub val BATCH_ABORTING:   State = 9;
pub val COMMITTED:        State = 10;
pub val ABORTED:          State = 11;
pub val UNKNOWN:          State = 12;
pub val RELEASED:         State = 13;

pub rec Metadata {
    field_name:   view.View;
    file_name:    view.View;
    content_type: view.View;
    declared_len: u64;
    has_length:   bool;
}

pub rec Transaction {
    owner: ptr;
    id:    u64;
}

pub rec StoredFile {
    id:   view.View;
    size: u64;
}

pub rec Progress {
    status:      Status;
    kind:        Kind;
    token:       u64;
    transaction: Transaction;
    written:     usize;
    file:        StoredFile;
    outcome:     Outcome;
    error:       str;
}

pub def AliasesStateFun: fun(ptr, *u8, usize) bool;
pub def BatchBeginFun:   fun(ptr) Progress;
pub def FileBeginFun:    fun(ptr, Transaction, Metadata) Progress;
pub def WriteFun:        fun(ptr, Transaction, Transaction, *u8, usize) Progress;
pub def FileSealFun:     fun(ptr, Transaction, Transaction) Progress;
pub def BatchCommitFun:  fun(ptr, Transaction) Progress;
pub def BatchAbortFun:   fun(ptr, Transaction, Transaction) Progress;
pub def CompleteFun:     fun(ptr, u64) Progress;

pub rec Store {
    ctx:           ptr;
    context_size:  usize;
    aliases_state: AliasesStateFun;
    batch_begin:   BatchBeginFun;
    file_begin:    FileBeginFun;
    write:         WriteFun;
    file_seal:     FileSealFun;
    batch_commit:  BatchCommitFun;
    batch_abort:   BatchAbortFun;
    complete:      CompleteFun;
}

pub rec Upload {
    store:                  Store;
    state:                  State;
    batch:                  Transaction;
    file_transaction:       Transaction;
    max_file_bytes:         u64;
    transferred:            u64;
    sealed_files:           usize;
    generation:             u64;
    pending_kind:           Kind;
    pending_token:          u64;
    pending_provider_token: u64;
    pending_input:          *u8;
    pending_len:            usize;
    unknown_kind:           Kind;
    field_name:             [256]u8;
    field_name_len:         usize;
    file_name:              [1024]u8;
    file_name_len:          usize;
    content_type:           [256]u8;
    content_type_len:       usize;
    declared_len:           u64;
    has_length:             bool;
}

pub rec Operation {
    status:  Status;
    kind:    Kind;
    token:   u64;
    written: usize;
    file:    StoredFile;
    outcome: Outcome;
    error:   str;
}

fun range_valid(data: *u8, len: usize) bool {
    if (len == 0)    { ret true; }
    if (data == nil) { ret false; }
    ret len - 1 <= ~(0::usize) - data::usize;
}

fun overlap(first: *u8, first_len: usize, second: *u8,
    second_len: usize) bool {
    if (first_len == 0 || second_len == 0) { ret false; }
    if (!range_valid(first, first_len) || !range_valid(second, second_len)) {
        ret true;
    }
    val first_start:  usize = first::usize;
    val second_start: usize = second::usize;
    ret first_start <= second_start + second_len - 1 &&
        second_start <= first_start + first_len - 1;
}

fun bytes_equal(first: *u8, second: *u8, len: usize) bool {
    if (!range_valid(first, len) || !range_valid(second, len)) { ret false; }
    var i: usize = 0;
    for (i < len) {
        if (first[i] != second[i]) { ret false; }
        i = i + 1;
    }
    ret true;
}

fun clear(output: *u8, len: usize) {
    if (output == nil) { ret; }
    var i: usize = 0;
    for (i < len) {
        output[i] = 0;
        i         = i + 1;
    }
}

fun copy(input: view.View, output: *u8) {
    var i: usize = 0;
    for (i < input.len) {
        output[i] = input.data[i];
        i         = i + 1;
    }
}

fun view_valid(value: view.View, maximum: usize, allow_empty: bool) bool {
    ret (allow_empty || value.len != 0) && value.len <= maximum &&
        range_valid(value.data, value.len);
}

fun store_shape(value: Store) bool {
    ret value.ctx != nil && value.context_size != 0 &&
        range_valid(value.ctx::*u8, value.context_size) &&
        value.aliases_state::usize != 0 &&
        value.batch_begin::usize != 0 && value.file_begin::usize != 0 &&
        value.write::usize != 0 && value.file_seal::usize != 0 &&
        value.batch_commit::usize != 0 && value.batch_abort::usize != 0 &&
        value.complete::usize != 0;
}

fun store_equal(first: Store, second: Store) bool {
    ret first.ctx == second.ctx && first.context_size == second.context_size &&
        first.aliases_state::usize == second.aliases_state::usize &&
        first.batch_begin::usize == second.batch_begin::usize &&
        first.file_begin::usize == second.file_begin::usize &&
        first.write::usize == second.write::usize &&
        first.file_seal::usize == second.file_seal::usize &&
        first.batch_commit::usize == second.batch_commit::usize &&
        first.batch_abort::usize == second.batch_abort::usize &&
        first.complete::usize == second.complete::usize;
}

fun upload_anchor(value: *Upload) *u8 {
    if (value == nil) { ret nil; }
    ret (?value.store)::*u8;
}

fun upload_unchanged(upload: *Upload, before: *Upload) bool {
    ret upload != nil && before != nil &&
        bytes_equal(upload_anchor(upload), upload_anchor(before),
        $size_of(Upload));
}

fun store_locally_disjoint(store: Store, data: *u8, len: usize) bool {
    ret store_shape(store) && range_valid(data, len) &&
        !overlap(store.ctx::*u8, store.context_size, data, len);
}

fun guarded_store_alias(upload: *Upload, store: Store, data: *u8,
    len: usize) i8 {
    if (!store_shape(store) || !range_valid(data, len) ||
        overlap(store.ctx::*u8, store.context_size, data, len)) { ret 1; }
    var before:  Upload = @upload;
    val aliases: bool   = store.aliases_state(store.ctx, data, len);
    if (!upload_unchanged(upload, ?before)) {
        @upload = before;
        ret -1;
    }
    if (aliases) { ret 1; }
    ret 0;
}

fun transaction_empty(value: Transaction) bool {
    ret value.owner == nil && value.id == 0;
}

fun transaction_valid(value: Transaction, store: Store) bool {
    ret value.owner == store.ctx && value.id != 0;
}

fun transactions_distinct(batch: Transaction, file: Transaction,
    store: Store) bool {
    ret transaction_valid(batch, store) && transaction_valid(file, store) &&
        batch.id != file.id;
}

fun metadata_valid(value: Metadata, max_file_bytes: u64) bool {
    if (!view_valid(value.field_name, MAX_FIELD_NAME_BYTES, false) ||
        !view_valid(value.file_name, MAX_FILE_NAME_BYTES, true) ||
        !view_valid(value.content_type, MAX_CONTENT_TYPE_BYTES, true) ||
        value.has_length && value.declared_len > max_file_bytes ||
        !value.has_length && value.declared_len != 0) { ret false; }
    if ((value.file_name.len == 1 && value.file_name.data[0] == '.') ||
        (value.file_name.len == 2 && value.file_name.data[0] == '.' &&
        value.file_name.data[1] == '.')) { ret false; }
    var i: usize = 0;
    for (i < value.field_name.len) {
        val current: u8 = value.field_name.data[i];
        if (current == 0 || current == '\r' || current == '\n') { ret false; }
        i = i + 1;
    }
    i = 0;
    for (i < value.file_name.len) {
        val current: u8 = value.file_name.data[i];
        if (current == 0 || current == '/' || current == '\\' ||
            current == '\r' || current == '\n' || current == ':') { ret false; }
        i = i + 1;
    }
    i = 0;
    for (i < value.content_type.len) {
        val current: u8 = value.content_type.data[i];
        if (current == 0 || current == '\r' || current == '\n') { ret false; }
        i = i + 1;
    }
    ret true;
}

fun metadata_locally_disjoint(upload: *Upload, store: Store,
    value: Metadata) bool {
    ret !overlap(store.ctx::*u8, store.context_size,
        value.field_name.data, value.field_name.len) &&
        !overlap(store.ctx::*u8, store.context_size,
        value.file_name.data, value.file_name.len) &&
        !overlap(store.ctx::*u8, store.context_size,
        value.content_type.data, value.content_type.len) &&
        !overlap(upload_anchor(upload), $size_of(Upload),
        value.field_name.data, value.field_name.len) &&
        !overlap(upload_anchor(upload), $size_of(Upload),
        value.file_name.data, value.file_name.len) &&
        !overlap(upload_anchor(upload), $size_of(Upload),
        value.content_type.data, value.content_type.len);
}

fun staged_metadata(upload: *Upload) Metadata {
    ret Metadata{
        field_name:   view.view(?upload.field_name[0], upload.field_name_len),
        file_name:    view.view(?upload.file_name[0], upload.file_name_len),
        content_type: view.view(?upload.content_type[0],
            upload.content_type_len),
        declared_len: upload.declared_len,
        has_length:   upload.has_length,
    };
}

fun clear_file(upload: *Upload) {
    upload.file_transaction = Transaction{owner: nil, id: 0};
    upload.transferred      = 0;
    clear(?upload.field_name[0], MAX_FIELD_NAME_BYTES);
    clear(?upload.file_name[0], MAX_FILE_NAME_BYTES);
    clear(?upload.content_type[0], MAX_CONTENT_TYPE_BYTES);
    upload.field_name_len   = 0;
    upload.file_name_len    = 0;
    upload.content_type_len = 0;
    upload.declared_len     = 0;
    upload.has_length       = false;
}

fun empty_file() StoredFile {
    ret StoredFile{id: view.view(nil, 0), size: 0};
}

fun operation(status: Status, kind: Kind, outcome: Outcome,
    error: str) Operation {
    ret Operation{status: status, kind: kind, token: 0, written: 0,
        file: empty_file(), outcome: outcome, error: error};
}

fun pending(kind: Kind, token: u64) Operation {
    ret Operation{status: PENDING, kind: kind, token: token, written: 0,
        file: empty_file(), outcome: OUTCOME_ACTIVE, error: nil};
}

fun clear_pending(upload: *Upload) {
    upload.pending_kind           = 0;
    upload.pending_token          = 0;
    upload.pending_provider_token = 0;
    upload.pending_input          = nil;
    upload.pending_len            = 0;
}

fun poison(upload: *Upload, kind: Kind, detail: str) Operation {
    clear_pending(upload);
    upload.unknown_kind = kind;
    upload.state        = UNKNOWN;
    ret operation(INVALID, kind, OUTCOME_UNKNOWN, detail);
}

fun record_pending(upload: *Upload, kind: Kind,
    provider_token: u64) Operation {
    if (upload.generation == ~(0::u64) || provider_token == 0) {
        ret poison(upload, kind, "upload completion token space exhausted");
    }
    upload.generation             = upload.generation + 1;
    upload.pending_kind           = kind;
    upload.pending_token          = upload.generation;
    upload.pending_provider_token = provider_token;
    ret pending(kind, upload.pending_token);
}

fun progress_shape(progress: Progress, kind: Kind) bool {
    if (progress.kind != kind || progress.status < OK ||
        progress.status > ERROR || progress.outcome > OUTCOME_UNKNOWN ||
        progress.token != 0 && progress.status != PENDING ||
        progress.written != 0 && kind != WRITE) { ret false; }
    if (progress.status == PENDING) {
        ret progress.token != 0 && progress.written == 0 &&
            transaction_empty(progress.transaction) &&
            progress.file.id.len == 0 && progress.file.size == 0 &&
            progress.outcome == OUTCOME_ACTIVE && progress.error == nil;
    }
    if (progress.status == ERROR) {
        ret progress.error != nil &&
            transaction_empty(progress.transaction) &&
            progress.file.id.len == 0 && progress.file.size == 0 &&
            progress.written == 0;
    }
    if (progress.error != nil) { ret false; }
    if (kind == BATCH_BEGIN || kind == FILE_BEGIN) {
        ret progress.outcome == OUTCOME_ACTIVE &&
            progress.written == 0 && progress.file.id.len == 0 &&
            progress.file.size == 0;
    }
    if (kind == WRITE) {
        ret progress.outcome == OUTCOME_ACTIVE &&
            transaction_empty(progress.transaction) &&
            progress.file.id.len == 0 && progress.file.size == 0;
    }
    if (kind == FILE_SEAL) {
        ret progress.outcome == OUTCOME_STAGED &&
            transaction_empty(progress.transaction) &&
            progress.written == 0;
    }
    if (kind == BATCH_COMMIT) {
        ret progress.outcome == OUTCOME_COMMITTED &&
            transaction_empty(progress.transaction) &&
            progress.written == 0 && progress.file.id.len == 0 &&
            progress.file.size == 0;
    }
    ret kind == BATCH_ABORT && progress.outcome == OUTCOME_ABORTED &&
        transaction_empty(progress.transaction) && progress.written == 0 &&
        progress.file.id.len == 0 && progress.file.size == 0;
}

fun callback_stable(upload: *Upload, before: *Upload, store: Store,
    transitional: State) bool {
    if (upload != nil && before != nil && upload.state == transitional &&
        store_equal(store, upload.store) && upload_unchanged(upload, before)) {
        ret true;
    }
    if (upload != nil && before != nil) { @upload = @before; }
    ret false;
}

fun file_valid(upload: *Upload, file: StoredFile) bool {
    if (file.size != upload.transferred ||
        !view_valid(file.id, MAX_STORED_FILE_ID_BYTES, false) ||
        overlap(upload_anchor(upload), $size_of(Upload),
        file.id.data, file.id.len)) { ret false; }
    if (overlap(upload.store.ctx::*u8, upload.store.context_size,
        file.id.data, file.id.len)) { ret true; }
    var before: Upload = @upload;
    val owned:  bool   = upload.store.aliases_state(upload.store.ctx,
        file.id.data, file.id.len);
    if (!upload_unchanged(upload, ?before)) {
        @upload = before;
        ret false;
    }
    ret owned;
}

pub fun init(upload: *Upload, store: Store, max_file_bytes: u64) bool {
    if (upload == nil || !range_valid(upload_anchor(upload), $size_of(Upload)) ||
        (upload.state != UNINITIALIZED && upload.state != RELEASED) ||
        max_file_bytes == 0 || !store_shape(store) ||
        !store_locally_disjoint(store, upload_anchor(upload),
        $size_of(Upload))) { ret false; }
    var before:  Upload = @upload;
    val aliases: bool   = store.aliases_state(store.ctx,
        upload_anchor(upload), $size_of(Upload));
    if (aliases || !upload_unchanged(upload, ?before)) {
        @upload = before;
        ret false;
    }
    var generation: u64 = 0;
    if (upload.state == RELEASED) { generation = upload.generation; }
    clear(upload_anchor(upload), $size_of(Upload));
    upload.store          = store;
    upload.state          = READY;
    upload.max_file_bytes = max_file_bytes;
    upload.generation     = generation;
    ret true;
}

fun file_cleared(upload: *Upload) bool {
    ret transaction_empty(upload.file_transaction) &&
        upload.transferred == 0 &&
        upload.field_name_len == 0 && upload.file_name_len == 0 &&
        upload.content_type_len == 0 && upload.declared_len == 0 &&
        !upload.has_length;
}

fun idle_shape(upload: *Upload) bool {
    ret file_cleared(upload) && upload.pending_kind == 0 &&
        upload.pending_token == 0 && upload.pending_provider_token == 0 &&
        upload.pending_input == nil && upload.pending_len == 0;
}

fun active_file_shape(upload: *Upload) bool {
    ret transactions_distinct(upload.batch, upload.file_transaction,
        upload.store) &&
        metadata_valid(staged_metadata(upload), upload.max_file_bytes) &&
        upload.transferred <= upload.max_file_bytes &&
        (!upload.has_length || upload.transferred <= upload.declared_len);
}

fun retained_input_valid(upload: *Upload) bool {
    ret upload.pending_input != nil && upload.pending_len != 0 &&
        range_valid(upload.pending_input, upload.pending_len) &&
        !overlap(upload.pending_input, upload.pending_len,
        upload_anchor(upload), $size_of(Upload)) &&
        !overlap(upload.pending_input, upload.pending_len,
        upload.store.ctx::*u8, upload.store.context_size) &&
        upload.pending_len::u64 <=
        upload.max_file_bytes - upload.transferred &&
        (!upload.has_length || upload.pending_len::u64 <=
        upload.declared_len - upload.transferred);
}

fun unknown_shape(upload: *Upload) bool {
    if (upload.unknown_kind == BATCH_BEGIN) {
        ret transaction_empty(upload.batch) && upload.sealed_files == 0 &&
            file_cleared(upload);
    }
    if (upload.unknown_kind == FILE_BEGIN) {
        ret transaction_valid(upload.batch, upload.store) &&
            transaction_empty(upload.file_transaction) &&
            upload.transferred == 0 &&
            metadata_valid(staged_metadata(upload), upload.max_file_bytes);
    }
    if (upload.unknown_kind == WRITE ||
        upload.unknown_kind == FILE_SEAL) {
        ret active_file_shape(upload);
    }
    if (upload.unknown_kind == BATCH_COMMIT) {
        ret transaction_valid(upload.batch, upload.store) &&
            upload.sealed_files != 0 && file_cleared(upload);
    }
    ret upload.unknown_kind == BATCH_ABORT &&
        transaction_valid(upload.batch, upload.store) &&
        (file_cleared(upload) || active_file_shape(upload));
}

pub fun valid(upload: *Upload) bool {
    if (upload == nil || !range_valid(upload_anchor(upload), $size_of(Upload)) ||
        !store_shape(upload.store) || upload.max_file_bytes == 0 ||
        !store_locally_disjoint(upload.store, upload_anchor(upload),
        $size_of(Upload))) { ret false; }
    if (upload.state == READY) {
        ret transaction_empty(upload.batch) && upload.sealed_files == 0 &&
            upload.unknown_kind == 0 && idle_shape(upload);
    }
    if (upload.state == BATCH_ACTIVE) {
        ret transaction_valid(upload.batch, upload.store) &&
            upload.unknown_kind == 0 && idle_shape(upload);
    }
    if (upload.state == FILE_ACTIVE) {
        ret active_file_shape(upload) && upload.pending_kind == 0 &&
            upload.pending_token == 0 && upload.pending_provider_token == 0 &&
            upload.pending_input == nil && upload.pending_len == 0 &&
            upload.unknown_kind == 0;
    }
    if (upload.state == BATCH_BEGINNING ||
        upload.state == FILE_BEGINNING || upload.state == WRITING ||
        upload.state == FILE_SEALING ||
        upload.state == BATCH_COMMITTING ||
        upload.state == BATCH_ABORTING) {
        if (upload.pending_token == 0 || upload.pending_provider_token == 0 ||
            upload.unknown_kind != 0) { ret false; }
        if (upload.state == BATCH_BEGINNING) {
            ret upload.pending_kind == BATCH_BEGIN &&
                transaction_empty(upload.batch) && upload.sealed_files == 0 &&
                file_cleared(upload) && upload.pending_input == nil &&
                upload.pending_len == 0;
        }
        if (upload.state == FILE_BEGINNING) {
            ret upload.pending_kind == FILE_BEGIN &&
                transaction_valid(upload.batch, upload.store) &&
                transaction_empty(upload.file_transaction) &&
                upload.transferred == 0 &&
                metadata_valid(staged_metadata(upload),
                upload.max_file_bytes) &&
                upload.pending_input == nil && upload.pending_len == 0;
        }
        if (upload.state == WRITING) {
            ret upload.pending_kind == WRITE && active_file_shape(upload) &&
                retained_input_valid(upload);
        }
        if (upload.state == FILE_SEALING) {
            ret upload.pending_kind == FILE_SEAL && active_file_shape(upload) &&
                (!upload.has_length ||
                upload.transferred == upload.declared_len) &&
                upload.pending_input == nil && upload.pending_len == 0;
        }
        if (upload.state == BATCH_COMMITTING) {
            ret upload.pending_kind == BATCH_COMMIT &&
                transaction_valid(upload.batch, upload.store) &&
                upload.sealed_files != 0 && file_cleared(upload) &&
                upload.pending_input == nil && upload.pending_len == 0;
        }
        ret upload.pending_kind == BATCH_ABORT &&
            transaction_valid(upload.batch, upload.store) &&
            (file_cleared(upload) || active_file_shape(upload)) &&
            upload.pending_input == nil && upload.pending_len == 0;
    }
    if (upload.state == COMMITTED) {
        ret transaction_valid(upload.batch, upload.store) &&
            upload.sealed_files != 0 && upload.unknown_kind == 0 &&
            idle_shape(upload);
    }
    if (upload.state == ABORTED) {
        ret upload.unknown_kind == 0 && upload.pending_kind == 0 &&
            upload.pending_token == 0 && upload.pending_provider_token == 0 &&
            upload.pending_input == nil && upload.pending_len == 0 &&
            file_cleared(upload) &&
            (transaction_empty(upload.batch) ||
            transaction_valid(upload.batch, upload.store));
    }
    if (upload.state == UNKNOWN) {
        ret upload.unknown_kind >= BATCH_BEGIN &&
            upload.unknown_kind <= BATCH_ABORT &&
            upload.pending_kind == 0 && upload.pending_token == 0 &&
            upload.pending_provider_token == 0 &&
            upload.pending_input == nil && upload.pending_len == 0 &&
            unknown_shape(upload);
    }
    ret false;
}

fun accept_batch_begin(upload: *Upload, progress: Progress) Operation {
    if (!progress_shape(progress, BATCH_BEGIN)) {
        ret poison(upload, BATCH_BEGIN,
            "upload batch begin result was invalid");
    }
    if (progress.status == PENDING) {
        ret record_pending(upload, BATCH_BEGIN, progress.token);
    }
    if (progress.status == OK && progress.outcome == OUTCOME_ACTIVE &&
        transaction_valid(progress.transaction, upload.store)) {
        upload.batch = progress.transaction;
        upload.state = BATCH_ACTIVE;
        ret operation(OK, BATCH_BEGIN, OUTCOME_ACTIVE, nil);
    }
    if (progress.status == ERROR &&
        progress.outcome == OUTCOME_ABORTED &&
        transaction_empty(progress.transaction)) {
        upload.state = ABORTED;
        ret operation(ERROR, BATCH_BEGIN, OUTCOME_ABORTED, progress.error);
    }
    ret poison(upload, BATCH_BEGIN,
        "upload batch begin outcome was ambiguous");
}

pub fun begin_batch(upload: *Upload) Operation {
    if (!valid(upload) || upload.state != READY ||
        upload.generation == ~(0::u64)) {
        ret operation(INVALID, BATCH_BEGIN, OUTCOME_NONE,
            "invalid upload batch begin");
    }
    val store: Store = upload.store;
    upload.state = BATCH_BEGINNING;
    var before:   Upload   = @upload;
    val progress: Progress = store.batch_begin(store.ctx);
    if (!callback_stable(upload, ?before, store, BATCH_BEGINNING)) {
        ret poison(upload, BATCH_BEGIN,
            "upload batch begin provider violated ownership");
    }
    ret accept_batch_begin(upload, progress);
}

fun accept_file_begin(upload: *Upload, progress: Progress) Operation {
    if (!progress_shape(progress, FILE_BEGIN)) {
        ret poison(upload, FILE_BEGIN,
            "upload file begin result was invalid");
    }
    if (progress.status == PENDING) {
        ret record_pending(upload, FILE_BEGIN, progress.token);
    }
    if (progress.status == OK && progress.outcome == OUTCOME_ACTIVE &&
        transactions_distinct(upload.batch, progress.transaction,
        upload.store)) {
        upload.file_transaction = progress.transaction;
        upload.state            = FILE_ACTIVE;
        ret operation(OK, FILE_BEGIN, OUTCOME_ACTIVE, nil);
    }
    if (progress.status == ERROR && progress.outcome == OUTCOME_ACTIVE &&
        transaction_empty(progress.transaction)) {
        clear_file(upload);
        upload.state = BATCH_ACTIVE;
        ret operation(ERROR, FILE_BEGIN, OUTCOME_ACTIVE, progress.error);
    }
    ret poison(upload, FILE_BEGIN,
        "upload file begin outcome was ambiguous");
}

pub fun start_file(upload: *Upload, metadata: Metadata) Operation {
    if (!valid(upload) || upload.state != BATCH_ACTIVE ||
        upload.generation == ~(0::u64) ||
        !metadata_valid(metadata, upload.max_file_bytes) ||
        !metadata_locally_disjoint(upload, upload.store, metadata)) {
        ret operation(INVALID, FILE_BEGIN, OUTCOME_NONE,
            "invalid upload file metadata");
    }
    clear_file(upload);
    copy(metadata.field_name, ?upload.field_name[0]);
    copy(metadata.file_name, ?upload.file_name[0]);
    copy(metadata.content_type, ?upload.content_type[0]);
    upload.field_name_len   = metadata.field_name.len;
    upload.file_name_len    = metadata.file_name.len;
    upload.content_type_len = metadata.content_type.len;
    upload.declared_len     = metadata.declared_len;
    upload.has_length       = metadata.has_length;
    val store: Store = upload.store;
    upload.state = FILE_BEGINNING;
    val field_alias: i8 = guarded_store_alias(upload, store,
        metadata.field_name.data, metadata.field_name.len);
    val file_alias: i8 = guarded_store_alias(upload, store,
        metadata.file_name.data, metadata.file_name.len);
    val type_alias: i8 = guarded_store_alias(upload, store,
        metadata.content_type.data, metadata.content_type.len);
    if (field_alias != 0 || file_alias != 0 || type_alias != 0) {
        if (field_alias < 0 || file_alias < 0 || type_alias < 0) {
            ret poison(upload, FILE_BEGIN,
                "upload metadata ownership check mutated state");
        }
        clear_file(upload);
        upload.state = BATCH_ACTIVE;
        ret operation(INVALID, FILE_BEGIN, OUTCOME_NONE,
            "upload metadata aliases store state");
    }
    var before:   Upload   = @upload;
    val progress: Progress = store.file_begin(store.ctx, upload.batch,
        staged_metadata(upload));
    if (!callback_stable(upload, ?before, store, FILE_BEGINNING)) {
        ret poison(upload, FILE_BEGIN,
            "upload file begin provider violated ownership");
    }
    ret accept_file_begin(upload, progress);
}

fun input_locally_valid(upload: *Upload, input: *u8, len: usize) bool {
    ret range_valid(input, len) && len != 0 &&
        !overlap(input, len, upload_anchor(upload), $size_of(Upload)) &&
        !overlap(upload.store.ctx::*u8, upload.store.context_size,
        input, len);
}

fun accept_write(upload: *Upload, progress: Progress,
    allowed: usize) Operation {
    if (!progress_shape(progress, WRITE)) {
        ret poison(upload, WRITE, "upload write result was invalid");
    }
    if (progress.status == PENDING) {
        upload.pending_len = allowed;
        ret record_pending(upload, WRITE, progress.token);
    }
    upload.pending_input = nil;
    upload.pending_len   = 0;
    if (progress.status == OK && progress.outcome == OUTCOME_ACTIVE &&
        progress.written != 0 && progress.written <= allowed &&
        transaction_empty(progress.transaction) &&
        progress.written::u64 <=
        upload.max_file_bytes - upload.transferred) {
        upload.transferred = upload.transferred + progress.written::u64;
        upload.state       = FILE_ACTIVE;
        ret Operation{status: OK, kind: WRITE, token: 0,
            written: progress.written, file: empty_file(),
            outcome: OUTCOME_ACTIVE, error: nil};
    }
    if (progress.status == ERROR && progress.outcome == OUTCOME_ACTIVE) {
        upload.state = FILE_ACTIVE;
        ret operation(ERROR, WRITE, OUTCOME_ACTIVE, progress.error);
    }
    ret poison(upload, WRITE, "upload write outcome was ambiguous");
}

pub fun write(upload: *Upload, input: *u8, len: usize) Operation {
    if (!valid(upload) || upload.state != FILE_ACTIVE ||
        upload.generation == ~(0::u64) ||
        !input_locally_valid(upload, input, len)) {
        ret operation(INVALID, WRITE, OUTCOME_NONE, "invalid upload write");
    }
    if (len::u64 > upload.max_file_bytes - upload.transferred ||
        upload.has_length &&
        len::u64 > upload.declared_len - upload.transferred) {
        ret operation(LIMIT, WRITE, OUTCOME_ACTIVE,
            "upload file limit reached");
    }
    val store: Store = upload.store;
    upload.pending_input = input;
    upload.pending_len   = len;
    upload.state         = WRITING;
    val aliases: i8 = guarded_store_alias(upload, store, input, len);
    if (aliases != 0) {
        if (aliases < 0) {
            ret poison(upload, WRITE,
                "upload input ownership check mutated state");
        }
        upload.pending_input = nil;
        upload.pending_len   = 0;
        upload.state         = FILE_ACTIVE;
        ret operation(INVALID, WRITE, OUTCOME_NONE,
            "upload input aliases store state");
    }
    var before:   Upload   = @upload;
    val progress: Progress = store.write(store.ctx, upload.batch,
        upload.file_transaction, input, len);
    if (!callback_stable(upload, ?before, store, WRITING) ||
        upload.pending_input != input || upload.pending_len != len) {
        ret poison(upload, WRITE,
            "upload write provider violated ownership");
    }
    ret accept_write(upload, progress, len);
}

fun accept_file_seal(upload: *Upload, progress: Progress) Operation {
    if (!progress_shape(progress, FILE_SEAL)) {
        ret poison(upload, FILE_SEAL,
            "upload file seal result was invalid");
    }
    if (progress.status == PENDING) {
        ret record_pending(upload, FILE_SEAL, progress.token);
    }
    if (progress.status == OK && progress.outcome == OUTCOME_STAGED &&
        transaction_empty(progress.transaction) && file_valid(upload,
        progress.file) && upload.sealed_files != ~(0::usize)) {
        val file: StoredFile = progress.file;
        upload.sealed_files = upload.sealed_files + 1;
        clear_file(upload);
        upload.state = BATCH_ACTIVE;
        ret Operation{status: OK, kind: FILE_SEAL, token: 0, written: 0,
            file: file, outcome: OUTCOME_STAGED, error: nil};
    }
    if (progress.status == ERROR && progress.outcome == OUTCOME_ACTIVE) {
        upload.state = FILE_ACTIVE;
        ret operation(ERROR, FILE_SEAL, OUTCOME_ACTIVE, progress.error);
    }
    ret poison(upload, FILE_SEAL,
        "upload file seal outcome was ambiguous");
}

pub fun seal_file(upload: *Upload) Operation {
    if (!valid(upload) || upload.state != FILE_ACTIVE ||
        upload.generation == ~(0::u64) ||
        upload.sealed_files == ~(0::usize) ||
        upload.has_length && upload.transferred != upload.declared_len) {
        ret operation(INVALID, FILE_SEAL, OUTCOME_NONE,
            "invalid upload file seal");
    }
    val store: Store = upload.store;
    upload.state = FILE_SEALING;
    var before:   Upload   = @upload;
    val progress: Progress = store.file_seal(store.ctx, upload.batch,
        upload.file_transaction);
    if (!callback_stable(upload, ?before, store, FILE_SEALING)) {
        ret poison(upload, FILE_SEAL,
            "upload file seal provider violated ownership");
    }
    ret accept_file_seal(upload, progress);
}

fun accept_batch_finish(upload: *Upload, progress: Progress,
    kind: Kind) Operation {
    if (!progress_shape(progress, kind)) {
        ret poison(upload, kind, "upload batch finish result was invalid");
    }
    if (progress.status == PENDING) {
        ret record_pending(upload, kind, progress.token);
    }
    if (kind == BATCH_COMMIT && progress.status == OK &&
        progress.outcome == OUTCOME_COMMITTED &&
        transaction_empty(progress.transaction) && progress.file.id.len == 0 &&
        progress.file.size == 0) {
        upload.state = COMMITTED;
        ret operation(OK, BATCH_COMMIT, OUTCOME_COMMITTED, nil);
    }
    if (kind == BATCH_ABORT && progress.status == OK &&
        progress.outcome == OUTCOME_ABORTED &&
        transaction_empty(progress.transaction) && progress.file.id.len == 0 &&
        progress.file.size == 0) {
        clear_file(upload);
        upload.state = ABORTED;
        ret operation(OK, BATCH_ABORT, OUTCOME_ABORTED, nil);
    }
    if (progress.status == ERROR && progress.outcome == OUTCOME_UNKNOWN) {
        clear_pending(upload);
        upload.unknown_kind = kind;
        upload.state        = UNKNOWN;
        ret operation(ERROR, kind, OUTCOME_UNKNOWN, progress.error);
    }
    ret poison(upload, kind, "upload batch finish outcome was ambiguous");
}

pub fun commit_batch(upload: *Upload) Operation {
    if (!valid(upload) || upload.state != BATCH_ACTIVE ||
        upload.sealed_files == 0 || upload.generation == ~(0::u64)) {
        ret operation(INVALID, BATCH_COMMIT, OUTCOME_NONE,
            "invalid upload batch commit");
    }
    val store: Store = upload.store;
    upload.state = BATCH_COMMITTING;
    var before:   Upload   = @upload;
    val progress: Progress = store.batch_commit(store.ctx, upload.batch);
    if (!callback_stable(upload, ?before, store, BATCH_COMMITTING)) {
        ret poison(upload, BATCH_COMMIT,
            "upload batch commit provider violated ownership");
    }
    ret accept_batch_finish(upload, progress, BATCH_COMMIT);
}

pub fun abort_batch(upload: *Upload) Operation {
    if (!valid(upload) ||
        (upload.state != BATCH_ACTIVE && upload.state != FILE_ACTIVE) ||
        upload.generation == ~(0::u64)) {
        ret operation(INVALID, BATCH_ABORT, OUTCOME_NONE,
            "invalid upload batch abort");
    }
    val store: Store       = upload.store;
    val file:  Transaction = upload.file_transaction;
    upload.state = BATCH_ABORTING;
    var before:   Upload   = @upload;
    val progress: Progress = store.batch_abort(store.ctx, upload.batch, file);
    if (!callback_stable(upload, ?before, store, BATCH_ABORTING)) {
        ret poison(upload, BATCH_ABORT,
            "upload batch abort provider violated ownership");
    }
    ret accept_batch_finish(upload, progress, BATCH_ABORT);
}

fun expected_state(kind: Kind) State {
    if (kind == BATCH_BEGIN)  { ret BATCH_BEGINNING; }
    if (kind == FILE_BEGIN)   { ret FILE_BEGINNING; }
    if (kind == WRITE)        { ret WRITING; }
    if (kind == FILE_SEAL)    { ret FILE_SEALING; }
    if (kind == BATCH_COMMIT) { ret BATCH_COMMITTING; }
    if (kind == BATCH_ABORT)  { ret BATCH_ABORTING; }
    ret UNINITIALIZED;
}

pub fun complete(upload: *Upload, token: u64) Operation {
    if (upload == nil || token == 0 || token != upload.pending_token ||
        !valid(upload) || upload.pending_kind < BATCH_BEGIN ||
        upload.pending_kind > BATCH_ABORT ||
        upload.state != expected_state(upload.pending_kind)) {
        ret operation(INVALID, 0, OUTCOME_NONE,
            "invalid upload completion token");
    }
    val kind:           Kind     = upload.pending_kind;
    val transitional:   State    = upload.state;
    val allowed:        usize    = upload.pending_len;
    val retained_input: *u8      = upload.pending_input;
    val provider_token: u64      = upload.pending_provider_token;
    val store:          Store    = upload.store;
    var before:         Upload   = @upload;
    val progress:       Progress = store.complete(store.ctx, provider_token);
    if (!callback_stable(upload, ?before, store, transitional) ||
        upload.pending_token != token || upload.pending_kind != kind) {
        ret poison(upload, kind,
            "upload completion provider violated ownership");
    }
    if (kind == WRITE && (upload.pending_input != retained_input ||
        upload.pending_len != allowed)) {
        ret poison(upload, kind,
            "upload completion changed retained input");
    }
    if (progress.status == PENDING) {
        if (!progress_shape(progress, kind)) {
            ret poison(upload, kind,
                "upload completion returned invalid pending state");
        }
        upload.pending_token          = 0;
        upload.pending_provider_token = 0;
        ret record_pending(upload, kind, progress.token);
    }
    upload.pending_kind           = 0;
    upload.pending_token          = 0;
    upload.pending_provider_token = 0;
    if (kind == BATCH_BEGIN) { ret accept_batch_begin(upload, progress); }
    if (kind == FILE_BEGIN)  { ret accept_file_begin(upload, progress); }
    if (kind == WRITE)       { ret accept_write(upload, progress, allowed); }
    if (kind == FILE_SEAL)   { ret accept_file_seal(upload, progress); }
    ret accept_batch_finish(upload, progress, kind);
}

pub fun resolve_unknown(upload: *Upload, outcome: Outcome) bool {
    if (!valid(upload) || upload.state != UNKNOWN ||
        (outcome != OUTCOME_COMMITTED && outcome != OUTCOME_ABORTED) ||
        outcome == OUTCOME_COMMITTED &&
        upload.unknown_kind != BATCH_COMMIT) { ret false; }
    upload.unknown_kind = 0;
    clear_pending(upload);
    clear_file(upload);
    if (outcome == OUTCOME_COMMITTED) {
        upload.state = COMMITTED;
        ret true;
    }
    upload.state = ABORTED;
    ret true;
}

pub fun release(upload: *Upload) bool {
    if (!valid(upload) ||
        (upload.state != READY && upload.state != COMMITTED &&
        upload.state != ABORTED)) { ret false; }
    val generation: u64 = upload.generation;
    clear(upload_anchor(upload), $size_of(Upload));
    upload.generation = generation;
    upload.state      = RELEASED;
    ret true;
}

rec TestStore {
    bytes:                [128]u8;
    len:                  usize;
    file_start:           usize;
    file_ids:             [64]u8;
    file_count:           usize;
    batch_active:         bool;
    file_active:          bool;
    committed:            bool;
    aborted:              bool;
    pending_batch_begin:  bool;
    pending_file_begin:   bool;
    pending_write:        bool;
    pending_file_seal:    bool;
    pending_batch_commit: bool;
    pending_batch_abort:  bool;
    pending_kind:         Kind;
    pending_token:        u64;
    pending_input:        *u8;
    pending_len:          usize;
    partial:              usize;
    fail_write:           bool;
    unknown_commit:       bool;
    mutate_kind:          Kind;
    target:               *Upload;
    batch_begin_calls:    usize;
    file_begin_calls:     usize;
    write_calls:          usize;
    file_seal_calls:      usize;
    batch_commit_calls:   usize;
    batch_abort_calls:    usize;
    complete_calls:       usize;
}

fun test_aliases(ctx: ptr, data: *u8, len: usize) bool {
    val state: *TestStore = ctx::*TestStore;
    ret overlap(?state.file_ids[0], 64, data, len);
}

fun test_batch(state: *TestStore) Transaction {
    ret Transaction{owner: state::ptr, id: 1};
}

fun test_file_transaction(state: *TestStore) Transaction {
    ret Transaction{owner: state::ptr, id: state.file_count::u64 + 2};
}

fun test_progress(status: Status, kind: Kind, outcome: Outcome,
    detail: str) Progress {
    ret Progress{status: status, kind: kind, token: 0,
        transaction: Transaction{owner: nil, id: 0}, written: 0,
        file:        empty_file(), outcome: outcome, error: detail};
}

fun test_pending(state: *TestStore, kind: Kind) Progress {
    state.pending_kind  = kind;
    state.pending_token = state.pending_token + 1;
    if (state.pending_token == 0) { state.pending_token = 1; }
    var result: Progress = test_progress(PENDING, kind,
        OUTCOME_ACTIVE, nil);
    result.token = state.pending_token;
    ret result;
}

fun test_batch_begin_done(state: *TestStore) Progress {
    state.batch_active = true;
    var result: Progress = test_progress(OK, BATCH_BEGIN,
        OUTCOME_ACTIVE, nil);
    result.transaction = test_batch(state);
    ret result;
}

fun test_batch_begin(ctx: ptr) Progress {
    val state: *TestStore = ctx::*TestStore;
    state.batch_begin_calls = state.batch_begin_calls + 1;
    if (state.mutate_kind == BATCH_BEGIN && state.target != nil) {
        state.target.sealed_files = state.target.sealed_files + 1;
    }
    if (state.pending_batch_begin) {
        state.pending_batch_begin = false;
        ret test_pending(state, BATCH_BEGIN);
    }
    ret test_batch_begin_done(state);
}

fun test_file_begin_done(state: *TestStore) Progress {
    state.file_active = true;
    state.file_start  = state.len;
    var result: Progress = test_progress(OK, FILE_BEGIN,
        OUTCOME_ACTIVE, nil);
    result.transaction = test_file_transaction(state);
    ret result;
}

fun test_file_begin(ctx: ptr, batch: Transaction,
    metadata: Metadata) Progress {
    val state: *TestStore = ctx::*TestStore;
    state.file_begin_calls = state.file_begin_calls + 1;
    if (batch.id != 1 || !state.batch_active || state.file_active) {
        ret test_progress(ERROR, FILE_BEGIN, OUTCOME_UNKNOWN,
            "invalid test batch transaction");
    }
    if (state.mutate_kind == FILE_BEGIN && state.target != nil) {
        state.target.field_name_len = state.target.field_name_len + 1;
    }
    if (state.pending_file_begin) {
        state.pending_file_begin = false;
        ret test_pending(state, FILE_BEGIN);
    }
    ret test_file_begin_done(state);
}

fun test_write_done(state: *TestStore, input: *u8,
    len: usize) Progress {
    if (state.fail_write) {
        ret test_progress(ERROR, WRITE, OUTCOME_ACTIVE,
            "test write failed");
    }
    var written: usize = len;
    if (state.partial != 0 && written > state.partial) {
        written = state.partial;
    }
    if (written > 128 - state.len) {
        ret test_progress(ERROR, WRITE, OUTCOME_ACTIVE,
            "test storage exhausted");
    }
    var i: usize = 0;
    for (i < written) {
        state.bytes[state.len + i] = input[i];
        i                          = i + 1;
    }
    state.len = state.len + written;
    var result: Progress = test_progress(OK, WRITE, OUTCOME_ACTIVE, nil);
    result.written = written;
    ret result;
}

fun test_write(ctx: ptr, batch: Transaction, file: Transaction,
    input: *u8, len: usize) Progress {
    val state: *TestStore = ctx::*TestStore;
    state.write_calls = state.write_calls + 1;
    if (batch.id != 1 || file.id != state.file_count::u64 + 2 ||
        !state.batch_active || !state.file_active) {
        ret test_progress(ERROR, WRITE, OUTCOME_UNKNOWN,
            "invalid test file transaction");
    }
    if (state.mutate_kind == WRITE && state.target != nil) {
        state.target.pending_len = state.target.pending_len + 1;
    }
    if (state.pending_write) {
        state.pending_write = false;
        state.pending_input = input;
        state.pending_len   = len;
        ret test_pending(state, WRITE);
    }
    ret test_write_done(state, input, len);
}

fun test_stored_file(state: *TestStore) StoredFile {
    val start: usize = state.file_count * 8;
    state.file_ids[start]     = 'u';
    state.file_ids[start + 1] = '0' + state.file_count::u8;
    ret StoredFile{id: view.view(?state.file_ids[start], 2),
        size: (state.len - state.file_start)::u64};
}

fun test_file_seal_done(state: *TestStore) Progress {
    state.file_active = false;
    var result: Progress = test_progress(OK, FILE_SEAL,
        OUTCOME_STAGED, nil);
    result.file      = test_stored_file(state);
    state.file_count = state.file_count + 1;
    ret result;
}

fun test_file_seal(ctx: ptr, batch: Transaction,
    file: Transaction) Progress {
    val state: *TestStore = ctx::*TestStore;
    state.file_seal_calls = state.file_seal_calls + 1;
    if (batch.id != 1 || file.id != state.file_count::u64 + 2 ||
        !state.batch_active || !state.file_active) {
        ret test_progress(ERROR, FILE_SEAL, OUTCOME_UNKNOWN,
            "invalid test file seal transaction");
    }
    if (state.mutate_kind == FILE_SEAL && state.target != nil) {
        state.target.transferred = state.target.transferred + 1;
    }
    if (state.pending_file_seal) {
        state.pending_file_seal = false;
        ret test_pending(state, FILE_SEAL);
    }
    ret test_file_seal_done(state);
}

fun test_batch_commit_done(state: *TestStore) Progress {
    state.batch_active = false;
    state.committed    = true;
    if (state.unknown_commit) {
        ret test_progress(ERROR, BATCH_COMMIT, OUTCOME_UNKNOWN,
            "test batch commit outcome unknown");
    }
    ret test_progress(OK, BATCH_COMMIT, OUTCOME_COMMITTED, nil);
}

fun test_batch_commit(ctx: ptr, batch: Transaction) Progress {
    val state: *TestStore = ctx::*TestStore;
    state.batch_commit_calls = state.batch_commit_calls + 1;
    if (batch.id != 1 || !state.batch_active || state.file_active) {
        ret test_progress(ERROR, BATCH_COMMIT, OUTCOME_UNKNOWN,
            "invalid test batch commit transaction");
    }
    if (state.mutate_kind == BATCH_COMMIT && state.target != nil) {
        state.target.sealed_files = state.target.sealed_files + 1;
    }
    if (state.pending_batch_commit) {
        state.pending_batch_commit = false;
        ret test_pending(state, BATCH_COMMIT);
    }
    ret test_batch_commit_done(state);
}

fun test_batch_abort_done(state: *TestStore) Progress {
    state.batch_active = false;
    state.file_active  = false;
    state.aborted      = true;
    state.len          = 0;
    ret test_progress(OK, BATCH_ABORT, OUTCOME_ABORTED, nil);
}

fun test_batch_abort(ctx: ptr, batch: Transaction,
    file: Transaction) Progress {
    val state: *TestStore = ctx::*TestStore;
    state.batch_abort_calls = state.batch_abort_calls + 1;
    if (batch.id != 1 || !state.batch_active ||
        state.file_active && file.id != state.file_count::u64 + 2 ||
        !state.file_active && !transaction_empty(file)) {
        ret test_progress(ERROR, BATCH_ABORT, OUTCOME_UNKNOWN,
            "invalid test batch abort transaction");
    }
    if (state.mutate_kind == BATCH_ABORT && state.target != nil) {
        state.target.sealed_files = state.target.sealed_files + 1;
    }
    if (state.pending_batch_abort) {
        state.pending_batch_abort = false;
        ret test_pending(state, BATCH_ABORT);
    }
    ret test_batch_abort_done(state);
}

fun test_complete(ctx: ptr, token: u64) Progress {
    val state: *TestStore = ctx::*TestStore;
    state.complete_calls = state.complete_calls + 1;
    if (token == 0 || token != state.pending_token) {
        ret test_progress(ERROR, state.pending_kind, OUTCOME_UNKNOWN,
            "invalid test completion token");
    }
    val kind: Kind = state.pending_kind;
    state.pending_kind  = 0;
    state.pending_token = 0;
    if (kind == BATCH_BEGIN) { ret test_batch_begin_done(state); }
    if (kind == FILE_BEGIN)  { ret test_file_begin_done(state); }
    if (kind == WRITE) {
        val input: *u8   = state.pending_input;
        val len:   usize = state.pending_len;
        state.pending_input = nil;
        state.pending_len   = 0;
        ret test_write_done(state, input, len);
    }
    if (kind == FILE_SEAL)    { ret test_file_seal_done(state); }
    if (kind == BATCH_COMMIT) { ret test_batch_commit_done(state); }
    ret test_batch_abort_done(state);
}

fun test_store(state: *TestStore) Store {
    ret Store{ctx: state::ptr, context_size: $size_of(TestStore),
        aliases_state: test_aliases, batch_begin: test_batch_begin,
        file_begin:    test_file_begin, write: test_write,
        file_seal:     test_file_seal, batch_commit: test_batch_commit,
        batch_abort:   test_batch_abort, complete: test_complete};
}

fun test_str_len(value: str) usize {
    if (value == nil) { ret 0; }
    var len: usize = 0;
    for (value[len] != 0) { len = len + 1; }
    ret len;
}

fun test_metadata(file_name: str, declared_len: u64,
    has_length: bool) Metadata {
    ret Metadata{field_name: view.view("document", 8),
        file_name:    view.view(file_name, test_str_len(file_name)),
        content_type: view.view("text/plain", 10),
        declared_len: declared_len, has_length: has_length};
}

fun test_open(state: *TestStore, upload: *Upload,
    maximum: u64) bool {
    ret init(upload, test_store(state), maximum) &&
        begin_batch(upload).status == OK;
}

test batch__stages_until_commit {
    var state: TestStore;
    state.partial = 2;
    var upload: Upload;
    if (!test_open(?state, ?upload, 16) ||
        start_file(?upload,
        test_metadata("one.txt", 4, true)).status != OK) { ret 1; }
    var input: [4]u8;
    input[0] = 'd';
    input[1] = 'a';
    input[2] = 't';
    input[3] = 'a';
    val first:  Operation = write(?upload, ?input[0], 4);
    val second: Operation = write(?upload, ?input[2], 2);
    val staged: Operation = seal_file(?upload);
    if (first.status != OK || first.written != 2 || second.status != OK ||
        second.written != 2 || staged.status != OK ||
        staged.outcome != OUTCOME_STAGED || staged.file.size != 4 ||
        state.batch_commit_calls != 0 || upload.state != BATCH_ACTIVE) {
        ret 2;
    }
    if (start_file(?upload,
        test_metadata("two.txt", 0, true)).status != OK ||
        seal_file(?upload).status != OK || upload.sealed_files != 2) { ret 3; }
    val committed: Operation = commit_batch(?upload);
    if (committed.status != OK || committed.outcome != OUTCOME_COMMITTED ||
        state.file_seal_calls != 2 || state.batch_commit_calls != 1 ||
        state.batch_abort_calls != 0 || !state.committed ||
        !release(?upload)) { ret 4; }
    ret 0;
}

test stages__async_retain_ownership {
    var state: TestStore;
    state.pending_batch_begin  = true;
    state.pending_file_begin   = true;
    state.pending_write        = true;
    state.pending_file_seal    = true;
    state.pending_batch_commit = true;
    var upload: Upload;
    if (!init(?upload, test_store(?state), 16)) { ret 1; }
    var current: Operation = begin_batch(?upload);
    if (current.status != PENDING || current.kind != BATCH_BEGIN) { ret 2; }
    current = complete(?upload, current.token);
    current = start_file(?upload, test_metadata("async.txt", 3, true));
    if (current.status != PENDING || current.kind != FILE_BEGIN) { ret 3; }
    current = complete(?upload, current.token);
    var input: [3]u8;
    input[0] = 'o';
    input[1] = 'n';
    input[2] = 'e';
    if (current.status != OK) { ret 4; }
    current = write(?upload, ?input[0], 3);
    if (current.status != PENDING || upload.pending_input != ?input[0]) {
        ret 5;
    }
    current = complete(?upload, current.token);
    if (current.status != OK || current.written != 3 ||
        upload.pending_input != nil) { ret 6; }
    current = seal_file(?upload);
    if (current.status != PENDING) { ret 7; }
    current = complete(?upload, current.token);
    if (current.status != OK || current.outcome != OUTCOME_STAGED) { ret 8; }
    current = commit_batch(?upload);
    if (current.status != PENDING) { ret 9; }
    current = complete(?upload, current.token);
    if (current.status != OK || upload.state != COMMITTED ||
        state.complete_calls != 5 || state.batch_begin_calls != 1 ||
        state.file_begin_calls != 1 || state.write_calls != 1 ||
        state.file_seal_calls != 1 || state.batch_commit_calls != 1 ||
        !release(?upload)) { ret 10; }
    ret 0;
}

test start_file__invalid_never_reaches_store {
    var state:  TestStore;
    var upload: Upload;
    if (!test_open(?state, ?upload, 4)) { ret 1; }
    if (start_file(?upload,
        test_metadata("../secret", 1, true)).status != INVALID ||
        state.file_begin_calls != 0 || upload.state != BATCH_ACTIVE) { ret 2; }
    if (start_file(?upload,
        test_metadata("large.txt", 5, true)).status != INVALID ||
        state.file_begin_calls != 0 || upload.state != BATCH_ACTIVE) { ret 3; }
    if (start_file(?upload,
        test_metadata("safe.txt", 0, false)).status != OK) { ret 4; }
    var input: [5]u8;
    if (write(?upload, ?input[0], 5).status != LIMIT ||
        state.write_calls != 0 || upload.state != FILE_ACTIVE) { ret 5; }
    if (abort_batch(?upload).status != OK ||
        state.batch_abort_calls != 1 || !release(?upload)) { ret 6; }
    ret 0;
}

test write__storage_failure_single_abort {
    var state: TestStore;
    state.fail_write          = true;
    state.pending_batch_abort = true;
    var upload: Upload;
    if (!test_open(?state, ?upload, 8) ||
        start_file(?upload,
        test_metadata("error.txt", 0, false)).status != OK) { ret 1; }
    var input: [1]u8;
    if (write(?upload, ?input[0], 1).status != ERROR ||
        upload.state != FILE_ACTIVE) { ret 2; }
    var stopped: Operation = abort_batch(?upload);
    if (state.batch_abort_calls != 1 || stopped.status != PENDING ||
        abort_batch(?upload).status != INVALID) { ret 3; }
    stopped = complete(?upload, stopped.token);
    if (stopped.status != OK || state.batch_abort_calls != 1 ||
        !state.aborted || state.len != 0 || !release(?upload)) { ret 4; }
    ret 0;
}

test commit__unknown_requires_reconciliation {
    var state: TestStore;
    state.unknown_commit = true;
    var upload: Upload;
    if (!test_open(?state, ?upload, 8) ||
        start_file(?upload,
        test_metadata("unknown.txt", 0, false)).status != OK ||
        seal_file(?upload).status != OK) { ret 1; }
    val finished: Operation = commit_batch(?upload);
    if (finished.status != ERROR || finished.outcome != OUTCOME_UNKNOWN ||
        upload.state != UNKNOWN || release(?upload) ||
        resolve_unknown(?upload, OUTCOME_ACTIVE)) { ret 2; }
    if (!resolve_unknown(?upload, OUTCOME_COMMITTED) ||
        !release(?upload) || state.batch_commit_calls != 1) { ret 3; }
    ret 0;
}

test aliases__poison_batch {
    var state:  TestStore;
    var upload: Upload;
    if (!test_open(?state, ?upload, 8)) { ret 1; }
    val alias_metadata: Metadata = Metadata{
        field_name: view.view(?state.bytes[0], 1),
        file_name:  view.view("a.txt", 5), content_type: view.view(nil, 0), declared_len: 0, has_length: false
    };
    if (start_file(?upload, alias_metadata).status != INVALID ||
        state.file_begin_calls != 0 || upload.state != BATCH_ACTIVE) { ret 2; }
    if (start_file(?upload,
        test_metadata("owned.txt", 0, false)).status != OK) { ret 3; }
    if (write(?upload, ?state.bytes[0], 1).status != INVALID ||
        state.write_calls != 0 || upload.state != FILE_ACTIVE) { ret 4; }
    state.target      = ?upload;
    state.mutate_kind = WRITE;
    var input:     [1]u8;
    val corrupted: Operation = write(?upload, ?input[0], 1);
    if (corrupted.status != INVALID || corrupted.outcome != OUTCOME_UNKNOWN ||
        upload.state != UNKNOWN || upload.pending_len != 0 ||
        state.write_calls != 1) { ret 5; }
    ret 0;
}

test release__keeps_completion_generations {
    var state: TestStore;
    state.pending_batch_begin = true;
    var upload: Upload;
    val store:  Store = test_store(?state);
    if (!init(?upload, store, 8)) { ret 1; }
    var started: Operation = begin_batch(?upload);
    if (started.status != PENDING) { ret 2; }
    val stale: u64 = started.token;
    started = complete(?upload, started.token);
    if (started.status != OK || abort_batch(?upload).status != OK ||
        !release(?upload) || !init(?upload, store, 8)) { ret 3; }
    state.pending_batch_begin = true;
    started                   = begin_batch(?upload);
    if (started.status != PENDING || started.token == stale ||
        complete(?upload, stale).status != INVALID) { ret 4; }
    started = complete(?upload, started.token);
    if (started.status != OK || abort_batch(?upload).status != OK ||
        !release(?upload)) { ret 5; }
    ret 0;
}
